---
const categories = [
  'All Posts',
  'Dissertation Writing',
  'Essay Writing',
  'Editing & Proofreading',
  'Research Paper',
  'Thesis & Dissertation',
];

const categorySlug = (cat: string) =>
  cat.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const activeCategorySlug = Astro.url.searchParams.get('category') || 'all';
---

<div class="category-tabs-band">
  <nav class="category-tabs">
    {categories.map((cat) => {
      const slug = cat === 'All Posts' ? 'all' : categorySlug(cat);
      return (
        <a
          href={cat === 'All Posts' ? '/blog' : `/blog?category=${slug}`}
          class:list={['tab-btn', { active: slug === activeCategorySlug }]}
        >
          {cat}
        </a>
      );
    })}
  </nav>
  <a href="#" class="search-in-blog">Search in blog</a>
</div>

<style>
  .category-tabs-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #EEF1FB;
    padding: 0 2rem;
    width: 100%;
  }
  .category-tabs {
    display: flex;
    gap: 0.15rem;
    overflow-x: auto;
    padding: 0.6rem 0;
    scrollbar-width: thin;
  }
  .tab-btn {
    flex-shrink: 0;
    color: #2563EB;
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.5rem 0.6rem;
    border-radius: 20px;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .tab-btn:hover { color: #1B2A4A; }
  .tab-btn.active { color: #1B2A4A; font-weight: 700; }
  .search-in-blog {
    flex-shrink: 0;
    color: #475569;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    padding-left: 1rem;
  }
  .search-in-blog:hover { color: #1B2A4A; }
</style>