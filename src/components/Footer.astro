<style>
.footer {
  background-color: var(--navy, #1B2A4A);
  color: var(--white, #ffffff);
  padding-top: 2.5rem;
}

.footer__top {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr 1fr;
  gap: 2rem;
  padding-bottom: 2rem;
}

.footer__col {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}
.footer__col h4 {
  color: var(--white, #ffffff);
  font-family: var(--font-body, inherit);
  font-size: 0.92rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}
.footer__col a {
  color: rgba(255,255,255,0.65);
  font-size: 0.85rem;
  font-weight: 600;
  transition: color 0.2s ease;
}
.footer__col a:hover { color: var(--gold, #C5A059); }

.footer__badge {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  border: 2px solid var(--gold, #C5A059);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 0.4rem;
}
.footer__badge span { color: var(--gold, #C5A059); font-weight: 800; font-size: 0.72rem; }
.footer__badge small { color: rgba(255,255,255,0.6); font-size: 0.44rem; letter-spacing: 0.5px; }
.footer__seal { width: 90px; height: 90px; margin-top: 0.4rem; object-fit: contain; mix-blend-mode: multiply; }

.footer__trust-row { display: flex; gap: 0.5rem; margin-top: 0.6rem; flex-wrap: wrap; align-items: center; }
.footer__dmca-img { max-width: 130px; height: auto; display: block; }
.footer__trust-badge {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  background: rgba(34,197,94,0.12);
  color: #4ade80;
  border: 1px solid rgba(34,197,94,0.3);
  border-radius: 6px;
  padding: 0.35rem 0.55rem;
  font-size: 0.58rem;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
}
.footer__trust-badge--green { color: #4ade80; }

.footer__mid {
  border-top: 1px solid rgba(255,255,255,0.1);
  padding: 1.6rem 0;
}
.footer__mid-inner {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1.7fr;
  gap: 2rem;
  align-items: start;
}

.footer__social-block { display: flex; justify-content: center; align-items: center; height: 100%; }
.footer__social { display: flex; gap: 0.9rem; }
.footer__social a {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}
.footer__social a:hover { background: var(--gold, #C5A059); color: var(--navy, #1B2A4A); }

.footer__accept { display: flex; flex-direction: column; align-items: flex-end; gap: 0.6rem; }
.footer__accept h4 {
  color: var(--white, #ffffff);
  font-size: 0.85rem;
  font-weight: 700;
}
.footer__cards { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: flex-end; }
.footer__card {
  background: #ffffff;
  color: #1B2A4A;
  font-size: 0.6rem;
  font-weight: 800;
  padding: 0.3rem 0.5rem;
  border-radius: 4px;
  letter-spacing: 0.3px;
}
.footer__card--mc { color: #eb001b; letter-spacing: -2px; font-size: 0.9rem; }

.footer__bottom {
  border-top: 1px solid rgba(255,255,255,0.1);
  padding: 1rem 0 1.4rem;
  text-align: center;
}
.footer__bottom p {
  color: rgba(255,255,255,0.45);
  font-size: 0.8rem;
}

@media (max-width: 900px) {
  .footer__top { grid-template-columns: 1fr 1fr; }
  .footer__mid-inner { grid-template-columns: 1fr; gap: 1.5rem; text-align: center; }
  .footer__social-block { order: -1; }
  .footer__accept { align-items: center; }
  .footer__cards { justify-content: center; }
}
@media (max-width: 480px) {
  .footer__top { grid-template-columns: 1fr; }
}
</style>

<script src="https://images.dmca.com/Badges/DMCABadgeHelper.min.js" is:inline></script>