---
const base = '';
---
<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-content">
      
      <!-- Rating pill -->
      <div class="rating-pill">
        <span class="stars">★★★★★</span>
        <strong class="rating-val">4.9/5</strong>
        <span class="rating-sep">•</span>
        <span class="rating-count">15,000+ verified reviews</span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title">
        A+ Essay Writing Service That <span class="highlight-gold">Delivers Results</span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-sub">
        Get high-quality, plagiarism-free academic writing help from real experts. On-time delivery, every time.
      </p>

      <!-- Feature Badges Grid -->
      <div class="feature-badges-grid">
        <div class="badge-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>AI-Free Writing</span>
        </div>
        <div class="badge-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>Plagiarism Report</span>
        </div>
        <div class="badge-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>On-Time Delivery</span>
        </div>
        <div class="badge-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>100% Confidential</span>
        </div>
        <div class="badge-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>Money Back Guarantee</span>
        </div>
        <div class="badge-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>24/7 Support</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <a href="/order/" class="btn-gold auth-gate">Get Instant Quote &rarr;</a>
        <a href="/order/" class="btn-outline-navy">
          Order now
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </a>
      </div>

      <p class="trust-footer-note">Trusted by <strong>15,000+</strong> students from top universities</p>

    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background: linear-gradient(rgba(15, 23, 42, 0.84), rgba(15, 23, 42, 0.90)), 
                url('https://rehvwvujuamehoanfomj.supabase.co/storage/v1/object/public/writer-photos/hero.png') center/cover no-repeat;
    padding: 5rem 0 2.2rem;
    margin: 0 !important;
    border: none !important;
  }
  .hero-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .rating-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 30px;
    padding: 0.4rem 0.95rem;
    font-size: 0.85rem;
    color: #cbd5e1;
    margin-bottom: 1.75rem;
  }
  .rating-pill .stars {
    color: #f59e0b;
    letter-spacing: 1px;
  }
  .rating-pill .rating-val {
    color: #ffffff;
    font-weight: 700;
  }
  .rating-pill .rating-sep {
    color: rgba(255, 255, 255, 0.3);
  }

  .hero-title {
    font-family: var(--font-heading, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: clamp(2.4rem, 4.5vw, 3.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
    max-width: 780px;
  }
  .highlight-gold {
    color: #c5a059;
  }

  .hero-sub {
    font-size: 1.1rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin: 0 0 2.2rem;
    max-width: 620px;
  }

  .feature-badges-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: 2.25rem;
    max-width: 720px;
  }
  .badge-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 0.45rem 0.85rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: #ffffff;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .btn-gold {
    background: #c5a059;
    color: #0f172a;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem 2rem;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.2s, background 0.2s;
  }
  .btn-gold:hover {
    background: #b59049;
    transform: translateY(-1px);
  }
  .btn-outline-navy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem 1.6rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .btn-outline-navy:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #ffffff;
  }

  .trust-footer-note {
    font-size: 0.88rem;
    color: #94a3b8;
    margin: 0;
  }
  .trust-footer-note strong {
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 4rem 0 1.8rem;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-gold, .btn-outline-navy {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }
  /* Forces the element right after hero section to drop its top border and margin */
.hero-section + * {
  border-top: none !important;
  margin-top: 0 !important;
}
</style>

<script>
  import { supabase } from '../lib/supabase.js';

  const { data: { session } } = await supabase.auth.getSession();
  const authGateLinks = document.querySelectorAll('.auth-gate');

  authGateLinks.forEach(link => {
    link.setAttribute('href', '/order/');
  });
</script>