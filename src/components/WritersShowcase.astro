---
const base = '';
---
<section class="ws">
  <div class="ws__sep"></div>
  <div class="container">
    <h2 class="ws__title">Top essay writers ready to help you</h2>
    <p class="ws__sub">Hire qualified essay writer in your field and get 100% human-written papers</p>

    <div class="ws__grid" id="writersGrid">
      <div class="ws__loading">Loading writers...</div>
    </div>

    <div class="ws__actions">
      <a href={`${base}/writers`} class="ws__btn">Browse all writers</a>
      <p class="ws__note"> ✅Qualified pros, ready to help</p>
    </div>
  </div>
</section>

<style is:global>
.ws {
  background: #f0f2fb;
  padding: 2rem 0 3.5rem;
}

.ws__sep {
  width: 100%;
  height: 3px;
  background: var(--color-primary, #C5A059);
  margin-bottom: 3rem;
}

.ws__title {
  font-family: var(--font-heading, 'Poppins', sans-serif);
  font-size: clamp(1.3rem, 3vw, 1.6rem);
  font-weight: 700;
  color: var(--color-main, #303b4f);
  text-align: center;
  margin-bottom: 0.4rem;
}

.ws__sub {
  text-align: center;
  color: var(--color-main-light, #6d7483);
  font-size: 0.88rem;
  margin-bottom: 2.2rem;
}

.ws__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.2rem;
  margin-bottom: 2rem;
}

.ws__loading {
  grid-column: 1 / -1;
  text-align: center;
  padding: 3rem;
  color: var(--color-main-light, #6d7483);
  font-size: 0.9rem;
}

/* ── Card: photo fills, details overlaid on dark gradient ── */
.ws__card {
  display: block;
  border-radius: 20px;
  overflow: hidden;
  background: var(--bg-card, #ffffff);
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.2s, transform 0.2s;
  position: relative;
}
.ws__card:hover {
  box-shadow: var(--box-shadow-md, 0 4px 12px rgba(0,0,0,0.08));
  transform: translateY(-3px);
}

.ws__card-photo {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  display: block;
  border-radius: 20px;
}
.ws__card-placeholder {
  width: 100%;
  aspect-ratio: 3 / 4;
  background: #e8ecf0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.5rem;
  color: #c0c5cc;
  border-radius: 20px;
}

/* Dark gradient overlay at bottom of image */
.ws__card-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 3rem 0.9rem 0.9rem;
  background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.3) 60%, transparent 100%);
  border-radius: 0 0 20px 20px;
}
.ws__card-name {
  font-weight: 700;
  font-size: 0.9rem;
  color: #ffffff;
  margin-bottom: 0.15rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ws__card-rating {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.82rem;
}
.ws__card-stars { color: #ffd20a; font-size: 0.85rem; }
.ws__card-score { font-weight: 700; color: #ffd20a; }
.ws__card-detail {
  font-size: 0.76rem;
  color: rgba(255,255,255,0.8);
}
.ws__card { cursor: pointer; }
.ws__card-body { transition: opacity 0.2s ease; }
.ws__card:hover .ws__card-body { opacity: 0; }
.ws__card-hover {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, rgba(30,41,59,0.55), rgba(15,23,42,0.92));
  border-radius: 20px;
  padding: 0.9rem;
  display: flex;
  flex-direction: column;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.22s ease, transform 0.22s ease;
  pointer-events: none;
}
.ws__card:hover .ws__card-hover {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}
.ws__hover-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: auto; }
.ws__hover-name { color: #fff; font-weight: 700; font-size: 0.92rem; }
.ws__hover-degree { color: rgba(255,255,255,0.75); font-size: 0.76rem; margin-top: 0.1rem; }
.ws__hover-sample { color: #fff; font-size: 0.76rem; text-decoration: underline; flex-shrink: 0; }
.ws__hover-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.6rem 0; }
.ws__hover-tag { font-size: 0.68rem; font-weight: 600; padding: 0.22rem 0.6rem; border-radius: 12px; color: #fff; }
.ws__hover-tag.c1 { background: rgba(34,197,94,0.35); }
.ws__hover-tag.c2 { background: rgba(139,92,246,0.4); }
.ws__hover-stats { display: flex; gap: 1rem; margin-bottom: 0.7rem; }
.ws__hover-stat-num { color: #fff; font-weight: 700; font-size: 0.88rem; display: flex; align-items: center; gap: 0.2rem; }
.ws__hover-stat-num .star { color: #ffd20a; }
.ws__hover-stat-label { color: rgba(255,255,255,0.65); font-size: 0.68rem; }
.ws__hover-actions { display: flex; flex-direction: column; gap: 0.4rem; }
.ws__hover-btn { text-align: center; border-radius: 10px; padding: 0.5rem; font-size: 0.78rem; font-weight: 700; text-decoration: none; }
.ws__hover-btn--ghost { background: rgba(255,255,255,0.12); color: #fff; }
.ws__hover-btn--ghost:hover { background: rgba(255,255,255,0.2); }
.ws__hover-btn--primary { background: #f5820c; color: #fff; }
.ws__hover-btn--primary:hover { background: #d96f08; }

/* ── Bottom actions ── */
.ws__actions {
  text-align: center;
}
.ws__btn {
  display: inline-block;
  background: var(--gold);
  color: var(--navy);
  padding: 0.7rem 1.8rem;
  border-radius: 25px;
  font-size: 0.88rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.25s ease;
  margin-bottom: 0.7rem;
}
.ws__btn:hover {
  background: #1a2332;
  transform: translateY(-2px);
  box-shadow: 0 4px 14px rgba(48,59,79,0.3);
}
.ws__note {
  font-size: 0.8rem;
  color: var(--color-main-light, #6d7483);
}

@media (max-width: 900px) {
  .ws__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
  .ws__grid { grid-template-columns: 1fr 1fr; gap: 0.8rem; }
}
</style>

<script>
  import { supabase } from '../lib/supabase.js';

  function esc(s: any) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function listFrom(str: string) {
    if (!str) return [];
    return str.split(/[,\n]|\s-\s/).map((s: string) => s.trim()).filter(Boolean);
  }

  async function loadWriters() {
    const grid = document.getElementById('writersGrid');
    if (!grid) return;

    try {
      let { data: writers, error } = await supabase
        .from('writers')
        .select('*')
        .eq('is_active', true);

      if (error) throw error;

      const { data: stats } = await supabase.rpc('writer_stats');
      const statsMap: Record<string, any> = {};
      if (Array.isArray(stats)) stats.forEach((s: any) => { statsMap[s.writer_id] = s; });

      // Sort by most completed orders (highest first)
      if (writers) {
        writers.sort((a: any, b: any) => {
          const aCount = Number(statsMap[a.id]?.completed_orders || 0);
          const bCount = Number(statsMap[b.id]?.completed_orders || 0);
          return bCount - aCount;
        });
        writers = writers.slice(0, 4);
      };

      if (!writers || !writers.length) {
        grid.innerHTML = '<div class="ws__loading">Our writers are being onboarded — check back soon!</div>';
        return;
      }

      grid.innerHTML = writers.slice(0, 4).map((w: any) => {
        const s = statsMap[w.id] || {};
        const rating = s.avg_rating ? Number(s.avg_rating).toFixed(1) : null;
        const completed = Number(s.completed_orders || 0) + Number(w.completed_orders_offset || 150);
        const reviewCount = Number(s.review_count || 0);
        const onTime = w.on_time_percentage != null ? `${w.on_time_percentage}%` : null;
        const tags = listFrom(w.specialties).slice(0, 2);

        let sampleUrl = '';
        if (w.sample_url) {
          const { data: pub } = supabase.storage.from('writer-samples').getPublicUrl(w.sample_url);
          sampleUrl = pub.publicUrl;
        }

        const photoHtml = w.photo_url
          ? `<img class="ws__card-photo" src="${w.photo_url}" alt="${esc(w.full_name || '')}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" /><div class="ws__card-placeholder" style="display:none;">👤</div>`
          : `<div class="ws__card-placeholder">👤</div>`;

        return `
          <div class="ws__card" data-goto="/writers/">
            ${photoHtml}
            <div class="ws__card-body">
              <div class="ws__card-name">
                ${esc(w.full_name || 'Writer')}
                ${rating
                  ? `<span class="ws__card-rating"><span class="ws__card-stars">★</span> <span class="ws__card-score">${rating}</span></span>`
                  : ''
                }
              </div>
              ${w.education_level ? `<div class="ws__card-detail">${esc(w.education_level)}</div>` : ''}
              <div class="ws__card-detail">Orders completed: <strong>${completed}</strong></div>
            </div>
            <div class="ws__card-hover">
              <div class="ws__hover-top">
                <div>
                  <div class="ws__hover-name">${esc(w.full_name || 'Writer')}</div>
                  ${w.education_level ? `<div class="ws__hover-degree">${esc(w.education_level)}</div>` : ''}
                </div>
                ${sampleUrl ? `<a class="ws__hover-sample" href="${sampleUrl}" target="_blank" rel="noopener">Sample</a>` : ''}
              </div>
              ${tags.length ? `<div class="ws__hover-tags">${tags.map((t, i) => `<span class="ws__hover-tag c${(i % 2) + 1}">${esc(t)}</span>`).join('')}</div>` : ''}
              <div class="ws__hover-stats">
                ${rating ? `<div><div class="ws__hover-stat-num"><span class="star">★</span>${rating}</div><div class="ws__hover-stat-label">Last ${reviewCount || 0} reviews</div></div>` : ''}
                ${onTime ? `<div><div class="ws__hover-stat-num">${onTime}</div><div class="ws__hover-stat-label">On-Time</div></div>` : ''}
              </div>
              <div class="ws__hover-actions">
                <a class="ws__hover-btn ws__hover-btn--ghost" href="/writers/?writer=${esc(w.id)}">View profile</a>
                <a class="ws__hover-btn ws__hover-btn--primary" href="/order/?writer=${esc(w.id)}">Write my paper</a>
              </div>
            </div>
          </div>
        `;
      }).join('');

    } catch (err) {
      console.error('Writers load error:', err);
      grid.innerHTML = '<div class="ws__loading">Could not load writers.</div>';
    }
  }

  loadWriters();

  document.getElementById('writersGrid')?.addEventListener('click', (e) => {
    const actionLink = (e.target as HTMLElement).closest('.ws__hover-actions a, .ws__hover-sample');
    if (actionLink) return;
    const card = (e.target as HTMLElement).closest('.ws__card') as HTMLElement | null;
    if (card?.dataset.goto) window.location.href = card.dataset.goto;
  });
</script>
