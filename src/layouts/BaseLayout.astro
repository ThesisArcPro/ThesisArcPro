---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.astro';
const { 
  title = 'ThesisArcPro', 
  description = 'Expert academic writing and research support for high school, college, Masters and PhD students. Essays, dissertations, research papers, editing and more.',
  image = 'https://thesisarcpro.github.io/og-image.jpg',
  url = Astro.url.href
} = Astro.props;
const fullTitle = title.includes('ThesisArcPro') ? title : `${title} | ThesisArcPro`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- ✅ Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="academic writing help, essay writing service, dissertation support, research paper writing, homework help, thesis writing, PhD support, assignment help, editing proofreading, academic research" />
    <meta name="author" content="ThesisArcPro" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={url} />
    <!-- ✅ Google Search Console Verification -->
    <meta name="google-site-verification" content="IJfGWYI6-9uB6Qk8JYUVYFJBTPkv3mbLwxRHC8qFhcI" />
    <!-- ✅ Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="ThesisArcPro" />
    <meta property="og:locale" content="en_US" />
    <!-- ✅ Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <!-- ✅ Schema Markup -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "ThesisArcPro",
      "description": "Expert academic writing and research support for students at all levels",
      "url": "https://thesisarcpro.com/",
      "logo": "https://thesisarcpro.com/favicon.svg",
      "serviceType": [
        "Essay Writing",
        "Dissertation Support",
        "Research Paper Writing",
        "Editing and Proofreading",
        "Homework Help",
        "Research Consulting"
      ],
      "areaServed": "Worldwide",
      "priceRange": "$$",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "thesisarcpro069@gmail.com",
        "availableLanguage": "English"
      },
      "sameAs": []
    }
    </script>
    <!-- ✅ Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1B2A4A" />
  <!-- ✅ Trustpilot JS Integration -->
    <script is:inline>
      (function(w,d,s,r,n){w.TrustpilotObject=n;w[n]=w[n]||function(){(w[n].q=w[n].q||[]).push(arguments)};
        a=d.createElement(s);a.async=1;a.src=r;a.type='text/java'+s;f=d.getElementsByTagName(s)[0];
        f.parentNode.insertBefore(a,f)})(window,document,'script','https://invitejs.trustpilot.com/tp.min.js','tp');
        tp('register', 'YBMSgrpD20dfnUuK');
    </script>
  </head>
  <body>
    <!-- Referral capture: saves ?ref=CODE from the URL into a cookie so it
         survives navigation until the person actually signs up. Runs on
         every page since referral links may point anywhere on the site. -->
    <script is:inline>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var ref = params.get('ref');
        if (ref) {
          document.cookie = 'ref_code=' + encodeURIComponent(ref) + ';path=/;max-age=' + (60 * 60 * 24 * 30);
        }
      })();
    </script>
    <slot />
    <!-- Chat Widget -->
    <ChatWidget />
    <!-- Sitejabber reviews badge loader -->
    <script src="https://widgets.smartcustomer.com/js/v2/widgets.js" data-id="cddc1636b3af829bd776281ec825b28c18524037b9112bb4cbca2dade56bac3c" defer></script>
  </body>
</html>
