<script>
  import { supabase } from '../lib/supabase.js';

  const base = '';
  const SUPABASE_URL = 'https://rehvwvujuamehoanfomj.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_CKxnbue4T6cVn9BOIg8BkQ_kBNBiM_h';
  const BUCKET = 'completed-files';

  let allOrders: any[] = [];
  let allWriters: any[] = [];
  let currentOrder: any = null;
  let currentSession: any = null;
  let currentTab = 'all';
  let currentSection = 'dashboard';

  function hdr() {
    return { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` };
  }

  function esc(v: any) {
    return String(v ?? '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // ═══ SECTION SWITCHING ═══
  const SECTION_TITLES: Record<string, string> = {
    dashboard: 'Dashboard', orders: 'Orders', tickets: 'Tickets',
    messages: 'Messages', payments: 'Payments', leaderboard: 'Leaderboard',
    users: 'Users', settings: 'Settings'
  };

  function showSection(name: string) {
    currentSection = name;
    document.querySelectorAll('.section-panel').forEach(p => (p as HTMLElement).style.display = 'none');
    const panel = document.getElementById(`${name}Section`);
    if (panel) panel.style.display = 'block';
    document.querySelectorAll('.sidenav-item').forEach(item => {
      item.classList.toggle('active', (item as HTMLElement).dataset.section === name);
    });
    const title = document.getElementById('sectionTitle');
    if (title) title.textContent = SECTION_TITLES[name] || 'Dashboard';

    if (name === 'dashboard') renderRecentOrders();
    if (name === 'orders') renderOrders();
    if (name === 'tickets') ticketsController.load();
    if (name === 'messages') messagesController.load();
    if (name === 'payments') loadFinance();
    if (name === 'leaderboard') loadLeaderboard();
    if (name === 'users') loadUsers();
    if (name === 'settings') loadSettings();
  }

  document.querySelectorAll('.sidenav-item[data-section]').forEach(item => {
    item.addEventListener('click', () => showSection((item as HTMLElement).dataset.section!));
  });

  async function loadWriters() {
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/writers?order=full_name.asc`, { headers: hdr() });
      allWriters = await res.json();
      const sel = document.getElementById('writerSelect') as HTMLSelectElement;
      if (sel) {
        sel.innerHTML = '<option value="">— No writer assigned —</option>' +
          allWriters.map(w => `<option value="${w.id}">${esc(w.full_name || '')}</option>`).join('');
      }
    } catch (err) { console.error('Could not load writers', err); }
  }

  async function loadFinance() {
    try {
      const [payoutsRes, escrowRes, revenueRes, walletsRes] = await Promise.all([
        fetch(`${SUPABASE_URL}/rest/v1/payout_requests?select=*,writers(full_name)&order=created_at.desc`, { headers: hdr() }),
        fetch(`${SUPABASE_URL}/rest/v1/escrow_holds?select=*,orders(order_number,topic)&order=created_at.desc`, { headers: hdr() }),
        fetch(`${SUPABASE_URL}/rest/v1/platform_revenue?select=amount`, { headers: hdr() }),
        fetch(`${SUPABASE_URL}/rest/v1/wallet_transactions?type=eq.deposit&select=amount`, { headers: hdr() })
      ]);
      const payouts = await payoutsRes.json();
      const escrow = await escrowRes.json();
      const revenue = await revenueRes.json();
      const wallets = await walletsRes.json();

      const pendingTotal = (Array.isArray(payouts) ? payouts : []).filter((p: any) => p.status === 'pending').reduce((s: number, p: any) => s + Number(p.amount || 0), 0);
      const escrowHeldTotal = (Array.isArray(escrow) ? escrow : []).filter((e: any) => e.status === 'held').reduce((s: number, e: any) => s + Number(e.amount || 0), 0);
      const revenueTotal = (Array.isArray(revenue) ? revenue : []).reduce((s: number, r: any) => s + Number(r.amount || 0), 0);
      const walletsTotal = (Array.isArray(wallets) ? wallets : []).reduce((s: number, w: any) => s + Number(w.amount || 0), 0);

      const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      set('finPendingPayouts', `$${pendingTotal.toFixed(2)}`);
      set('finEscrowHeld', `$${escrowHeldTotal.toFixed(2)}`);
      set('finPlatformRevenue', `$${revenueTotal.toFixed(2)}`);
      set('finWalletsFunded', `$${walletsTotal.toFixed(2)}`);

      const payoutBox = document.getElementById('payoutRequestsList')!;
      if (!Array.isArray(payouts) || !payouts.length) {
        payoutBox.innerHTML = '<div class="input-note">No payout requests yet.</div>';
      } else {
        payoutBox.innerHTML = payouts.map((p: any) => {
          const badge = p.status === 'pending' ? '<span class="fin-badge pending">Pending</span>'
            : p.status === 'paid' ? '<span class="fin-badge paid">Paid</span>'
            : '<span class="fin-badge denied">Denied</span>';
          const actions = p.status === 'pending'
            ? `<button class="fin-action-btn approve" data-approve="${p.id}">Approve</button><button class="fin-action-btn deny" data-deny="${p.id}">Deny</button>`
            : badge;
          return `<div class="fin-row">
            <div class="fin-row-label">${esc(p.writers?.full_name || 'Writer #' + p.writer_id)}</div>
            <div style="color:#94a3b8;">${p.created_at ? new Date(p.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : ''}</div>
            <div style="font-weight:700;">$${Number(p.amount || 0).toFixed(2)}</div>
            <div>${actions}</div>
          </div>`;
        }).join('');

        payoutBox.querySelectorAll('[data-approve]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = (btn as HTMLElement).dataset.approve;
            if (!confirm('Mark this payout as paid? This confirms you have sent the funds.')) return;
            (btn as HTMLButtonElement).disabled = true;
            try {
              const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/admin_approve_payout`, {
                method: 'POST', headers: { ...hdr(), 'Content-Type': 'application/json' },
                body: JSON.stringify({ p_request_id: id })
              });
              if (!res.ok) throw new Error((await res.json())?.message || 'Failed');
              await loadFinance();
            } catch (e: any) { alert(e.message || 'Could not approve payout.'); (btn as HTMLButtonElement).disabled = false; }
          });
        });
        payoutBox.querySelectorAll('[data-deny]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = (btn as HTMLElement).dataset.deny;
            const note = prompt('Reason for denying this payout (optional):') || '';
            (btn as HTMLButtonElement).disabled = true;
            try {
              const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/admin_deny_payout`, {
                method: 'POST', headers: { ...hdr(), 'Content-Type': 'application/json' },
                body: JSON.stringify({ p_request_id: id, p_note: note })
              });
              if (!res.ok) throw new Error((await res.json())?.message || 'Failed');
              await loadFinance();
            } catch (e: any) { alert(e.message || 'Could not deny payout.'); (btn as HTMLButtonElement).disabled = false; }
          });
        });
      }

      const escrowBox = document.getElementById('escrowHoldsList')!;
      if (!Array.isArray(escrow) || !escrow.length) {
        escrowBox.innerHTML = '<div class="input-note">No escrow activity yet.</div>';
      } else {
        escrowBox.innerHTML = escrow.map((e: any) => {
          const badge = e.status === 'held' ? '<span class="fin-badge held">Held</span>'
            : e.status === 'released' ? '<span class="fin-badge released">Released</span>'
            : '<span class="fin-badge refunded">Refunded</span>';
          return `<div class="fin-row fin-row-3col">
            <div class="fin-row-label">${esc(e.orders?.topic || e.orders?.order_number || 'Order')}</div>
            <div style="font-weight:700;">$${Number(e.amount || 0).toFixed(2)}</div>
            <div>${badge}</div>
          </div>`;
        }).join('');
      }
    } catch (err) { console.error('loadFinance error', err); }
  }

  async function checkAuth() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { window.location.replace(`${base}/login/`); return; }
    currentSession = session;

    const res = await fetch(`${SUPABASE_URL}/rest/v1/profiles?email=eq.${session.user.email}&select=is_admin`, { headers: hdr() });
    const data = await res.json();
    if (!data[0]?.is_admin) { window.location.replace(`${base}/dashboard/`); return; }

    await loadOrders();
    await loadWriters();
    showSection('dashboard');
  }

  async function loadOrders() {
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/orders?order=created_at.desc`, { headers: hdr() });
      allOrders = await res.json();
      updateStats();
      if (currentSection === 'orders') renderOrders();
      if (currentSection === 'dashboard') renderRecentOrders();
    } catch (err) { console.error('Error:', err); }
  }

  function updateStats() {
    const total = allOrders.length;
    const newOrders = allOrders.filter(o => o.order_status === 'new').length;
    const inProgress = allOrders.filter(o => o.order_status === 'in_progress').length;
    const collected = allOrders.reduce((sum, o) => sum + Number(o.amount_paid || 0), 0);
    const set = (id: string, val: string) => { const el = document.getElementById(id); if (el) el.textContent = val; };
    set('statTotal', String(total));
    set('statNew', String(newOrders));
    set('statProgress', String(inProgress));
    set('statCollected', '$' + collected.toFixed(0));
    const statsText = document.getElementById('statsText');
    if (statsText) statsText.textContent = `${total} orders · managing all clients`;
  }

  function getStatusBadge(status: string) {
    const labels: Record<string, string> = { 'new': 'New', 'in_progress': 'In Progress', 'in_review': 'In Review', 'completed': 'Completed', 'revision': 'Revision', 'cancelled': 'Cancelled' };
    const cls = ['new','in_progress','in_review','completed','revision','cancelled'].includes(status) ? status : 'new';
    return `<span class="status-badge status-${cls}">${esc(labels[status] || status)}</span>`;
  }

  function deadlineInfo(deadline: string) {
    if (!deadline) return { text: 'No deadline', cls: 'none' };
    const diff = new Date(deadline).getTime() - Date.now();
    const days = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    if (diff < 0) return { text: 'Overdue', cls: 'overdue' };
    if (days === 0 && hours > 0) return { text: `${hours}h left`, cls: 'urgent' };
    if (days <= 2) return { text: `${days}d left`, cls: 'urgent' };
    return { text: `⏰ ${days}d left`, cls: 'ok' };
  }

  function orderCardHTML(order: any) {
    const dl = deadlineInfo(order.deadline);
    return `
      <div class="order-card">
        <div class="order-card__left">
          <div class="order-card__title">${esc(order.topic || 'N/A')}</div>
          <div class="order-card__meta">
            ${getStatusBadge(order.order_status || 'new')}
            <span class="meta-dot">·</span>
            <span class="meta-item">${esc(order.order_number || order.id)}</span>
            <span class="meta-dot">·</span>
            <span class="meta-item">${esc(order.pages || 1)} pages</span>
            <span class="meta-dot">·</span>
            <span class="meta-item">${esc(order.assignment_type || 'N/A')}</span>
          </div>
        </div>
        <div class="order-card__right">
          <div class="order-card__deadline ${dl.cls}">${dl.text}</div>
          <div class="order-card__amount">$${Number(order.total_amount || 0).toFixed(2)} <span class="amount-paid">($${Number(order.amount_paid || 0).toFixed(2)})</span></div>
          <button class="btn-update-order" data-id="${esc(order.id)}">✏️ Update</button>
        </div>
      </div>`;
  }

  function attachUpdateButtons(container: HTMLElement) {
    container.querySelectorAll('.btn-update-order').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        const order = allOrders.find(o => String(o.id) === id);
        if (order) openUpdateModal(order);
      });
    });
  }

  function renderRecentOrders() {
    const grid = document.getElementById('recentOrdersGrid');
    if (!grid) return;
    const recent = allOrders.slice(0, 5);
    if (!recent.length) { grid.innerHTML = '<div class="input-note">No orders yet.</div>'; return; }
    grid.innerHTML = recent.map(orderCardHTML).join('');
    attachUpdateButtons(grid);
  }

  function renderOrders() {
    const loading = document.getElementById('loadingState');
    const empty = document.getElementById('emptyState');
    const grid = document.getElementById('ordersGrid');
    const search = (document.getElementById('searchInput') as HTMLInputElement)?.value.toLowerCase() || '';
    if (loading) loading.style.display = 'none';

    let filtered = currentTab === 'all' ? allOrders : allOrders.filter(o => o.order_status === currentTab);
    if (search) {
      filtered = filtered.filter(o =>
        (o.topic || '').toLowerCase().includes(search) ||
        (o.client_email || '').toLowerCase().includes(search) ||
        (o.order_number || '').toLowerCase().includes(search)
      );
    }

    if (!filtered.length) {
      if (empty) empty.style.display = 'block';
      if (grid) grid.style.display = 'none';
      return;
    }
    if (empty) empty.style.display = 'none';
    if (grid) {
      grid.style.display = 'flex';
      grid.innerHTML = filtered.map(orderCardHTML).join('');
      attachUpdateButtons(grid);
    }
  }

  document.querySelectorAll('#orderStatusTabs .tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('#orderStatusTabs .tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentTab = (tab as HTMLElement).dataset.tab || 'all';
      renderOrders();
    });
  });

  document.getElementById('searchInput')?.addEventListener('input', renderOrders);

  function openUpdateModal(order: any) {
    currentOrder = order;
    const modal = document.getElementById('updateModal');
    const modalOrderNum = document.getElementById('modalOrderNum');
    const statusSelect = document.getElementById('statusSelect') as HTMLSelectElement;
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const currentFile = document.getElementById('currentFile');
    const currentFileName = document.getElementById('currentFileName');

    if (modalOrderNum) modalOrderNum.textContent = `Order ${order.order_number || order.id}`;
    const modalClientEmail = document.getElementById('modalClientEmail');
    if (modalClientEmail) modalClientEmail.textContent = order.client_email || '';
    if (statusSelect) statusSelect.value = order.order_status || 'new';
    const writerSelect = document.getElementById('writerSelect') as HTMLSelectElement;
    if (writerSelect) writerSelect.value = order.writer_id ? String(order.writer_id) : '';
    if (fileInput) fileInput.value = '';

    const revisionNoteBox = document.getElementById('revisionNoteBox');
    const revisionNoteText = document.getElementById('revisionNoteText');
    if (revisionNoteBox && revisionNoteText) {
      if (order.revision_note && String(order.revision_note).trim()) {
        revisionNoteText.textContent = order.revision_note;
        revisionNoteBox.style.display = 'block';
      } else { revisionNoteBox.style.display = 'none'; }
    }

    if (currentFile && currentFileName) {
      if (order.file_url) {
        const parts = String(order.file_url).split('/');
        currentFileName.textContent = '📎 Attached: ' + parts[parts.length - 1];
        currentFile.style.display = 'block';
      } else { currentFile.style.display = 'none'; }
    }

    loadAdminFiles(order.id);
    modal?.classList.add('active');
  }

  async function loadAdminFiles(orderId: string) {
    const box = document.getElementById('adminFilesList');
    if (!box) return;
    box.innerHTML = '<span class="input-note">Loading…</span>';
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/order_files?order_id=eq.${orderId}&order=created_at.desc`, { headers: hdr() });
      const files = await res.json();
      if (!Array.isArray(files) || !files.length) { box.innerHTML = '<span class="input-note">No files uploaded yet.</span>'; return; }
      box.innerHTML = files.map((f: any) => `
        <div class="afile-row">
          <div class="afile-info"><span class="afile-type">${esc(f.file_type || 'File')}</span><span class="afile-name">${esc(f.file_name || 'file')}</span><span class="afile-by">${esc(f.uploaded_by || '')}</span></div>
          <button type="button" class="afile-dl" data-path="${esc(f.file_path)}">📥</button>
        </div>`).join('');
      box.querySelectorAll('.afile-dl').forEach(btn => {
        btn.addEventListener('click', async () => {
          const path = (btn as HTMLElement).dataset.path || '';
          (btn as HTMLButtonElement).disabled = true;
          try {
            const { data, error } = await supabase.storage.from(BUCKET).createSignedUrl(path, 120);
            if (error || !data?.signedUrl) throw error || new Error('No URL');
            window.open(data.signedUrl, '_blank');
          } catch { alert('Could not prepare download.'); }
          (btn as HTMLButtonElement).disabled = false;
        });
      });
    } catch (err) { console.error(err); box.innerHTML = '<span class="input-note">Could not load files.</span>'; }
  }

  document.getElementById('modalClose')?.addEventListener('click', () => {
    document.getElementById('updateModal')?.classList.remove('active');
  });

  document.getElementById('saveUpdateBtn')?.addEventListener('click', async () => {
    if (!currentOrder) return;
    const status = (document.getElementById('statusSelect') as HTMLSelectElement).value;
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const btn = document.getElementById('saveUpdateBtn') as HTMLButtonElement;
    const progress = document.getElementById('uploadProgress');
    btn.disabled = true;
    let filePath = currentOrder.file_url || null;
    try {
      const file = fileInput.files && fileInput.files[0];
      if (file) {
        if (progress) progress.style.display = 'block';
        btn.textContent = '⏳ Uploading…';
        const ticket = currentOrder.order_number || String(currentOrder.id);
        const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
        const path = `${ticket}/${safeName}`;
        const { error: uploadError } = await supabase.storage.from(BUCKET).upload(path, file, { upsert: true });
        if (uploadError) throw uploadError;
        filePath = path;
        if (progress) progress.style.display = 'none';
      }
      btn.textContent = '⏳ Saving…';
      await fetch(`${SUPABASE_URL}/rest/v1/orders?id=eq.${currentOrder.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', ...hdr() },
        body: JSON.stringify({
          order_status: status, file_url: filePath,
          writer_id: (document.getElementById('writerSelect') as HTMLSelectElement)?.value || null,
          status_updated_at: new Date().toISOString()
        })
      });
      document.getElementById('updateModal')?.classList.remove('active');
      btn.textContent = '💾 Save Changes';
      btn.disabled = false;
      await loadOrders();
    } catch (err) {
      console.error(err);
      if (progress) progress.style.display = 'none';
      btn.textContent = '❌ Upload failed — try again';
      btn.disabled = false;
    }
  });

  document.getElementById('logoutBtn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.replace(`${base}/login/`);
  });

  // ── THEME TOGGLE ──
  const THEME_KEY = 'admin-theme';
  function getSystemPref() { return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
  function applyTheme(setting: string) {
    const actual = setting === 'system' ? getSystemPref() : setting;
    document.body.classList.toggle('dark-mode', actual === 'dark');
    document.querySelectorAll('.tt-btn').forEach(btn => btn.classList.toggle('active', (btn as HTMLElement).dataset.theme === setting));
    localStorage.setItem(THEME_KEY, setting);
  }
  document.querySelectorAll('.tt-btn').forEach(btn => btn.addEventListener('click', () => applyTheme((btn as HTMLElement).dataset.theme || 'light')));
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { if (localStorage.getItem(THEME_KEY) === 'system') applyTheme('system'); });
  applyTheme(localStorage.getItem(THEME_KEY) || 'light');

  // ═══ INBOX CONTROLLER FACTORY (shared by Tickets + Messages) ═══
  function makeInboxController(opts: {
    kind: 'support' | 'order';
    idPrefix: string;
    withStatus: boolean;
  }) {
    let conversations: any[] = [];
    let activeId: string | null = null;
    let sub: any = null;
    let statusFilter = 'all';

    const ids = {
      list: `${opts.idPrefix}List`,
      count: `${opts.idPrefix}Count`,
      empty: `${opts.idPrefix}Empty`,
      thread: `${opts.idPrefix}Thread`,
      header: `${opts.idPrefix}ThreadHeader`,
      messages: `${opts.idPrefix}Messages`,
      input: `${opts.idPrefix}Input`,
      send: `${opts.idPrefix}SendBtn`
    };

    async function load() {
      const list = document.getElementById(ids.list);
      if (!list) return;
      list.innerHTML = '<div class="inbox-loading">Loading…</div>';
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/conversations?type=eq.${opts.kind}&order=updated_at.desc`, { headers: hdr() });
        conversations = await res.json();
        if (opts.idPrefix === 'tickets') {
          const openCount = conversations.filter((c: any) => (c.status || 'open') === 'open').length;
          const badge = document.getElementById('ticketsBadge');
          if (badge) { badge.style.display = openCount ? 'inline-block' : 'none'; badge.textContent = String(openCount); }
        }
        renderList();
      } catch (err) { console.error(err); list.innerHTML = '<div class="inbox-loading">Could not load</div>'; }
    }

    function renderList() {
      const list = document.getElementById(ids.list)!;
      const count = document.getElementById(ids.count)!;
      let filtered = conversations.filter((c: any) => !c.archived);
      if (opts.withStatus && statusFilter !== 'all') {
        filtered = filtered.filter((c: any) => (c.status || 'open') === statusFilter);
      }
      count.textContent = String(filtered.length);
      if (!filtered.length) { list.innerHTML = '<div class="inbox-loading">Nothing here</div>'; return; }
      list.innerHTML = filtered.map((c: any) => {
        const initials = opts.kind === 'support' ? 'SP' : 'OR';
        const avatarCls = opts.kind === 'support' ? 'avatar-support' : 'avatar-order';
        const time = c.updated_at ? new Date(c.updated_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
        const isActive = c.id === activeId;
        const label = c.title || (opts.kind === 'support' ? 'Support Chat' : 'Order Chat');
        const statusWord = opts.withStatus
          ? `<span class="ticket-status-label ${c.status || 'open'}">${esc((c.status || 'open').charAt(0).toUpperCase() + (c.status || 'open').slice(1))}</span><span class="inbox-item-dot">·</span>`
          : '';
        const preview = c.last_message
          ? `<div class="inbox-item-preview"><span>${esc(c.last_message)}</span><i class="inbox-item-preview-check">✓</i></div>`
          : `<div class="inbox-item-type">${opts.kind === 'support' ? 'Support' : 'Order chat'}</div>`;
        return `<div class="inbox-item ${isActive ? 'active' : ''}" data-cid="${c.id}">
          <div class="inbox-item-avatar ${avatarCls}">${initials}</div>
          <div class="inbox-item-info">
            <div class="inbox-item-toprow">${statusWord}<span class="inbox-item-name">${esc(label)}</span><span class="inbox-item-time">${time}</span></div>
            ${preview}
          </div>
        </div>`;
      }).join('');
      list.querySelectorAll('.inbox-item').forEach(item => {
        item.addEventListener('click', () => openThread((item as HTMLElement).dataset.cid!));
      });
    }

    async function ensureOrderWriter(conv: any, notify = false) {
      if (!conv || conv.type !== 'order' || !conv.order_id) { if (notify) alert('This is not an order chat.'); return; }
      try {
        const order = (await (await fetch(`${SUPABASE_URL}/rest/v1/orders?id=eq.${conv.order_id}&select=writer_id`, { headers: hdr() })).json())[0];
        if (!order?.writer_id) { if (notify) alert('No writer is assigned to this order yet.'); return; }
        const writer = (await (await fetch(`${SUPABASE_URL}/rest/v1/writers?id=eq.${order.writer_id}&select=auth_user_id,full_name`, { headers: hdr() })).json())[0];
        if (!writer?.auth_user_id) { if (notify) alert('That writer has no linked account.'); return; }
        const existing = await (await fetch(`${SUPABASE_URL}/rest/v1/conversation_participants?conversation_id=eq.${conv.id}&user_id=eq.${writer.auth_user_id}&select=id`, { headers: hdr() })).json();
        if (existing.length) { if (notify) alert(`${writer.full_name || 'Writer'} is already in this chat.`); return; }
        await fetch(`${SUPABASE_URL}/rest/v1/conversation_participants`, {
          method: 'POST', headers: { ...hdr(), 'Content-Type': 'application/json' },
          body: JSON.stringify({ conversation_id: conv.id, user_id: writer.auth_user_id, role: 'writer', display_name: writer.full_name || 'Writer' })
        });
        if (notify) alert(`✅ ${writer.full_name || 'Writer'} added to this chat.`);
      } catch (err) { console.error('ensureOrderWriter', err); if (notify) alert('Could not add writer.'); }
    }

    async function setTicketStatus(conv: any, status: string) {
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/conversations?id=eq.${conv.id}`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json', ...hdr(), 'Prefer': 'return=minimal' },
          body: JSON.stringify({ status })
        });
        conv.status = status;
        renderList();
        openThread(conv.id);
      } catch (err) { console.error(err); alert('Could not update ticket status.'); }
    }

    async function archiveConversation(conv: any) {
      if (!conv) return;
      const newVal = !conv.archived;
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/conversations?id=eq.${conv.id}`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json', ...hdr(), 'Prefer': 'return=minimal' },
          body: JSON.stringify({ archived: newVal })
        });
        conv.archived = newVal;
        document.getElementById(ids.thread)!.style.display = 'none';
        document.getElementById(ids.empty)!.style.display = 'flex';
        activeId = null;
        renderList();
      } catch (err) { console.error(err); alert('Could not archive.'); }
    }

    async function deleteConversation(conv: any) {
      if (!conv) return;
      if (!confirm('Permanently delete this conversation and ALL its messages? This cannot be undone.')) return;
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/conversations?id=eq.${conv.id}`, {
          method: 'DELETE', headers: { ...hdr(), 'Prefer': 'return=minimal' }
        });
        conversations = conversations.filter((c: any) => c.id !== conv.id);
        document.getElementById(ids.thread)!.style.display = 'none';
        document.getElementById(ids.empty)!.style.display = 'flex';
        activeId = null;
        renderList();
      } catch (err) { console.error(err); alert('Could not delete.'); }
    }

    async function openThread(conversationId: string) {
      activeId = conversationId;
      const conv = conversations.find((c: any) => c.id === conversationId);
      document.getElementById(ids.empty)!.style.display = 'none';
      const thread = document.getElementById(ids.thread)!;
      thread.style.display = 'flex';
      const header = document.getElementById(ids.header)!;
      const typeLabel = opts.kind === 'support' ? 'Support ticket' : 'Order chat';
      const avatarCls = opts.kind === 'support' ? 'avatar-support' : 'avatar-order';
      const initials = opts.kind === 'support' ? 'SP' : 'OR';
      const localTime = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });

      let statusControls = '';
      if (opts.withStatus) {
        const current = conv?.status || 'open';
        statusControls = `<select class="ticket-status-select" id="${opts.idPrefix}StatusSelect" style="padding:0.35rem 0.6rem;border-radius:8px;border:1px solid #e2e8f0;font-size:0.75rem;">
          <option value="open" ${current === 'open' ? 'selected' : ''}>Open</option>
          <option value="resolved" ${current === 'resolved' ? 'selected' : ''}>Resolved</option>
          <option value="closed" ${current === 'closed' ? 'selected' : ''}>Closed</option>
        </select>`;
      }
      const writerBtn = conv?.type === 'order' ? `<button class="inbox-addwriter-btn" id="${opts.idPrefix}AddWriterBtn">➕ Add writer</button>` : '';
      const archiveBtn = conv?.archived
        ? `<button class="inbox-clear-btn" id="${opts.idPrefix}ArchiveBtn">♻️ Restore</button>`
        : `<button class="inbox-clear-btn" id="${opts.idPrefix}ArchiveBtn">🗄️ Archive</button>`;
      const deleteBtn = `<button class="inbox-clear-btn danger" id="${opts.idPrefix}DeleteBtn">🗑️ Delete</button>`;
      const lastActive = conv?.updated_at ? new Date(conv.updated_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—';
      header.innerHTML = `<div class="inbox-item-avatar ${avatarCls}" style="flex-shrink:0;">${initials}</div>
        <div style="flex:1;min-width:0;"><div class="inbox-thread-title">${esc(conv?.title || 'Chat')}</div><div class="inbox-thread-sub">${typeLabel} · last active ${lastActive}</div></div>
        <div style="font-size:0.7rem;color:#94a3b8;margin-right:0.4rem;">${localTime}</div>
        ${statusControls}${writerBtn}${archiveBtn}${deleteBtn}`;

      if (conv?.type === 'order') {
        ensureOrderWriter(conv);
        document.getElementById(`${opts.idPrefix}AddWriterBtn`)?.addEventListener('click', () => ensureOrderWriter(conv, true));
      }
      if (opts.withStatus) {
        document.getElementById(`${opts.idPrefix}StatusSelect`)?.addEventListener('change', (e) => {
          setTicketStatus(conv, (e.target as HTMLSelectElement).value);
        });
      }
      document.getElementById(`${opts.idPrefix}ArchiveBtn`)?.addEventListener('click', () => archiveConversation(conv));
      document.getElementById(`${opts.idPrefix}DeleteBtn`)?.addEventListener('click', () => deleteConversation(conv));
      renderList();

      const container = document.getElementById(ids.messages)!;
      container.innerHTML = '<div style="text-align:center;color:#94a3b8;padding:2rem;font-size:0.85rem;">Loading…</div>';
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/messages?conversation_id=eq.${conversationId}&order=created_at.asc`, { headers: hdr() });
        renderMessages(await res.json());
      } catch { container.innerHTML = '<div style="text-align:center;color:#94a3b8;">Could not load messages</div>'; }

      if (sub) { sub.unsubscribe(); sub = null; }
      sub = supabase.channel(`admin-${opts.idPrefix}-${conversationId}`)
        .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages', filter: `conversation_id=eq.${conversationId}` },
          (payload: any) => {
            const msg = payload.new;
            const c = document.getElementById(ids.messages)!;
            const ph = c.querySelector('div[style*="text-align:center"]');
            if (ph) c.innerHTML = '';
            const isMine = msg.sender_role === 'support' || msg.sender_id === currentSession.user.id;
            const time = msg.created_at ? new Date(msg.created_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '';
            c.insertAdjacentHTML('beforeend', `<div class="imsg-row ${isMine ? 'mine' : 'theirs'}">
              ${!isMine ? `<div class="imsg-sender-name">${esc(msg.sender_name || msg.sender_role || 'User')}</div>` : ''}
              <div class="imsg-bubble">${esc(msg.content)}</div>
              <div class="imsg-time">${time}</div>
            </div>`);
            c.scrollTop = c.scrollHeight;
          }
        ).subscribe();
    }

    function dayLabel(d: Date) {
      const today = new Date();
      const yest = new Date(); yest.setDate(today.getDate() - 1);
      const sameDay = (a: Date, b: Date) => a.toDateString() === b.toDateString();
      if (sameDay(d, today)) return 'Today';
      if (sameDay(d, yest)) return 'Yesterday';
      return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: d.getFullYear() !== today.getFullYear() ? 'numeric' : undefined });
    }

    function renderMessages(messages: any[]) {
      const container = document.getElementById(ids.messages)!;
      if (!messages.length) { container.innerHTML = '<div style="text-align:center;color:#94a3b8;padding:2rem;font-size:0.85rem;">No messages yet.</div>'; return; }
      let lastDay = '';
      const parts: string[] = [];
      messages.forEach((m: any) => {
        const created = m.created_at ? new Date(m.created_at) : null;
        const day = created ? created.toDateString() : '';
        if (day && day !== lastDay) {
          parts.push(`<div class="imsg-date-divider">${dayLabel(created!)}</div>`);
          lastDay = day;
        }
        const isSupport = m.sender_role === 'support' || m.sender_id === currentSession.user.id;
        const time = created ? created.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '';
        const senderLabel = isSupport ? 'Support' : (m.sender_name || 'User');
        const avatarInitial = isSupport ? 'S' : (m.sender_name?.[0]?.toUpperCase() || 'U');
        const readCheck = isSupport ? '<span class="imsg-read-check">✓</span>' : '';
        parts.push(`<div class="imsg-row ${isSupport ? 'mine' : 'theirs'}">
          ${!isSupport ? `<div class="imsg-meta"><div class="imsg-avatar theirs-avatar">${avatarInitial}</div><div class="imsg-sender-name">${esc(senderLabel)}</div></div>` : ''}
          <div class="imsg-bubble">${esc(m.content)}</div>
          ${isSupport ? `<div class="imsg-meta-right"><div class="imsg-sender-name" style="text-align:right">You</div><div class="imsg-avatar mine-avatar">S</div></div>` : ''}
          <div class="imsg-time">${time}${readCheck}</div>
        </div>`);
      });
      container.innerHTML = parts.join('');
      container.scrollTop = container.scrollHeight;
    }

    async function send() {
      const input = document.getElementById(ids.input) as HTMLInputElement;
      const content = input.value.trim();
      if (!content || !activeId) return;
      const btn = document.getElementById(ids.send) as HTMLButtonElement;
      btn.disabled = true; input.value = '';
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/messages`, {
          method: 'POST', headers: { 'Content-Type': 'application/json', ...hdr() },
          body: JSON.stringify({ conversation_id: activeId, sender_id: currentSession.user.id, sender_name: 'Support', sender_role: 'support', content })
        });
        await fetch(`${SUPABASE_URL}/rest/v1/conversations?id=eq.${activeId}`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json', ...hdr(), 'Prefer': 'return=minimal' },
          body: JSON.stringify({ updated_at: new Date().toISOString(), last_message: `You ${content}` })
        });
        const conv = conversations.find((c: any) => c.id === activeId);
        if (conv) conv.last_message = `You ${content}`;
        renderList();
      } catch (err) { console.error(err); }
      btn.disabled = false; input.focus();
    }

    document.getElementById(ids.send)?.addEventListener('click', send);
    document.getElementById(ids.input)?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); send(); } });

    if (opts.withStatus) {
      document.querySelectorAll(`#ticketsSection .inbox-filter`).forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll(`#ticketsSection .inbox-filter`).forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          statusFilter = (btn as HTMLElement).dataset.tstatus || 'all';
          renderList();
        });
      });
    }

    return { load };
  }

  const ticketsController = makeInboxController({ kind: 'support', idPrefix: 'tickets', withStatus: true });
  const messagesController = makeInboxController({ kind: 'order', idPrefix: 'messages', withStatus: false });

  // ═══ SETTINGS ═══
  document.getElementById('savePasswordBtn')?.addEventListener('click', async () => {
    const pw = (document.getElementById('newPasswordInput') as HTMLInputElement).value;
    const confirm2 = (document.getElementById('confirmPasswordInput') as HTMLInputElement).value;
    const note = document.getElementById('passwordStatusNote')!;
    if (!pw || pw.length < 8) { note.textContent = 'Password must be at least 8 characters.'; return; }
    if (pw !== confirm2) { note.textContent = 'Passwords do not match.'; return; }
    const btn = document.getElementById('savePasswordBtn') as HTMLButtonElement;
    btn.disabled = true;
    const { error } = await supabase.auth.updateUser({ password: pw });
    btn.disabled = false;
    note.textContent = error ? (error.message || 'Could not update password.') : 'Password updated.';
    if (!error) {
      (document.getElementById('newPasswordInput') as HTMLInputElement).value = '';
      (document.getElementById('confirmPasswordInput') as HTMLInputElement).value = '';
    }
  });

  async function loadMfaStatus() {
    const row = document.getElementById('mfaStatusRow')!;
    const enrollBtn = document.getElementById('mfaEnrollBtn') as HTMLButtonElement;
    try {
      const { data, error } = await supabase.auth.mfa.listFactors();
      if (error) throw error;
      const verified = (data?.totp || []).find((f: any) => f.status === 'verified');
      if (verified) {
        row.textContent = '2FA is enabled on this account.';
        enrollBtn.style.display = 'none';
      } else {
        row.textContent = '2FA is not enabled.';
        enrollBtn.style.display = 'inline-block';
      }
    } catch (err) {
      row.textContent = 'Could not check 2FA status.';
    }
  }

  document.getElementById('mfaEnrollBtn')?.addEventListener('click', async () => {
    const box = document.getElementById('mfaEnrollBox')!;
    const secretText = document.getElementById('mfaSecretText')!;
    try {
      const { data, error } = await supabase.auth.mfa.enroll({ factorType: 'totp' });
      if (error) throw error;
      secretText.textContent = data?.totp?.uri || data?.totp?.secret || '';
      (box as HTMLElement).dataset.factorId = data?.id || '';
      box.style.display = 'block';
    } catch (err: any) { alert(err.message || 'Could not start 2FA enrollment.'); }
  });

  document.getElementById('mfaVerifyBtn')?.addEventListener('click', async () => {
    const box = document.getElementById('mfaEnrollBox') as HTMLElement;
    const factorId = box.dataset.factorId || '';
    const code = (document.getElementById('mfaCodeInput') as HTMLInputElement).value.trim();
    if (!factorId || !code) return;
    try {
      const { data: challenge, error: chErr } = await supabase.auth.mfa.challenge({ factorId });
      if (chErr) throw chErr;
      const { error: verErr } = await supabase.auth.mfa.verify({ factorId, challengeId: challenge.id, code });
      if (verErr) throw verErr;
      box.style.display = 'none';
      await loadMfaStatus();
    } catch (err: any) { alert(err.message || 'Invalid code — try again.'); }
  });

  // ═══ USERS (support/admin team — NOT writers) ═══
  // Assumes a `role` text column on `profiles` ('admin' | 'support'), separate from `is_admin`.
  async function loadUsers() {
    const box = document.getElementById('usersList')!;
    box.innerHTML = '<span class="input-note">Loading…</span>';
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/profiles?role=in.(admin,support)&order=full_name.asc`, { headers: hdr() });
      const users = await res.json();
      if (!Array.isArray(users) || !users.length) { box.innerHTML = '<span class="input-note">No team members added yet.</span>'; return; }
      box.innerHTML = users.map((u: any) => `
        <div class="afile-row">
          <div class="afile-info"><span class="afile-type">${esc(u.role || 'support')}</span><span class="afile-name">${esc(u.full_name || 'Unnamed')}</span><span class="afile-by">${esc(u.email || '')}</span></div>
        </div>`).join('');
    } catch (err) { console.error(err); box.innerHTML = '<span class="input-note">Could not load users.</span>'; }
  }

  document.getElementById('addUserBtn')?.addEventListener('click', async () => {
    const name = (document.getElementById('userNameInput') as HTMLInputElement).value.trim();
    const email = (document.getElementById('userEmailInput') as HTMLInputElement).value.trim();
    const role = (document.getElementById('userRoleInput') as HTMLSelectElement).value;
    if (!name || !email) { alert('Enter a name and email.'); return; }
    const btn = document.getElementById('addUserBtn') as HTMLButtonElement;
    btn.disabled = true;
    try {
      await fetch(`${SUPABASE_URL}/rest/v1/profiles`, {
        method: 'POST', headers: { 'Content-Type': 'application/json', ...hdr(), 'Prefer': 'return=minimal' },
        body: JSON.stringify({ full_name: name, email, role })
      });
      (document.getElementById('userNameInput') as HTMLInputElement).value = '';
      (document.getElementById('userEmailInput') as HTMLInputElement).value = '';
      await loadUsers();
    } catch (err) { console.error(err); alert('Could not add user.'); }
    btn.disabled = false;
  });

  function loadSettings() {
    loadMfaStatus();
  }

  // ═══ LEADERBOARD (writers ranked by completed orders) ═══
  function loadLeaderboard() {
    const box = document.getElementById('leaderboardList')!;
    if (!allWriters.length) { box.innerHTML = '<div class="input-note">No writers yet.</div>'; return; }
    const ranked = allWriters.map((w: any) => {
      const completed = allOrders.filter((o: any) => o.writer_id === w.id && o.order_status === 'completed');
      const earned = completed.reduce((s: number, o: any) => s + Number(o.total_amount || 0), 0);
      return { name: w.full_name || 'Unnamed', completed: completed.length, earned };
    }).sort((a, b) => b.completed - a.completed);
    if (!ranked.length || !ranked.some(r => r.completed > 0)) { box.innerHTML = '<div class="input-note">No completed orders yet.</div>'; return; }
    box.innerHTML = ranked.map((r, i) => `
      <div class="fin-row" style="grid-template-columns:0.4fr 1.6fr 1fr 1fr;">
        <div style="font-weight:700;color:#94a3b8;">${i + 1}</div>
        <div class="fin-row-label">${esc(r.name)}</div>
        <div>${r.completed}</div>
        <div style="font-weight:700;">$${r.earned.toFixed(2)}</div>
      </div>`).join('');
  }

  checkAuth();
</script>
