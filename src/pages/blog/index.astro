---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCategoryTabs from '../../components/BlogCategoryTabs.astro';

const allPosts = (await getCollection('blogIndex')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categorySlug = (cat: string) =>
  cat.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const activeCategorySlug = Astro.url.searchParams.get('category') || 'all';

const visiblePosts = activeCategorySlug === 'all'
  ? allPosts
  : allPosts.filter(p => categorySlug(p.data.category) === activeCategorySlug);

const featuredPost = visiblePosts.find(p => p.data.featured) ?? visiblePosts[0];
const restPosts = featuredPost ? visiblePosts.filter(p => p.id !== featuredPost.id) : [];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<BaseLayout
  title="Academic Writing Blog | ThesisArcPro"
  description="Expert tips, guides and advice on essay writing, thesis development, research papers and academic success for university students worldwide.">

  <Header />
  <main class="blog-index">

    <nav class="breadcrumb">
      <a href="/" class="breadcrumb-home" aria-label="Home">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2e66d6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
          <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        </svg>
      </a>
      <span>/</span> <span>Blog</span>
    </nav>

    <section class="blog-hero-header">
      <h1>Thesisarcpro Blog</h1>
      <p>You don't have to worry about pressing deadlines and
      sleepless nights. Our <a href="/services" class="hero-inline-link">essay writing
      service</a> specialists love sharing practical tips to make
      your assignments easier. Explore the blog and write with
      confidence.</p>
    </section>

    <BlogCategoryTabs />

        {featuredPost && (
      <section class="featured-post" data-category={categorySlug(featuredPost.data.category)}>
        <a href={featuredPost.data.url} class="featured-post__image">
          <img src={featuredPost.data.cover_image} alt={featuredPost.data.cover_alt} loading="eager" />
        </a>
        <div class="featured-post__body">
          <span class="post-category">{featuredPost.data.category}</span>
          <h2><a href={featuredPost.data.url}>{featuredPost.data.title}</a></h2>
          <p>{featuredPost.data.description}</p>
          <div class="featured-post__footer">
            <a href={featuredPost.data.url} class="read-more-btn">Read more</a>
            <div class="post-meta-right">
              <span>{formatDate(featuredPost.data.date)}</span>
              {featuredPost.data.read_time_minutes && <span>{featuredPost.data.read_time_minutes} min read</span>}
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="blog-grid" id="blogGrid">
      {restPosts.map((post, i) => (
        <>
          <article
            class="blog-card"
            data-category={categorySlug(post.data.category)}
            data-index={i}
          >
            <a href={post.data.url} class="blog-card__image">
              <img src={post.data.cover_image} alt={post.data.cover_alt} loading="lazy" />
            </a>
            <div class="blog-card__body">
              <span class="post-category">{post.data.category}</span>
              <h3><a href={post.data.url}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <div class="blog-card__footer">
                <a href={post.data.url} class="read-more-btn read-more-btn--small">Read more</a>
                <div class="post-meta-right">
                  <span>{formatDate(post.data.date)}</span>
                  {post.data.read_time_minutes && <span>{post.data.read_time_minutes} min</span>}
                </div>
              </div>
            </div>
          </article>

          {i === 1 && (
            <a href="/samples" class="samples-cta-card" data-category="all" data-index={`${i}-cta`}>
              <img src="https://rehvwvujuamehoanfomj.supabase.co/storage/v1/object/public/blog-images/magnification.webp" alt="Magnifying glass over sample essay illustration" class="samples-cta-card__icon" />
              <p>Check Out <span class="samples-cta-highlight">the Samples</span><br />Written by Our Experts</p>
              <span class="samples-cta-btn">View Samples</span>
            </a>
          )}
        </>
      ))}
    </section>

    <div class="load-more-wrap">
      <button id="loadMoreBtn" class="load-more-btn">Load more</button>
    </div>

    <div class="browse-all-wrap">
      <a href="/blog" class="browse-all-btn">Browse all</a>
    </div>

  </main>
  <Footer />

</BaseLayout>

<script>
  const BATCH_SIZE = 6;
  const cards = document.querySelectorAll<HTMLElement>('#blogGrid > *');
  const loadMoreBtn = document.getElementById('loadMoreBtn') as HTMLButtonElement;

  let visibleCount = BATCH_SIZE;

  function render() {
    cards.forEach((c, i) => {
      c.style.display = i < visibleCount ? '' : 'none';
    });
    if (loadMoreBtn) {
      loadMoreBtn.style.display = cards.length > visibleCount ? 'inline-block' : 'none';
    }
  }

  loadMoreBtn?.addEventListener('click', () => {
    visibleCount += BATCH_SIZE;
    render();
  });

  render();
</script>

<style>
  .blog-index {
    max-width: 1180px;
    margin: 0 auto;
    padding: 6.5rem 1.5rem 3rem;
  }

  .blog-hero-header {
    text-align: center;
    padding: 2rem 0 2.5rem;
  }
  .blog-hero-header h1 {
    font-size: 2.5rem;
    color: #1B2A4A;
    margin-bottom: 0.75rem;
  }
  .blog-hero-header p {
    font-size: 1.1rem;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Category tabs */
  .category-tabs {
    display: flex;
    gap: 0.15rem;
    overflow-x: auto;
    padding: 0.75rem 0 1.75rem;
    border-bottom: 1px solid #e2e8f0;
    margin-bottom: 2rem;
    scrollbar-width: thin;
  }
  .tab-btn {
    flex-shrink: 0;
    background: none;
    border: none;
    color: #2563EB;
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.5rem 0.6rem;
    border-radius: 20px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .tab-btn:hover { color: #1B2A4A; }
  .tab-btn.active {
    background: #1B2A4A;
    color: #fff;
    font-weight: 700;
  }

  .post-category {
    display: inline-block;
    color: #C9A84C;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    margin-bottom: 0.5rem;
  }

  .read-more-btn {
    display: inline-block;
    background: #eef2f7;
    color: #1B2A4A;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.55rem 1.2rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .read-more-btn:hover { background: #dde5ef; }
  .read-more-btn--small { padding: 0.45rem 1rem; font-size: 0.8rem; }

  .post-meta-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-size: 0.78rem;
    color: #94a3b8;
    line-height: 1.4;
  }

  /* Featured post */
  .featured-post {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2rem;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.25rem;
    margin-bottom: 2.5rem;
    align-items: center;
  }
  .featured-post__image { display: block; border-radius: 10px; overflow: hidden; }
  .featured-post__image img { width: 100%; height: 260px; object-fit: cover; display: block; }
  .featured-post__body h2 { font-size: 1.6rem; line-height: 1.3; margin-bottom: 0.75rem; }
  .featured-post__body h2 a { color: #1B2A4A; text-decoration: none; }
  .featured-post__body h2 a:hover { text-decoration: underline; }
  .featured-post__body p { color: #64748b; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem; }
  .featured-post__footer { display: flex; align-items: center; justify-content: space-between; }

  /* Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-bottom: 2.5rem;
  }

  .blog-card {
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
    transition: box-shadow 0.3s ease;
  }
  .blog-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
  .blog-card__image { display: block; }
  .blog-card__image img { width: 100%; height: 180px; object-fit: cover; display: block; }
  .blog-card__body { padding: 1.1rem 1.25rem 1.25rem; }
  .blog-card h3 { font-size: 1.05rem; line-height: 1.4; margin-bottom: 0.6rem; }
  .blog-card h3 a { color: #1B2A4A; text-decoration: none; }
  .blog-card h3 a:hover { text-decoration: underline; }
  .blog-card p { color: #64748b; font-size: 0.88rem; line-height: 1.55; margin-bottom: 1rem; }
  .blog-card__footer { display: flex; align-items: center; justify-content: space-between; }

  /* Samples CTA card */
  .samples-cta-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    border: 1.5px solid #E9A23B;
    border-radius: 16px;
    overflow: hidden;
    padding: 0 0 2.25rem;
    text-decoration: none;
    background: #fff;
    transition: box-shadow 0.2s ease;
  }
  .samples-cta-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.08); }
  .samples-cta-card__icon {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
    margin-bottom: 1.5rem;
    -webkit-mask-image: linear-gradient(to bottom, #000 75%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 75%, transparent 100%);
  }
  .samples-cta-card p { color: #1B2A4A; font-size: 1.05rem; font-weight: 600; margin: 0 1.5rem 1.5rem; line-height: 1.4; }
  .samples-cta-highlight { color: #2563EB; }
  .samples-cta-btn {
    background: #E9782E;
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.7rem 2rem;
    border-radius: 8px;
  }

  .load-more-wrap { text-align: center; margin-top: 1rem; }
  .load-more-btn {
    background: #eef2f7;
    color: #1B2A4A;
    border: none;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.75rem 2.5rem;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .load-more-btn:hover { background: #dde5ef; }
    .browse-all-wrap { text-align: center; margin-top: 1rem; }
  .browse-all-btn {
    display: inline-block;
    background: #5B6EE8;
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.7rem 2.5rem;
    border-radius: 8px;
    text-decoration: none;
  }
  .browse-all-btn:hover { background: #4a5cd6; }

  @media (max-width: 900px) {
    .featured-post { grid-template-columns: 1fr; }
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .blog-grid { grid-template-columns: 1fr; }
  }

    .breadcrumb {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 1rem;
  }
  .breadcrumb a { color: #94a3b8; text-decoration: none; }
  .breadcrumb a:hover { color: #1B2A4A; }

  .blog-hero-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    text-align: left;
    padding: 0.5rem 0 2rem;
  }
  .blog-hero-header p { max-width: none; margin: 0; }

  .category-tabs-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #EEF1FB;
    border-radius: 8px;
    padding: 0 1rem;
    margin-bottom: 2rem;
  }
  .category-tabs-band .category-tabs {
    border-bottom: none;
    margin-bottom: 0;
    padding: 0.6rem 0;
  }
  .search-in-blog {
    flex-shrink: 0;
    color: #475569;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    padding-left: 1rem;
  }
  .search-in-blog:hover { color: #1B2A4A; }

  @media (max-width: 700px) {
    .blog-hero-header { grid-template-columns: 1fr; text-align: center; }
  }
    .hero-inline-link { color: #2563EB; text-decoration: underline; }
  .hero-inline-link:hover { color: #1d4ed8; }
    .breadcrumb { display: flex; align-items: center; gap: 0.4rem; }
  .breadcrumb-home { display: inline-flex; align-items: center; }
</style>