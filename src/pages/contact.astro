---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with ThesisArcPro support — we're here to help with any questions about your order or account."
  url="https://thesisarcpro.github.io/contact">
  <Header />

  <main>
    <section class="contact-section">
      <div class="container contact-inner">
        <div class="contact-card">
          <h1>Get in touch</h1>
          <p class="contact-sub">Have a question about an order, your account, or something else? Reach out and we'll get back to you as soon as possible.</p>

          <div class="contact-methods">
            <a href="mailto:support@thesisarcpro.com" class="contact-method">
              <span class="method-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"/><path d="M3 7l9 6l9 -6"/></svg></span>
              <div>
                <span class="method-label">Email us</span>
                <span class="method-value">support@thesisarcpro.com</span>
              </div>
            </a>
            <button type="button" class="contact-method" id="openChatBtn">
              <span class="method-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 11v.01"/><path d="M8 11v.01"/><path d="M16 11v.01"/><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3l12 0"/></svg></span>
              <div>
                <span class="method-label">Live chat</span>
                <span class="method-value">Chat with our support team</span>
              </div>
            </button>
          </div>

          <p class="contact-order-note">Looking to place an order instead? <a href="/order/">Start here →</a></p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
.contact-section { background: #DAE2F9; padding: 10rem 0 5rem; min-height: 70vh; }
.contact-inner { display: flex; justify-content: center; }
.contact-card { background: var(--white); border-radius: 16px; padding: 3rem; box-shadow: 0 4px 24px rgba(0,0,0,0.08); width: 100%; max-width: 560px; text-align: center; }
.contact-card h1 { color: var(--navy); font-size: 1.9rem; margin-bottom: 0.6rem; }
.contact-sub { color: var(--text-mid); font-size: 0.98rem; line-height: 1.6; margin-bottom: 2rem; }
.contact-methods { display: flex; flex-direction: column; gap: 0.8rem; margin-bottom: 1.6rem; }
.contact-method {
  display: flex; align-items: center; gap: 0.9rem; text-align: left;
  background: var(--off-white); border: 1.5px solid var(--border); border-radius: 12px;
  padding: 1rem 1.2rem; text-decoration: none; cursor: pointer; font-family: inherit;
  transition: border-color 0.2s ease;
}
.contact-method:hover { border-color: var(--gold); }
.method-icon { flex-shrink: 0; color: var(--gold); display: flex; align-items: center; }
.method-label { display: block; color: var(--navy); font-weight: 700; font-size: 0.92rem; }
.method-value { display: block; color: var(--text-mid); font-size: 0.85rem; margin-top: 0.15rem; }
.contact-order-note { color: var(--text-mid); font-size: 0.9rem; }
.contact-order-note a { color: var(--gold); font-weight: 600; text-decoration: none; }
</style>

<script>
  document.getElementById('openChatBtn')?.addEventListener('click', () => {
    if ((window as any).tidioChatApi) { (window as any).tidioChatApi.open(); }
    else { alert('Chat is loading — please try again in a moment.'); }
  });
</script>