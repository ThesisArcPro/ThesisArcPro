      `${SUPABASE_URL}/rest/v1/writers?id=eq.${writerId}&select=id,full_name,photo_url,bio,specialties,credentials,highlights,sample_url,sample_name,years_experience,education_level,rating,orders_completed,auth_user_id`,
      { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
