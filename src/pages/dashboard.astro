  /* ── STACKED WIZARD ── */
.wiz-stack-step{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:18px 20px;margin-bottom:10px;transition:opacity .22s;}
.wiz-stack-step.s-done{opacity:.55;}
.wiz-s-title{font-size:13px;font-weight:600;color:#0f172a;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.wiz-s-check{width:17px;height:17px;border-radius:50%;background:#4ade80;display:none;align-items:center;justify-content:center;font-size:9px;color:#0f172a;font-weight:700;flex-shrink:0;}
.wiz-stack-step.s-done .wiz-s-check{display:inline-flex;}
.s-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:2px;}
.s-chip{padding:8px 14px;border:1px solid #e2e8f0;border-radius:8px;font-size:12.5px;color:#64748b;cursor:pointer;background:#f8fafc;transition:all .12s;user-select:none;font-family:inherit;}
