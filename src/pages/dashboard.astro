async function refreshLiveBids(orderId: string) {
  try {
    const bRes = await fetch(`${SUPABASE_URL}/rest/v1/bids?order_id=eq.${orderId}&select=id,bid_price,note,writer_id,created_at,status&order=created_at.desc`, {
      headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` }
    });
    const bids = await bRes.json();
    if (!Array.isArray(bids)) return;
    const box = document.getElementById('wizLiveBids');
    const waiting = document.getElementById('wizBidsWaiting');
    const countEl = document.getElementById('wizBidCount');
    if (!box) return;
    const existingIds = new Set(Array.from(box.querySelectorAll('[data-wbid]')).map(el => (el as HTMLElement).dataset.wbid));
    const missing = bids.filter((b: any) => !existingIds.has(String(b.id)));
    if (missing.length) {
      if (waiting) waiting.style.display = 'none';
      const enriched = await enrichBidsWithWriters(missing);
      enriched.forEach((b: any) => box.insertAdjacentHTML('afterbegin', wizRenderBidCard(b, orderId)));
      attachWizHireBtns(box, orderId);
    }
    if (countEl) countEl.textContent = String(box.querySelectorAll('[data-wbid]').length);
  } catch (e) { console.error('refreshLiveBids error', e); }
}

