async function enrichBidsWithWriters(bids: any[]): Promise<any[]> {
  const writerIds = [...new Set(bids.map(b => b.writer_id))];
  const res = await fetch(
    `${SUPABASE_URL}/rest/v1/writers?id=in.(${writerIds.join(',')})&select=id,full_name,photo_url,bio,specialties,credentials,highlights,sample_url,sample_name,years_experience,education_level,rating,orders_completed,auth_user_id`,
    { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
  );
  const writers = await res.json();
  return bids.map(b => ({ ...b, writer: writers.find((w: any) => w.id === b.writer_id) || {} }));
}

