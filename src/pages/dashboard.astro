.s-next-wrap{display:flex;overflow:hidden;border-radius:8px;width:fit-content;margin-top:14px;}
.s-next-btn{background:#046fcd;color:#fff;border:none;padding:10px 22px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;}
.s-next-btn:hover{background:#0361b3;}
.s-counter-row{display:flex;align-items:center;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;width:fit-content;}
.s-counter-row button{width:36px;height:36px;background:#fff;border:none;border-right:1px solid #e2e8f0;color:#64748b;font-size:17px;cursor:pointer;}
