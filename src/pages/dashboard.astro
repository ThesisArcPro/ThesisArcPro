let wizBidChatSub: any = null;
let wizBidChatConvId: string | null = null;

async function openBidChat(writerId: string, writerName: string, writerPhoto: string, writerAuthId: string, orderDbId: string, bidNote: string) {
  const chatPanel = document.getElementById('wizBidChatPanel')!;
  const infoCard = document.getElementById('wizInfoCard');
  const priceCard = document.getElementById('wizPriceCard');
  if (infoCard) infoCard.style.display = 'none';
  if (priceCard) priceCard.style.display = 'none';
  chatPanel.style.display = 'flex';
  const nameEl = document.getElementById('wizBidChatName')!;
  const avatarEl = document.getElementById('wizBidChatAvatar')!;
  nameEl.textContent = writerName;
  const initials = writerName.split(' ').map((n: string) => n[0]).join('').slice(0, 2).toUpperCase();
  avatarEl.innerHTML = writerPhoto ? `<img src="${esc(writerPhoto)}" style="width:100%;height:100%;object-fit:cover;" />` : initials;
  const msgs = document.getElementById('wizBidChatMessages')!;
  msgs.innerHTML = '<div style="text-align:center;color:#94a3b8;font-size:0.78rem;padding:1rem;">Loading…</div>';
  if (wizBidChatSub) { wizBidChatSub.unsubscribe(); wizBidChatSub = null; }
  wizBidChatConvId = null;
  try {
    let convId: string | null = null;
    if (writerAuthId) {
      const pRes = await fetch(
        `${SUPABASE_URL}/rest/v1/conversation_participants?user_id=eq.${writerAuthId}&select=conversation_id,conversations(id,order_id,type)`,
        { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
      );
      const parts = await pRes.json();
      const match = parts.find((p: any) => p.conversations?.order_id === parseInt(orderDbId) && p.conversations?.type === 'order');
      if (match) convId = match.conversation_id;
    }
    if (!convId) {
      const cRes = await fetch(`${SUPABASE_URL}/rest/v1/conversations`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=representation' },
        body: JSON.stringify({ type: 'order', order_id: parseInt(orderDbId), title: `Order chat with ${writerName}` })
      });
      convId = (await cRes.json())[0]?.id;
      if (!convId) throw new Error('Could not create conversation');
      await fetch(`${SUPABASE_URL}/rest/v1/conversation_participants`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ conversation_id: convId, user_id: currentSession.user.id, role: 'client', display_name: currentSession.user.email?.split('@')[0] || 'Client' })
      });
      // Add this specific writer as participant — isolates conversation from other writers
      if (writerAuthId && writerAuthId !== '00000000-0000-0000-0000-000000000000') {
        await fetch(`${SUPABASE_URL}/rest/v1/conversation_participants`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
          body: JSON.stringify({ conversation_id: convId, user_id: writerAuthId, role: 'writer', display_name: writerName })
        });
      }
      if (bidNote) {
        const senderId = writerAuthId || '00000000-0000-0000-0000-000000000000';
        await fetch(`${SUPABASE_URL}/rest/v1/messages`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
          body: JSON.stringify({ conversation_id: convId, sender_id: senderId, sender_name: writerName, sender_role: 'writer', content: bidNote })
        });
      }
    }
    wizBidChatConvId = convId;
    const mRes = await fetch(
      `${SUPABASE_URL}/rest/v1/messages?conversation_id=eq.${convId}&order=created_at.asc`,
      { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
    );
    renderWizBidMessages(await mRes.json());
    wizBidChatSub = supabase.channel(`wiz-bid-chat-${convId}`)
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages', filter: `conversation_id=eq.${convId}` },
        (payload: any) => appendWizBidMessage(payload.new)).subscribe();
  } catch(e) {
    console.error('openBidChat error', e);
    msgs.innerHTML = '<div style="text-align:center;color:#f87171;font-size:0.78rem;padding:1rem;">Could not load chat.</div>';
  }
}

function renderWizBidMessages(messages: any[]) {
  const c = document.getElementById('wizBidChatMessages')!;
  if (!messages.length) { c.innerHTML = '<div style="text-align:center;color:#94a3b8;font-size:0.78rem;padding:1rem;">No messages yet.</div>'; return; }
  c.innerHTML = messages.map((m: any) => wizBidChatBubble(m)).join('');
  c.scrollTop = c.scrollHeight;
}

function appendWizBidMessage(m: any) {
  const c = document.getElementById('wizBidChatMessages')!;
  const ph = c.querySelector('div[style*="padding:1rem"]'); if (ph) c.innerHTML = '';
  c.insertAdjacentHTML('beforeend', wizBidChatBubble(m));
  c.scrollTop = c.scrollHeight;
}

function wizBidChatBubble(m: any) {
  const mine = m.sender_id === currentSession.user.id;
  const time = m.created_at ? new Date(m.created_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '';
  return `<div style="display:flex;flex-direction:column;max-width:80%;align-self:${mine ? 'flex-end' : 'flex-start'};align-items:${mine ? 'flex-end' : 'flex-start'};">
    ${!mine ? `<div style="font-size:0.62rem;font-weight:600;color:#94a3b8;margin-bottom:0.1rem;">${esc(m.sender_name || 'Writer')}</div>` : ''}
    <div style="padding:0.5rem 0.8rem;border-radius:12px;font-size:0.8rem;line-height:1.5;word-wrap:break-word;background:${mine ? '#046fcd' : '#fff'};color:${mine ? '#fff' : '#0f172a'};border:${mine ? 'none' : '1px solid #e2e8f0'};border-bottom-${mine ? 'right' : 'left'}-radius:3px;">${esc(m.content)}</div>
    <div style="font-size:0.6rem;color:#94a3b8;margin-top:0.1rem;">${time}</div>
  </div>`;
}

async function wizBidChatSendMessage() {
  if (!wizBidChatConvId) return;
  const input = document.getElementById('wizBidChatInput') as HTMLInputElement;
  const text = input.value.trim();
  if (!text) return;
  const btn = document.getElementById('wizBidChatSend') as HTMLButtonElement;
  btn.disabled = true; input.value = '';
  const clientName = myClientId ? `#${myClientId}` : currentSession.user.email?.split('@')[0] || 'Client';
  try {
    await fetch(`${SUPABASE_URL}/rest/v1/messages`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
      body: JSON.stringify({ conversation_id: wizBidChatConvId, sender_id: currentSession.user.id, sender_name: clientName, sender_role: 'client', content: text })
    });
    await fetch(`${SUPABASE_URL}/rest/v1/conversations?id=eq.${wizBidChatConvId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=minimal' },
      body: JSON.stringify({ updated_at: new Date().toISOString() })
    });
  } catch(e) { console.error(e); alert('Could not send message.'); }
  btn.disabled = false; input.focus();
}

