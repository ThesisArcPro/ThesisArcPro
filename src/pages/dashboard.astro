async function loadChatsPanel() {
  const box = document.getElementById('convListItems')!;
  box.innerHTML = '<div style="padding:2rem;text-align:center;color:#94a3b8;font-size:0.85rem;">Loading…</div>';
  try {
    const pRes = await fetch(
      `${SUPABASE_URL}/rest/v1/conversation_participants?user_id=eq.${currentSession.user.id}&select=conversation_id,conversations(id,title,order_id,updated_at,orders(id,topic,order_status,order_number,assignment_type,pages,deadline,created_at,instructions,education_level,subject,language,service,amount_paid,total_amount,payment_status))`,
      { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` } }
    );
    const parts = await pRes.json();
    if (!parts.length) {
      box.innerHTML = '<div style="padding:2rem;text-align:center;color:#94a3b8;font-size:0.85rem;">No conversations yet.</div>';
      return;
    }
    const convs = parts.map((p: any) => ({ ...p.conversations, order: p.conversations?.orders })).filter(Boolean);
    convs.sort((a: any, b: any) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime());
    const convIds = convs.map((c: any) => c.id);
    let lastMessages: Record<string, any> = {};
    try {
      const mRes = await fetch(
        `${SUPABASE_URL}/rest/v1/messages?conversation_id=in.(${convIds.map((id: string) => `"${id}"`).join(',')})&select=conversation_id,content,sender_id,created_at,read_by&order=created_at.desc&limit=200`,
        { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` } }
      );
      const msgs = await mRes.json();
      msgs.forEach((m: any) => { if (!lastMessages[m.conversation_id]) lastMessages[m.conversation_id] = m; });
    } catch(e) { console.error(e); }
    box.innerHTML = convs.map((c: any) => {
      const status = c.order?.order_status || 'open';
      const statusColor = status === 'in_review' ? '#3b82f6' : status === 'completed' ? '#22c55e' : status === 'in_progress' ? '#f59e0b' : '#94a3b8';
      const title = c.order?.topic || c.title || 'Conversation';
      const time = c.updated_at ? new Date(c.updated_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '';
      const lm = lastMessages[c.id];
      const isMine = lm?.sender_id === currentSession.user.id;
      const preview = lm ? (isMine ? 'You: ' : '') + lm.content.slice(0, 40) : 'No messages yet';
      const seen = lm && Array.isArray(lm.read_by) && lm.read_by.some((id: string) => id !== currentSession.user.id);
      const tick = lm && isMine ? (seen ? ' <span style="color:#60a5fa;font-size:0.7rem;">✓✓</span>' : ' <span style="color:#94a3b8;font-size:0.7rem;">✓</span>') : '';
      const unread = lm && !isMine && Array.isArray(lm.read_by) && !lm.read_by.includes(currentSession.user.id);
      return `<div class="cp-conv-item" data-conv-id="${esc(c.id)}" data-order-id="${esc(c.order?.id || '')}" style="padding:0.85rem 1.1rem;border-bottom:1px solid #f1f5f9;cursor:pointer;transition:background 0.15s;background:${unread ? '#f0f7ff' : 'transparent'};">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.3rem;">
          <div style="display:flex;align-items:center;gap:0.4rem;min-width:0;flex:1;">
            <span style="font-size:0.7rem;font-weight:700;color:${statusColor};white-space:nowrap;">${esc(status.replace(/_/g,' '))}</span>
            <span style="font-size:0.83rem;color:#303b4f;font-weight:${unread ? '700' : '500'};white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(title)}</span>
          </div>
          <span style="font-size:0.7rem;color:#94a3b8;flex-shrink:0;margin-left:0.5rem;">${time}</span>
        </div>
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <div style="width:20px;height:20px;border-radius:50%;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-size:0.65rem;flex-shrink:0;">👤</div>
          <span style="font-size:0.76rem;color:${unread ? '#0f172a' : '#94a3b8'};font-weight:${unread ? '600' : '400'};white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;">${esc(preview)}${tick}</span>
          ${unread ? '<span style="width:8px;height:8px;border-radius:50%;background:#046fcd;flex-shrink:0;"></span>' : ''}
        </div>
      </div>`;
    }).join('');
    box.querySelectorAll('.cp-conv-item').forEach(item => {
      item.addEventListener('mouseenter', () => { if (!(item as HTMLElement).classList.contains('active')) (item as HTMLElement).style.background = '#f8fafc'; });
      item.addEventListener('mouseleave', () => { if (!(item as HTMLElement).classList.contains('active')) (item as HTMLElement).style.background = ''; });
      item.addEventListener('click', () => {
        box.querySelectorAll('.cp-conv-item').forEach(i => { i.classList.remove('active'); (i as HTMLElement).style.background = ''; });
        item.classList.add('active');
        (item as HTMLElement).style.background = '#eef6fb';
        const convId = (item as HTMLElement).dataset.convId!;
        const conv = convs.find((c: any) => c.id === convId);
        cpCurrentOrder = conv?.order || null;
        openCpThread(convId, conv?.order?.topic || conv?.title || 'Chat', conv?.order?.order_status || '');
      });
    });
  } catch (err) { console.error(err); box.innerHTML = '<div style="padding:2rem;text-align:center;color:#f87171;font-size:0.85rem;">Could not load conversations.</div>'; }
}

async function openCpThread(convId: string, title: string, status: string) {
  cpConvId = convId;
  if (cpSub) { cpSub.unsubscribe(); cpSub = null; }
  document.getElementById('convThreadEmpty')!.style.display = 'none';
  const active = document.getElementById('convThreadActive')!;
  active.style.display = 'flex';
  const initials = title.split(' ').slice(0, 2).map((w: string) => w[0] || '').join('').toUpperCase();
  const avatarEl = document.getElementById('convThreadAvatar')!;
  avatarEl.textContent = initials;
  document.getElementById('convThreadTitle')!.textContent = title;
  const now = new Date();
  document.getElementById('convThreadTime')!.innerHTML = `${now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })} 🇺🇸<br><span style="font-size:0.65rem;color:#94a3b8;">Local time</span>`;
  const msgs = document.getElementById('convThreadMessages')!;
  msgs.innerHTML = '<div style="text-align:center;color:#94a3b8;font-size:0.85rem;margin:auto;">Loading…</div>';
  try {
    const res = await fetch(
      `${SUPABASE_URL}/rest/v1/messages?conversation_id=eq.${convId}&order=created_at.asc`,
      { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` } }
    );
    renderCpMessages(await res.json());
    await markMessagesRead(convId);
    cpSub = supabase.channel(`cp-${convId}`)
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages', filter: `conversation_id=eq.${convId}` },
        (payload: any) => appendCpMessage(payload.new))
      .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'messages', filter: `conversation_id=eq.${convId}` },
        (payload: any) => {
          const updated = payload.new;
          const row = document.querySelector(`#convThreadMessages [data-msg-id="${updated.id}"]`);
          if (!row) return;
          const tick = row.querySelector('.msg-tick');
          if (!tick) return;
          const seen = Array.isArray(updated.read_by) && updated.read_by.some((id: string) => id !== currentSession.user.id);
          tick.innerHTML = seen ? '✓✓' : '✓';
          (tick as HTMLElement).style.color = seen ? '#60a5fa' : '#94a3b8';
        })
      .subscribe();
  } catch (err) { msgs.innerHTML = '<div style="text-align:center;color:#f87171;font-size:0.85rem;margin:auto;">Could not load messages.</div>'; }
}

function renderCpMessages(messages: any[]) {
  const c = document.getElementById('convThreadMessages')!;
  if (!messages.length) { c.innerHTML = '<div style="text-align:center;color:#94a3b8;font-size:0.85rem;margin:auto;">No messages yet. Say hello!</div>'; return; }
  let lastDate = '';
  c.innerHTML = messages.map((m: any) => {
    const mine = m.sender_id === currentSession.user.id;
    const time = new Date(m.created_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
    const dateLabel = new Date(m.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    let dayHtml = '';
    if (dateLabel !== lastDate) { lastDate = dateLabel; dayHtml = `<div style="text-align:center;font-size:0.72rem;color:#94a3b8;margin:0.5rem 0;">${dateLabel}</div>`; }
    const seen = Array.isArray(m.read_by) && m.read_by.some((id: string) => id !== currentSession.user.id);
    const tick = mine ? `<span class="msg-tick" style="color:${seen ? '#60a5fa' : '#94a3b8'};font-size:0.7rem;">${seen ? '✓✓' : '✓'}</span>` : '';
    return `${dayHtml}<div data-msg-id="${esc(m.id)}" style="display:flex;flex-direction:column;max-width:72%;align-self:${mine ? 'flex-end' : 'flex-start'};align-items:${mine ? 'flex-end' : 'flex-start'};">
      ${!mine ? `<div style="font-size:0.66rem;font-weight:600;color:#94a3b8;margin-bottom:0.15rem;">${esc(m.sender_name || 'Writer')}</div>` : ''}
      <div style="padding:0.55rem 0.85rem;border-radius:14px;font-size:0.85rem;line-height:1.5;word-wrap:break-word;background:${mine ? '#046fcd' : '#fff'};color:${mine ? '#fff' : '#0f172a'};border:${mine ? 'none' : '1px solid #e2e8f0'};border-bottom-${mine ? 'right' : 'left'}-radius:4px;">${esc(m.content)}</div>
      <div style="font-size:0.6rem;color:#94a3b8;margin-top:0.15rem;">${time} ${tick}</div>
    </div>`;
  }).join('');
  c.scrollTop = c.scrollHeight;
}

function appendCpMessage(m: any) {
  const c = document.getElementById('convThreadMessages')!;
  const ph = c.querySelector('div[style*="margin:auto"]'); if (ph) c.innerHTML = '';
  const mine = m.sender_id === currentSession.user.id;
  const time = new Date(m.created_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
  const tick = mine ? `<span class="msg-tick" style="color:#94a3b8;font-size:0.7rem;">✓</span>` : '';
  c.insertAdjacentHTML('beforeend', `<div data-msg-id="${esc(m.id)}" style="display:flex;flex-direction:column;max-width:72%;align-self:${mine ? 'flex-end' : 'flex-start'};align-items:${mine ? 'flex-end' : 'flex-start'};">
    ${!mine ? `<div style="font-size:0.66rem;font-weight:600;color:#94a3b8;margin-bottom:0.15rem;">${esc(m.sender_name || 'Writer')}</div>` : ''}
    <div style="padding:0.55rem 0.85rem;border-radius:14px;font-size:0.85rem;line-height:1.5;word-wrap:break-word;background:${mine ? '#046fcd' : '#fff'};color:${mine ? '#fff' : '#0f172a'};border:${mine ? 'none' : '1px solid #e2e8f0'};border-bottom-${mine ? 'right' : 'left'}-radius:4px;">${esc(m.content)}</div>
    <div style="font-size:0.6rem;color:#94a3b8;margin-top:0.15rem;">${time} ${tick}</div>
  </div>`);
  c.scrollTop = c.scrollHeight;
  if (!mine && cpConvId) markMessagesRead(cpConvId);
}

async function cpSendMessage() {
  if (!cpConvId) return;
  const input = document.getElementById('convThreadInput') as HTMLInputElement;
  const text = input.value.trim();
  if (!text) return;
  const btn = document.getElementById('convThreadSend') as HTMLButtonElement;
  btn.disabled = true; input.value = '';
  const clientName = myClientId ? `#${myClientId}` : currentSession.user.email?.split('@')[0] || 'Client';
  try {
    await fetch(`${SUPABASE_URL}/rest/v1/messages`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` },
      body: JSON.stringify({ conversation_id: cpConvId, sender_id: currentSession.user.id, sender_name: clientName, sender_role: 'client', content: text })
    });
    await fetch(`${SUPABASE_URL}/rest/v1/conversations?id=eq.${cpConvId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}`, 'Prefer': 'return=minimal' },
      body: JSON.stringify({ updated_at: new Date().toISOString() })
    });
  } catch (err) { console.error(err); alert('Could not send message.'); }
  btn.disabled = false; input.focus();
}

document.getElementById('convThreadSend')!.addEventListener('click', cpSendMessage);
document.getElementById('convThreadInput')!.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); cpSendMessage(); } });
document.getElementById('convViewOrderBtn')!.addEventListener('click', () => { if (cpCurrentOrder) showModal(cpCurrentOrder); });
