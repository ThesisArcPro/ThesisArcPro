  async function loadWalletTransactions() {
    const box = document.getElementById('walletTxnList')!;
    box.innerHTML = '<div style="text-align:center;color:#5B6270;padding:2rem;">Loading…</div>';
    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/wallet_transactions?user_id=eq.${currentSession.user.id}&select=*&order=created_at.desc&limit=50`,
        { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
      );
      const txns = await res.json();
      if (!Array.isArray(txns) || !txns.length) {
        box.innerHTML = `<div style="text-align:center;color:#5B6270;padding:3rem 1rem;">
          <div style="font-size:0.95rem;font-weight:600;color:#9CA1AC;margin-bottom:0.3rem;">You haven't made any transactions</div>
          <div style="font-size:0.82rem;">Depositing funds, paying for an order, and other transactions will appear here.</div>
        </div>`;
        return;
      }
      const typeLabel: Record<string, string> = { deposit: 'Deposit', hold: 'Order payment', release: 'Released to writer', refund: 'Refund', adjustment: 'Adjustment' };
      const typeColor: Record<string, string> = { deposit: '#4ade80', hold: '#f87171', release: '#94a3b8', refund: '#60a5fa', adjustment: '#fbbf24' };
      box.innerHTML = txns.map((t: any) => {
        const amt = Number(t.amount);
        const sign = amt >= 0 ? '+' : '';
        const date = t.created_at ? new Date(t.created_at).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
        return `<div style="display:flex;align-items:center;justify-content:space-between;background:#181B22;border:1px solid #23262E;border-radius:10px;padding:0.9rem 1.1rem;">
          <div>
            <div style="font-size:0.86rem;font-weight:600;color:#E7E9EE;">${typeLabel[t.type] || t.type}</div>
            <div style="font-size:0.74rem;color:#5B6270;margin-top:0.2rem;">${date}${t.note ? ' · ' + esc(t.note) : ''}</div>
          </div>
          <div style="font-size:0.95rem;font-weight:700;color:${typeColor[t.type] || '#9CA1AC'};">${sign}$${Math.abs(amt).toFixed(2)}</div>
        </div>`;
      }).join('');
    } catch (e) {
      console.error('loadWalletTransactions error', e);
      box.innerHTML = '<div style="text-align:center;color:#f87171;padding:2rem;">Could not load transactions.</div>';
    }
  }

  const notifTypes = ['Billing', 'Orders', 'Chat'];
  const notifChannels = ['email', 'sms', 'push', 'popup', 'inapp', 'sounds'];
  const notifDefaults: Record<string, boolean> = { email: true, sms: false, push: true, popup: true, inapp: true, sounds: true };

  function renderNotifRows() {
    const box = document.getElementById('acctNotifRows')!;
    box.innerHTML = notifTypes.map(type => {
      const cells = notifChannels.map(ch => {
        const checked = notifDefaults[ch];
        return `<td style="text-align:center;padding:0.7rem 0.5rem;">
          <label style="position:relative;display:inline-block;width:34px;height:19px;">
            <input type="checkbox" data-notif="${type}-${ch}" ${checked ? 'checked' : ''} style="opacity:0;width:0;height:0;" />
            <span style="position:absolute;inset:0;background:${checked ? '#6366f1' : '#334155'};border-radius:20px;transition:0.15s;"></span>
            <span style="position:absolute;top:2px;${checked ? 'right:2px' : 'left:2px'};width:15px;height:15px;background:#fff;border-radius:50%;transition:0.15s;"></span>
          </label>
        </td>`;
      }).join('');
      return `<tr style="border-bottom:1px solid #1e2536;"><td style="padding:0.7rem 0.5rem;color:#E7E9EE;font-size:0.86rem;font-weight:600;">${type}</td>${cells}</tr>`;
    }).join('');
    box.querySelectorAll('input[type="checkbox"]').forEach(cb => {
      cb.addEventListener('change', (e) => {
        const input = e.target as HTMLInputElement;
        const track = input.nextElementSibling as HTMLElement;
        const knob = track?.nextElementSibling as HTMLElement;
        if (track) track.style.background = input.checked ? '#6366f1' : '#334155';
        if (knob) { knob.style.right = input.checked ? '2px' : ''; knob.style.left = input.checked ? '' : '2px'; }
      });
    });
  }

