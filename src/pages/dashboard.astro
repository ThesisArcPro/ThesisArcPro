function resetWizard() {
  wizStep = 1;
  wizState.service = ''; wizState.serviceBase = 0;
  Object.keys(wizAddons).forEach(k => wizAddons[k] = 0);
  ['graphics','psources','abstract'].forEach(k => {
    const el = document.getElementById(`wiz-${k}-qty`); if (el) el.textContent = '0';
  });
  (['wizTopic','wizType','wizSubject','wizInstructions','wizSources'] as string[]).forEach(id => {
    const el = document.getElementById(id) as HTMLInputElement; if (el) el.value = '';
  });
  (['wizLanguage','wizCitation','wizLevel','wizDeadline'] as string[]).forEach(id => {
    const el = document.getElementById(id) as HTMLSelectElement | HTMLInputElement; if (el) el.value = '';
  });
  const pages = document.getElementById('wizPages') as HTMLInputElement; if (pages) pages.value = '1';
  document.querySelectorAll('.wiz-svc-card').forEach(c => c.classList.remove('wiz-svc-selected'));
  const next1 = document.getElementById('wizNext1') as HTMLButtonElement;
  if (next1) { next1.disabled = true; next1.style.opacity = '0.45'; }
