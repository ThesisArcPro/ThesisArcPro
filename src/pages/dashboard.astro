  const socket = io(BIDDING_SERVER, { transports: ['websocket'], reconnection: true, reconnectionDelay: 1000, reconnectionAttempts: Infinity });
 
  socket.on('connect', () => {
    console.log('Connected to bidding server:', socket.id);
    // Re-join the pending order's bid room and re-sync any bids placed while we were
    // disconnected — this is the fix for "writer bids but client only sees it after refresh".
    const pendingId = wizCurrentOrderDbId || localStorage.getItem('wizPendingOrderId');
    if (pendingId) {
      socket.emit('bid:join', pendingId);
      refreshLiveBids(pendingId);
    }
  });
  socket.on('disconnect', () => console.log('Disconnected from bidding server'));
 
  const base = '';
  const SUPABASE_URL = 'https://rehvwvujuamehoanfomj.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_CKxnbue4T6cVn9BOIg8BkQ_kBNBiM_h';
 
