  async function openHirePaymentModal(bidId: string, writerId: string, bidPrice: number, orderId: string) {
    hireBidId = bidId; hireWriterId = writerId; hireOrderId = orderId; hireBidPrice = bidPrice;
    const isDeposit = bidPrice >= 30;
    const amountNow = isDeposit ? bidPrice * 0.5 : bidPrice;
    const pd = document.getElementById('hirePaymentDetails');
    if (pd) pd.innerHTML = `
      <p style="font-size:0.9rem;color:#64748b;margin:0 0 0.4rem;">Writer's Bid</p>
      <p style="font-size:1.7rem;color:#0f172a;font-weight:800;margin:0 0 0.3rem;">$${bidPrice.toFixed(2)}</p>
      <p style="font-size:0.9rem;color:#64748b;margin:0 0 0.3rem;">Pay Now</p>
      <p style="font-size:1.9rem;color:#c5a059;font-weight:800;margin:0;">$${amountNow.toFixed(2)}</p>`;
    const pp = document.getElementById('hirePaymentPolicy');
    if (pp) pp.textContent = isDeposit
      ? `50% deposit now. Remaining $${(bidPrice * 0.5).toFixed(2)} due on delivery.`
      : 'Full payment required for orders under $30.';

    await refreshWalletBalance();
    const balDisplay = document.getElementById('hireWalletBalanceDisplay');
    if (balDisplay) balDisplay.textContent = `$${walletBalance.toFixed(2)}`;

    const insufficientMsg = document.getElementById('hireInsufficientMsg')!;
    const addFundsFirstBtn = document.getElementById('hireAddFundsFirstBtn') as HTMLButtonElement;
    const confirmBtn = document.getElementById('hireConfirmBtn') as HTMLButtonElement;
    const msg = document.getElementById('hirePaymentMsg')!;
    msg.textContent = '';

    if (walletBalance >= amountNow) {
      insufficientMsg.style.display = 'none';
      addFundsFirstBtn.style.display = 'none';
      confirmBtn.style.display = 'block';
      confirmBtn.disabled = false;
      confirmBtn.style.opacity = '1';
      confirmBtn.textContent = `✅ Pay $${amountNow.toFixed(2)} from Wallet — Hire Writer`;
    } else {
      insufficientMsg.style.display = 'block';
      addFundsFirstBtn.style.display = 'block';
      confirmBtn.style.display = 'none';
    }

    document.getElementById('hirePaymentModal')!.classList.add('open');
  }

