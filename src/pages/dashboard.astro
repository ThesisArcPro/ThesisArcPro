    const isDeposit = hireBidPrice >= 30;
    const amountNow = isDeposit ? hireBidPrice * 0.5 : hireBidPrice;

    btn.textContent = '⏳ Processing...'; btn.disabled = true;
    try {
      const walletRes = await fetch(`${SUPABASE_URL}/rest/v1/rpc/hire_writer_from_wallet`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ p_user_id: currentSession.user.id, p_order_id: parseInt(hireOrderId), p_writer_id: parseInt(hireWriterId), p_amount: amountNow })
      });
      if (!walletRes.ok) {
        const errBody = await walletRes.json().catch(() => ({}));
        throw new Error(errBody.message || 'Could not charge wallet');
      }

      await fetch(`${SUPABASE_URL}/rest/v1/bids?id=eq.${hireBidId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=minimal' },
        body: JSON.stringify({ status: 'accepted' })
      });
      await fetch(`${SUPABASE_URL}/rest/v1/bids?order_id=eq.${hireOrderId}&id=neq.${hireBidId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=minimal' },
        body: JSON.stringify({ status: 'rejected' })
      });
      const orderObj = allOrders.find((o: any) => String(o.id) === hireOrderId);
      const orderNumber = orderObj?.order_number;
      await fetch(`${SUPABASE_URL}/rest/v1/orders?id=eq.${hireOrderId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=minimal' },
        body: JSON.stringify({ order_status: 'in_progress', status_updated_at: new Date().toISOString() })
      });
      await fetch(`${SUPABASE_URL}/rest/v1/orders?order_number=eq.${orderNumber}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=minimal' },
        body: JSON.stringify({ writer_id: parseInt(hireWriterId), amount_paid: amountNow, payment_status: isDeposit ? '50% Deposit Paid' : 'Paid in Full' })
      });

      socket.emit('bid:accept', { bidId: hireBidId, orderId: hireOrderId, writerId: hireWriterId });
      localStorage.removeItem('wizPendingOrderId');
      await refreshWalletBalance();
      document.getElementById('hirePaymentModal')!.classList.remove('open');
      closeModal();
      closeOrderModal();
      await loadOrders(currentSession);
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      document.getElementById('myOrdersLink')!.classList.add('active');
      document.getElementById('chatsPanelWrap')!.style.display = 'none';
      document.getElementById('draftsPanelWrap')!.style.display = 'none';
      (document.querySelector('.main-header') as HTMLElement).style.display = 'flex';
      (document.querySelector('.tabs-bar') as HTMLElement).style.display = 'flex';
      (document.querySelector('.controls-bar') as HTMLElement).style.display = 'flex';
      (document.querySelector('.orders-area') as HTMLElement).style.display = 'flex';
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      const ipTab = document.querySelector('.tab[data-tab="in_progress"]') as HTMLElement;
      if (ipTab) ipTab.classList.add('active');
      currentTab = 'in_progress';
      renderOrders();
      alert('✅ Writer hired! Your order is now in progress.');
    } catch (err: any) {
      console.error(err);
      msg.textContent = `❌ ${err.message || 'Something went wrong. Please try again.'}`;
      msg.style.color = '#dc2626';
      btn.textContent = `✅ Pay $${amountNow.toFixed(2)} from Wallet — Hire Writer`;
      btn.disabled = false;
    }
  });
  // ═══ END HIRE WRITER PAYMENT FLOW ═══
 
  function closeModal() {
    document.getElementById('detailModal')!.classList.remove('open');
  }
 
  document.getElementById('modalClose')!.addEventListener('click', closeModal);
  document.getElementById('modalOverlay')!.addEventListener('click', closeModal);
 
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentTab = (tab as HTMLElement).dataset.tab || 'in_progress';
      renderOrders();
    });
  });
 
  document.getElementById('searchInput')!.addEventListener('input', renderOrders);
 
  function loadDraftsPanel() {
  const list = document.getElementById('draftsList')!;
  const loading = document.getElementById('draftsLoadingState')!;
  loading.style.display = 'none';
  const drafts = allOrders.filter((o: any) => o.order_status === 'open_for_bids');
  if (!drafts.length) {
    list.innerHTML = `<div style="text-align:center;padding:4rem 2rem;color:#94a3b8;">
      <div style="font-size:2.5rem;margin-bottom:1rem;">📋</div>
      <div style="font-weight:600;color:#64748b;margin-bottom:0.4rem;">No drafts yet</div>
      <div style="font-size:0.83rem;">Orders waiting for writers appear here.</div>
    </div>`;
    return;
  }
  list.innerHTML = drafts.map((o: any) => {
    const dl = deadlineInfo(o.deadline);
    return `<div class="order-row" data-draft-id="${esc(o.id)}" data-draft-number="${esc(o.order_number||o.id)}">
      <div class="col-left">
        <div class="order-title">${esc(o.topic || '(no topic)')}</div>
        <div class="order-meta">
          <span class="status-badge" style="background:rgba(245,158,11,0.15);color:#f59e0b;font-size:0.72rem;font-weight:700;padding:0.18rem 0.55rem;border-radius:4px;">awaiting writers</span>
          <span class="meta-dot">·</span>
          <span>${esc(o.pages||1)} page${o.pages>1?'s':''}</span>
          <span class="meta-dot">·</span>
          <span class="order-id">ID ${esc(o.order_number||o.id)}</span>
        </div>
      </div>
      <div class="col-right">
        <div class="col-deadline ${dl.cls}">${dl.text}</div>
        <div class="col-amount">$${Number(o.total_amount||0).toFixed(2)}</div>
      </div>
    </div>`;
  }).join('');
  list.querySelectorAll('.order-row[data-draft-id]').forEach(row => {
    row.addEventListener('click', () => {
      const id = (row as HTMLElement).dataset.draftId!;
      const number = (row as HTMLElement).dataset.draftNumber!;
      openDraftOrder(id, number);
    });
  });
}

async function openDraftOrder(orderId: string, orderNumber: string) {
  openOrderModal();
  const flow = document.getElementById('wizStepsFlow'); if (flow) flow.style.display = 'none';
  const successEl = document.getElementById('wizSuccess'); if (successEl) successEl.style.display = 'block';
  wizSetChatLayout(true);
  const priceCard = document.getElementById('wizPriceCard'); if (priceCard) priceCard.style.display = 'none';
  const infoCard = document.getElementById('wizInfoCard'); if (infoCard) infoCard.style.display = 'none';
  const bar = document.getElementById('wizProgressBar'); if (bar) bar.style.display = 'none';
  const ticketEl = document.getElementById('wizSuccessTicket'); if (ticketEl) ticketEl.textContent = orderNumber;
  wizCurrentOrderDbId = orderId;
  localStorage.setItem('wizPendingOrderId', orderId);
  wizPendingBids = [];
  try {
    const bRes = await fetch(`${SUPABASE_URL}/rest/v1/bids?order_id=eq.${orderId}&select=id,bid_price,note,writer_id,created_at,status&order=created_at.desc`, {
      headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` }
    });
    const existingBids = await bRes.json();
    const waiting = document.getElementById('wizBidsWaiting');
    const box = document.getElementById('wizLiveBids');
    const countEl = document.getElementById('wizBidCount');
    if (Array.isArray(existingBids) && existingBids.length > 0) {
      if (waiting) waiting.style.display = 'none';
      if (box) {
        const enriched = await enrichBidsWithWriters(existingBids);
        box.innerHTML = enriched.map((b: any) => wizRenderBidCard(b, orderId)).join('');
        attachWizHireBtns(box, orderId);
      }
      if (countEl) countEl.textContent = String(existingBids.length);
    } else {
      if (waiting) waiting.style.display = 'block';
      if (countEl) countEl.textContent = '0';
    }
  } catch(e) { console.error('openDraftOrder error', e); }
  socket.emit('bid:join', orderId);
  socket.off('bid:new');
  socket.on('bid:new', async (bid: any) => {
    wizPendingBids.push(bid);
    const banner = document.getElementById('wizNewBidsBanner')!;
    const bannerAvatars = document.getElementById('wizBannerAvatars')!;
    const bannerText = document.getElementById('wizBannerText')!;
    const w = await fetchWriterProfile(String(bid.writer_id));
    if (w?.photo_url) bannerAvatars.insertAdjacentHTML('beforeend', `<img src="${esc(w.photo_url)}" style="width:24px;height:24px;border-radius:50%;border:2px solid #1e2536;margin-left:-6px;object-fit:cover;" />`);
    bannerText.textContent = `Show ${wizPendingBids.length} new proposal${wizPendingBids.length > 1 ? 's' : ''}`;
    banner.style.display = 'flex';
  });
}

