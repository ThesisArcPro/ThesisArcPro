    const valid = v.length >= 5;
    btn.disabled = !valid;
    btn.style.background = valid ? '#22c55e' : '#334155';
    btn.style.color = valid ? '#0f172a' : '#94a3b8';
    btn.style.cursor = valid ? 'pointer' : 'not-allowed';
