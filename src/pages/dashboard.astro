});

// ── STEP 7: Deadline ──
document.querySelectorAll('.s-chip[data-dlh]').forEach(chip => {
  chip.addEventListener('click', () => {
    document.querySelectorAll('.s-chip[data-dlh]').forEach(c => c.classList.remove('s-sel'));
    chip.classList.add('s-sel');
    const hours = parseInt((chip as HTMLElement).dataset.dlh || '0');
    const date = new Date(); date.setHours(date.getHours() + hours);
    const iso = new Date(date.getTime() - date.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    const wsD = document.getElementById('wsDeadline') as HTMLInputElement; if (wsD) wsD.value = iso;
    const wizD = document.getElementById('wizDeadline') as HTMLInputElement; if (wizD) wizD.value = iso;
    wizCalc();
  });
});
document.getElementById('wsDeadline')?.addEventListener('change', (e) => {
  const val = (e.target as HTMLInputElement).value;
  const wizD = document.getElementById('wizDeadline') as HTMLInputElement; if (wizD) wizD.value = val;
  document.querySelectorAll('.s-chip[data-dlh]').forEach(c => c.classList.remove('s-sel'));
