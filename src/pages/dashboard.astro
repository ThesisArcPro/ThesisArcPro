async function wizSubmitOrder() {
  const createBtn = document.getElementById('wizCreateOrderBtn') as HTMLButtonElement;
  if (createBtn) { createBtn.disabled = true; createBtn.textContent = '⏳ Submitting…'; }
 
  const total = wizTotal;
  const isDeposit = total >= 30;
  const amountPaid = 0;
  const email = currentSession.user.email || '';
  const topic = (document.getElementById('wizTopic') as HTMLInputElement)?.value || '';
  const type = (document.getElementById('wizType') as HTMLInputElement)?.value || '';
  const subject = (document.getElementById('wizSubject') as HTMLInputElement)?.value || '';
  const language = (document.getElementById('wizLanguage') as HTMLInputElement)?.value || '';
  const level = (document.getElementById('wizLevel') as HTMLSelectElement)?.value || '';
  const pages = parseInt((document.getElementById('wizPages') as HTMLInputElement)?.value || '1');
  const deadline = (document.getElementById('wizDeadline') as HTMLInputElement)?.value || '';
  const instructions = (document.getElementById('wizInstructions') as HTMLTextAreaElement)?.value || '';
 
  const addonsList: string[] = [];
  if (wizAddons.graphics > 0) addonsList.push(`Graphics x${wizAddons.graphics}`);
  if (wizAddons.psources > 0) addonsList.push(`Sources x${wizAddons.psources}`);
  if (wizAddons.abstract > 0) addonsList.push(`Abstract x${wizAddons.abstract}`);
  addonsList.push('Plagiarism & AI Report (FREE)');
 
  try {
    const ticketId = `T-${Date.now().toString().slice(-6)}`;
 
    await fetch(APPS_SCRIPT_URL, {
      method: 'POST', mode: 'no-cors',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ clientEmail: email, topic, assignmentType: type, subject, service: wizState.service, language, level, pages, deadline, addons: addonsList.join(', '), totalPrice: `$${total.toFixed(2)}`, amountPaid: `$${amountPaid.toFixed(2)}`, paymentStatus: isDeposit ? '50% Deposit Paid' : 'Paid in Full', instructions, ticketId })
    });
 
    await fetch(`${SUPABASE_URL}/rest/v1/orders`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
      body: JSON.stringify({ order_number: ticketId, client_email: email, topic, assignment_type: type, subject, service: wizState.service, language, education_level: level, pages, deadline, total_amount: total, amount_paid: amountPaid, payment_status: 'Pending', order_status: 'open_for_bids', instructions, transaction_id: null })
    });
 
    socket.emit('order:new', { id: ticketId, order_number: ticketId, topic, assignment_type: type, subject, pages, deadline, total_amount: total, order_status: 'open_for_bids' });
 
    const flow = document.getElementById('wizStepsFlow'); if (flow) flow.style.display = 'none';
    const success = document.getElementById('wizSuccess'); if (success) success.style.display = 'block';
    const ticket = document.getElementById('wizSuccessTicket'); if (ticket) ticket.textContent = `ID ${ticketId}`;
    const priceCard = document.getElementById('wizPriceCard'); if (priceCard) priceCard.style.display = 'none';
    const infoCard = document.getElementById('wizInfoCard'); if (infoCard) infoCard.style.display = 'none';
    const topicEl = document.getElementById('wizOrderTopic'); if (topicEl) topicEl.textContent = topic || 'Your order';
    const progressBar = document.getElementById('wizProgressBar'); if (progressBar) progressBar.style.display = 'none';
    // Populate order details tab
    const detailsEl = document.getElementById('wizOrderDetailsContent');
    if (detailsEl) detailsEl.innerHTML = `
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
        <div><div style="font-size:0.68rem;color:#94a3b8;text-transform:uppercase;font-weight:700;margin-bottom:0.2rem;">Service</div><div style="font-size:0.85rem;font-weight:600;color:#0f172a;">${esc(wizState.service)}</div></div>
        <div><div style="font-size:0.68rem;color:#94a3b8;text-transform:uppercase;font-weight:700;margin-bottom:0.2rem;">Type</div><div style="font-size:0.85rem;font-weight:600;color:#0f172a;">${esc(type)}</div></div>
        <div><div style="font-size:0.68rem;color:#94a3b8;text-transform:uppercase;font-weight:700;margin-bottom:0.2rem;">Subject</div><div style="font-size:0.85rem;font-weight:600;color:#0f172a;">${esc(subject)}</div></div>
        <div><div style="font-size:0.68rem;color:#94a3b8;text-transform:uppercase;font-weight:700;margin-bottom:0.2rem;">Level</div><div style="font-size:0.85rem;font-weight:600;color:#0f172a;">${esc(level)}</div></div>
        <div><div style="font-size:0.68rem;color:#94a3b8;text-transform:uppercase;font-weight:700;margin-bottom:0.2rem;">Pages</div><div style="font-size:0.85rem;font-weight:600;color:#0f172a;">${pages}</div></div>
        <div><div style="font-size:0.68rem;color:#94a3b8;text-transform:uppercase;font-weight:700;margin-bottom:0.2rem;">Language</div><div style="font-size:0.85rem;font-weight:600;color:#0f172a;">${esc(language)}</div></div>
        <div><div style="font-size:0.68rem;color:#94a3b8;text-transform:uppercase;font-weight:700;margin-bottom:0.2rem;">Total</div><div style="font-size:0.85rem;font-weight:600;color:#046fcd;">$${total.toFixed(2)}</div></div>
        <div><div style="font-size:0.68rem;color:#94a3b8;text-transform:uppercase;font-weight:700;margin-bottom:0.2rem;">Deadline</div><div style="font-size:0.85rem;font-weight:600;color:#0f172a;">${deadline ? new Date(deadline).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '—'}</div></div>
      </div>`;
    const instrEl = document.getElementById('wizOrderInstructionsContent');
    if (instrEl) instrEl.textContent = instructions || 'No instructions provided.';
    // Reset bid count
    const countEl = document.getElementById('wizBidCount'); if (countEl) countEl.textContent = '0';
    wizPendingBids = [];

    // Fetch new order's DB id and subscribe to live bids
    try {
      const oRes = await fetch(`${SUPABASE_URL}/rest/v1/orders?order_number=eq.${ticketId}&select=id`, {
        headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` }
      });
      const oData = await oRes.json();
      const newOrderDbId = String(oData[0]?.id || '');
      if (newOrderDbId) {
        wizCurrentOrderDbId = newOrderDbId;
        localStorage.setItem('wizPendingOrderId', newOrderDbId);
        socket.emit('bid:join', newOrderDbId);
        socket.off('bid:new');
        socket.on('bid:new', async (bid: any) => {
          // Add to pending buffer and show banner
          wizPendingBids.push(bid);
          const banner = document.getElementById('wizNewBidsBanner')!;
          const bannerAvatars = document.getElementById('wizBannerAvatars')!;
          const bannerText = document.getElementById('wizBannerText')!;
          // Fetch writer photo for banner avatar
          const w = await fetchWriterProfile(String(bid.writer_id));
          if (w?.photo_url) {
            bannerAvatars.insertAdjacentHTML('beforeend', `<img src="${esc(w.photo_url)}" style="width:24px;height:24px;border-radius:50%;border:2px solid #1e2536;margin-left:-6px;object-fit:cover;" />`);
          }
          bannerText.textContent = `Show ${wizPendingBids.length} new proposal${wizPendingBids.length > 1 ? 's' : ''}`;
          banner.style.display = 'flex';
        });
        // Fetch any bids already placed
        const bRes = await fetch(`${SUPABASE_URL}/rest/v1/bids?order_id=eq.${newOrderDbId}&select=id,bid_price,note,writer_id,created_at,status&order=created_at.desc`, {
          headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` }
        });
        const existingBids = await bRes.json();
        if (Array.isArray(existingBids) && existingBids.length > 0) {
          const waiting = document.getElementById('wizBidsWaiting');
          if (waiting) waiting.style.display = 'none';
          const box = document.getElementById('wizLiveBids');
          if (box) {
            const enriched = await enrichBidsWithWriters(existingBids);
            box.innerHTML = enriched.map((b: any) => wizRenderBidCard(b, newOrderDbId)).join('');
            attachWizHireBtns(box, newOrderDbId);
          }
        }
      }
    } catch(e) { console.error('bid subscription error', e); }
 
  } catch (err: any) {
    console.error('wizSubmitOrder error:', err);
    if (createBtn) { createBtn.disabled = false; createBtn.textContent = '🚀 Post Order'; }
    alert('❌ Something went wrong. Please try again.');
  }
}
// ═══════════════════════════════════════════
// END ORDER FORM MODAL
// ═══════════════════════════════════════════
  
  async function init() {
    try {
      setStatus('Checking your login…');
      const { data: { session } } = await withTimeout(supabase.auth.getSession(), 10000, 'Session check');
      if (!session) { window.location.replace(`${base}/login/`); return; }
      currentSession = session;
      // Look up this client's own client_id from their profile (for reviews)
      try {
        const pr = await fetch(
          `${SUPABASE_URL}/rest/v1/profiles?email=eq.${encodeURIComponent(session.user.email || '')}&select=client_id`,
          { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${session.access_token}` } }
        );
        const pdata = await pr.json();
        myClientId = pdata[0]?.client_id || null;
        const clientIdEl = document.getElementById('clientIdDisplay');
        if (clientIdEl && myClientId) clientIdEl.textContent = '#' + myClientId;
        // Tell bidding server this client is online
        socket.emit('client:online', myClientId);       
      } catch (e) { console.warn('Could not load client_id', e); }
      await loadOrders(session);

      // Reopen pending order modal if client refreshed while waiting for bids
      const pendingId = localStorage.getItem('wizPendingOrderId');
      if (pendingId) {
        try {
          const oRes = await fetch(`${SUPABASE_URL}/rest/v1/orders?id=eq.${pendingId}&select=id,order_number,order_status`, {
            headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${session.access_token}` }
          });
          const oData = await oRes.json();
          const pendingOrder = oData[0];
          if (pendingOrder && pendingOrder.order_status === 'open_for_bids') {
            openOrderModal();
            const flow = document.getElementById('wizStepsFlow'); if (flow) flow.style.display = 'none';
            const successEl = document.getElementById('wizSuccess'); if (successEl) successEl.style.display = 'block';
            const priceCard = document.getElementById('wizPriceCard'); if (priceCard) priceCard.style.display = 'none';
            const infoCard = document.getElementById('wizInfoCard'); if (infoCard) infoCard.style.display = 'none';
            const ticketEl = document.getElementById('wizSuccessTicket'); if (ticketEl) ticketEl.textContent = pendingOrder.order_number;
            const bar = document.getElementById('wizModalBar'); if (bar) bar.style.width = '100%';
            // Subscribe to live bids
            socket.emit('bid:join', String(pendingId));
            socket.off('bid:new');
            socket.on('bid:new', async (bid: any) => {
              const waiting = document.getElementById('wizBidsWaiting'); if (waiting) waiting.style.display = 'none';
              const box = document.getElementById('wizLiveBids'); if (!box) return;
              if (!box.querySelector(`[data-wbid="${bid.id}"]`)) {
                const writer = await fetchWriterProfile(String(bid.writer_id));
                bid.writer = writer || {};
                box.insertAdjacentHTML('afterbegin', wizRenderBidCard(bid, String(pendingId)));
                attachWizHireBtns(box, String(pendingId));
              }
            });
            const bRes = await fetch(`${SUPABASE_URL}/rest/v1/bids?order_id=eq.${pendingId}&select=id,bid_price,note,writer_id,created_at,status&order=created_at.desc`, {
              headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${session.access_token}` }
            });
            const existingBids = await bRes.json();
            if (Array.isArray(existingBids) && existingBids.length > 0) {
              const waiting = document.getElementById('wizBidsWaiting'); if (waiting) waiting.style.display = 'none';
              const box = document.getElementById('wizLiveBids');
              if (box) { 
              const enriched = await enrichBidsWithWriters(existingBids);
              box.innerHTML = enriched.map((b: any) => wizRenderBidCard(b, String(pendingId))).join(''); 
              attachWizHireBtns(box, String(pendingId)); 
            }
            }
          } else {
            localStorage.removeItem('wizPendingOrderId');
          }
        } catch(e) { console.error('restore pending order error', e); localStorage.removeItem('wizPendingOrderId'); }
      }

    } catch (err) {
      showDebugError(err);
    }
  }

  async function loadOrders(session: any) {
    try {
      setStatus('Fetching your orders…');
      const res = await withTimeout(
        fetch(
          `${SUPABASE_URL}/functions/v1/get-orders`,
          { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${session.access_token}` } }
        ),
        10000,
        'Orders fetch'
      );
      const json = await res.json() as { orders: any[]; error?: string };
      if (!res.ok) throw new Error(json.error || `Orders request failed (${res.status})`);
      allOrders = json.orders;
      updateCounts();
      renderOrders();
    } catch (err) {
      showDebugError(err);
    }
  }

  function updateCounts() {
    const countFor = (tab: string) => allOrders.filter((o: any) => {
      const s = o.order_status;
      if (tab === 'in_progress') return s === 'in_progress' || s === 'new';
      return s === tab;
    }).length;

    const set = (id: string, val: number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(val);
    };
    set('count_in_progress', countFor('in_progress'));
    set('count_in_review', countFor('in_review'));
    set('count_revision', countFor('revision'));
    set('count_completed', countFor('completed'));
    set('count_cancelled', countFor('cancelled'));
  }

  function deadlineInfo(deadline: string) {
    if (!deadline) return { text: 'No deadline', cls: '' };
    const diff = new Date(deadline).getTime() - Date.now();
    const days = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    if (diff < 0) return { text: `⚠️ ${Math.abs(days)}d overdue`, cls: 'overdue' };
    if (days === 0 && hours > 0) return { text: `⏰ ${hours}h left`, cls: 'urgent' };
    if (days <= 2) return { text: `⏰ ${days}d left`, cls: 'urgent' };
    return { text: `⏰ ${days}d left`, cls: 'ok' };
  }

  function statusClass(status: string) {
    const known = ['new','in_progress','in_review','completed','revision','cancelled'];
    return known.includes(status) ? status : 'new';
  }

  function esc(v: any) {
    return String(v ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderOrders() {
    const loading = document.getElementById('loadingState')!;
    const empty = document.getElementById('emptyState')!;
    const table = document.getElementById('orderTable')!;
    const list = document.getElementById('ordersList')!;
    const search = (document.getElementById('searchInput') as HTMLInputElement).value.toLowerCase();

    loading.style.display = 'none';

    let filtered = allOrders.filter((o: any) =>
      currentTab === 'in_progress'
        ? (o.order_status === 'in_progress' || o.order_status === 'new' || o.order_status === 'open_for_bids')
        : o.order_status === currentTab
    );

    if (search) {
      filtered = filtered.filter((o: any) =>
        (o.topic || '').toLowerCase().includes(search) ||
        (o.assignment_type || '').toLowerCase().includes(search)
      );
    }

    if (!filtered.length) {
      empty.style.display = 'flex';
      table.style.display = 'none';
      const emptyHeading = document.getElementById('emptyHeading');
      if (emptyHeading) emptyHeading.textContent = 'No orders in this view';
      return;
    }

    empty.style.display = 'none';
    table.style.display = 'flex';
    list.style.display = 'flex';
    list.style.flexDirection = 'column';
    list.style.gap = '0.5rem';

    list.innerHTML = filtered.map((o: any) => {
      const dl = deadlineInfo(o.deadline);
      return `
        <div class="order-row" data-id="${esc(o.id)}">
          <div class="col-left">
            <div class="order-title">${esc(o.topic || '(no topic)')}</div>
            <div class="order-meta">
              <span class="status-badge ${statusClass(o.order_status)}">${esc((o.order_status||'').replace(/_/g,' '))}</span>
              <span class="meta-dot">·</span>
              <span>${esc(o.pages||1)} page${o.pages>1?'s':''}</span>
              <span class="meta-dot">·</span>
              <span>${esc(o.assignment_type||'Essay')}</span>
              <span class="meta-dot">·</span>
              <span class="order-id">ID ${esc(o.order_number||o.id)}</span>
            </div>
          </div>
          <div class="col-right">
            <div class="col-deadline ${dl.cls}">${dl.text}</div>
            <div class="col-amount">$${Number(o.amount_paid||0).toFixed(2)}</div>
          </div>
        </div>
      `;
    }).join('');

    list.querySelectorAll('.order-row').forEach(row => {
      row.addEventListener('click', () => {
        const id = (row as HTMLElement).dataset.id;
        const order = allOrders.find((o: any) => String(o.id) === id);
        if (order) showModal(order);
      });
    });
  }

  // ── UPDATE ORDER STATUS (client-side) ──
  // Optionally saves a revision note in the same PATCH.
  async function updateOrderStatus(orderId: string, newStatus: string, revisionNote?: string): Promise<boolean> {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return false;
    const body: any = { order_status: newStatus, status_updated_at: new Date().toISOString() };
    if (typeof revisionNote === 'string') body.revision_note = revisionNote;
    const res = await fetch(
      `${SUPABASE_URL}/rest/v1/orders?id=eq.${orderId}`,
      {
        method: 'PATCH',
        headers: {
          'apikey': SUPABASE_KEY,
          'Authorization': `Bearer ${session.access_token}`,
          'Content-Type': 'application/json',
          'Prefer': 'return=minimal'
        },
        body: JSON.stringify(body)
      }
    );
    return res.ok;
  }

  function showModal(order: any) {
    const dl = deadlineInfo(order.deadline);
    const startDate = order.created_at
      ? new Date(order.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
      : '—';
    const dueDate = order.deadline
      ? new Date(order.deadline).toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
      : '—';

    const total = Number(order.total_amount || 0);
    const paid = Number(order.amount_paid || 0);
    const balance = Math.max(total - paid, 0);

    const field = (label: string, value: string, extraClass = '') =>
      `<div><div class="om-label">${label}</div><div class="om-value ${extraClass}">${value}</div></div>`;

    // Determine which client action buttons to show
    const status = order.order_status || '';
    const canRevise = ['in_progress', 'in_review', 'revision'].includes(status);
    const canComplete = ['in_progress', 'in_review', 'revision'].includes(status);

    const actionButtons = (canRevise || canComplete) ? `
      <div class="om-actions">
        ${canRevise ? `<button class="btn-revision" id="revisionBtn">🔄 Request Revision</button>` : ''}
        ${canComplete ? `<button class="btn-complete" id="completeBtn">✅ Mark as Complete</button>` : ''}
      </div>
      <div class="revision-form" id="revisionForm">
        <textarea class="revision-textarea" id="revisionReason" placeholder="Please describe what needs to be revised…"></textarea>
        <button class="revision-submit" id="revisionSubmit">Submit Revision Request</button>
      </div>
      <div class="om-action-msg" id="actionMsg"></div>
    ` : '';

    document.getElementById('modalContent')!.innerHTML = `
      <div class="om-header">
        <div class="om-title">${esc(order.topic || '(no topic)')}</div>
        <div class="om-id">ID ${esc(order.order_number || order.id)}</div>
      </div>

      <div class="om-tabs">
        <button class="om-tab om-tab--active" data-mtab="general">General</button>
        <button class="om-tab" data-mtab="instructions">Instructions</button>
        <button class="om-tab" data-mtab="files">Files</button>
        <button class="om-tab" data-mtab="chat">💬 Chat</button>
      </div>

      <!-- GENERAL -->
      <div class="om-panel om-panel--active" data-mpanel="general">
        <div class="om-grid">
          ${field('Status', esc((order.order_status || '—').replace(/_/g,' ')))}
          ${field('Payment', esc(order.payment_status || '—'))}
          ${field('Started', esc(startDate))}
          ${field('Time Left', dl.text)}
          ${field('Total', `$${total.toFixed(2)}`)}
          ${field('Amount Paid', `$${paid.toFixed(2)}`, 'green')}
          ${field('Balance Due', `$${balance.toFixed(2)}`)}
          ${field('Deadline', esc(dueDate))}
        </div>
        ${actionButtons}
      </div>

      <!-- INSTRUCTIONS -->
      <div class="om-panel" data-mpanel="instructions">
        <div class="om-grid">
          ${field('Type', esc(order.assignment_type || '—'))}
          ${field('Pages', esc(order.pages || '—'))}
          ${field('Education level', esc(order.education_level || '—'))}
          ${field('Subject', esc(order.subject || '—'))}
          ${field('Language', esc(order.language || '—'))}
          ${field('Service', esc(order.service || '—'))}
        </div>
        <div>
          <div class="om-desc-label">Description</div>
          <div class="om-desc">${order.instructions ? esc(order.instructions) : 'No description provided.'}</div>
        </div>
      </div>

      <!-- FILES -->
      <div class="om-panel" data-mpanel="files">
        <div id="clientFilesList"><div class="om-nofile">Loading files…</div></div>
      </div>

      <!-- CHAT -->
      <div class="om-panel" data-mpanel="chat">
        <div class="oc-thread">
          <div class="oc-messages" id="ocMessages"><div class="oc-loading">Loading…</div></div>
          <div class="oc-input-bar">
            <input type="text" class="oc-input" id="ocInput" placeholder="Message your writer…" />
            <button class="oc-send" id="ocSend">Send</button>
          </div>
        </div>
      </div>
    `;

    // ── REVISION BUTTON ──
    const revisionBtn = document.getElementById('revisionBtn');
    const revisionForm = document.getElementById('revisionForm');
    const revisionSubmit = document.getElementById('revisionSubmit');
    const revisionReason = document.getElementById('revisionReason') as HTMLTextAreaElement;
    const actionMsg = document.getElementById('actionMsg');

    if (revisionBtn && revisionForm) {
      revisionBtn.addEventListener('click', () => {
        revisionForm.classList.toggle('open');
        revisionReason.focus();
      });
    }

    if (revisionSubmit && revisionReason && actionMsg) {
      revisionSubmit.addEventListener('click', async () => {
        const reason = revisionReason.value.trim();
        if (!reason) {
          actionMsg.textContent = 'Please describe what needs to be revised before submitting.';
          actionMsg.className = 'om-action-msg error';
          return;
        }
        (revisionSubmit as HTMLButtonElement).disabled = true;
        revisionSubmit.textContent = 'Submitting…';

        // Update status to revision AND save the client's note in the same PATCH
        const ok = await updateOrderStatus(String(order.id), 'revision', reason);
        if (ok) {
          const idx = allOrders.findIndex((o: any) => o.id === order.id);
          if (idx !== -1) {
            allOrders[idx].order_status = 'revision';
            allOrders[idx].revision_note = reason;
          }
          updateCounts();
          renderOrders();
          actionMsg.textContent = '✅ Revision request submitted successfully.';
          actionMsg.className = 'om-action-msg success';
          (revisionForm as HTMLElement).classList.remove('open');
          setTimeout(() => closeModal(), 1800);
        } else {
          actionMsg.textContent = 'Something went wrong. Please try again or contact support.';
          actionMsg.className = 'om-action-msg error';
          (revisionSubmit as HTMLButtonElement).disabled = false;
          revisionSubmit.textContent = 'Submit Revision Request';
        }
      });
    }

    // ── COMPLETE BUTTON ──
    const completeBtn = document.getElementById('completeBtn');
    if (completeBtn && actionMsg) {
      completeBtn.addEventListener('click', async () => {
        const confirmed = window.confirm('Are you sure you want to mark this order as complete?');
        if (!confirmed) return;

        (completeBtn as HTMLButtonElement).disabled = true;
        completeBtn.textContent = 'Updating…';

        const ok = await updateOrderStatus(String(order.id), 'completed');
        if (ok) {
          const idx = allOrders.findIndex((o: any) => o.id === order.id);
          if (idx !== -1) allOrders[idx].order_status = 'completed';
          updateCounts();
          renderOrders();
          closeModal();
          reviewOrderNumber = order.order_number || String(order.id);
          reviewClientEmail = currentSession?.user?.email || '';
          reviewClientId = myClientId || order.client_id || '';
          openReviewModal();
        } else {
          actionMsg.textContent = 'Something went wrong. Please try again or contact support.';
          actionMsg.className = 'om-action-msg error';
          (completeBtn as HTMLButtonElement).disabled = false;
          completeBtn.textContent = '✅ Mark as Complete';
        }
      });
    }

    // ── SIGNED DOWNLOAD ──
    const downloadBtn = document.getElementById('downloadBtn');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', async () => {
        const path = (downloadBtn as HTMLElement).dataset.path || '';
        const note = document.getElementById('dlNote');
        (downloadBtn as HTMLButtonElement).disabled = true;
        downloadBtn.textContent = '⏳ Preparing download…';
        try {
          const { data, error } = await supabase.storage.from('completed-files').createSignedUrl(path, 120);
          if (error || !data?.signedUrl) throw error || new Error('No URL');
          window.open(data.signedUrl, '_blank');
          downloadBtn.textContent = '📥 Download completed work';
          (downloadBtn as HTMLButtonElement).disabled = false;
        } catch (err) {
          console.error(err);
          downloadBtn.textContent = '📥 Download completed work';
          (downloadBtn as HTMLButtonElement).disabled = false;
          if (note) note.textContent = 'Could not prepare the download. Please try again or contact support.';
        }
      });
    }

    // ── MODAL TABS ──
    const content = document.getElementById('modalContent')!;
    content.querySelectorAll('.om-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const which = (tab as HTMLElement).dataset.mtab;
        content.querySelectorAll('.om-tab').forEach(t => t.classList.remove('om-tab--active'));
        content.querySelectorAll('.om-panel').forEach(p => p.classList.remove('om-panel--active'));
        tab.classList.add('om-tab--active');
        content.querySelector(`.om-panel[data-mpanel="${which}"]`)?.classList.add('om-panel--active');
        if (which === 'chat') openOrderChat(order);
        if (which === 'files') loadClientFiles(order.id);
      });
    });

    document.getElementById('detailModal')!.classList.add('open');
  }

  // ── REVIEW MODAL ──
  function openReviewModal() {
    selectedRating = 0;
    document.querySelectorAll('.star').forEach(s => s.classList.remove('selected'));
    (document.getElementById('reviewText') as HTMLTextAreaElement).value = '';
    document.getElementById('reviewSuccess')!.style.display = 'none';
    const submitBtn = document.getElementById('submitReviewBtn') as HTMLButtonElement;
    submitBtn.disabled = false;
    submitBtn.textContent = 'Submit Review';
    document.getElementById('reviewModal')!.classList.add('open');
  }

  function closeReviewModal() {
    document.getElementById('reviewModal')!.classList.remove('open');
  }

  // Star selection
  document.querySelectorAll('.star').forEach(star => {
    star.addEventListener('click', () => {
      selectedRating = parseInt((star as HTMLElement).dataset.val || '0');
      document.querySelectorAll('.star').forEach((s, i) => {
        s.classList.toggle('selected', i < selectedRating);
      });
    });
    star.addEventListener('mouseover', () => {
      const val = parseInt((star as HTMLElement).dataset.val || '0');
      document.querySelectorAll('.star').forEach((s, i) => {
        s.classList.toggle('selected', i < val);
      });
    });
    star.addEventListener('mouseout', () => {
      document.querySelectorAll('.star').forEach((s, i) => {
        s.classList.toggle('selected', i < selectedRating);
      });
    });
  });

  document.getElementById('submitReviewBtn')!.addEventListener('click', async () => {
    if (!selectedRating) {
      alert('Please select a star rating before submitting.');
      return;
    }
    const submitBtn = document.getElementById('submitReviewBtn') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting…';

    const reviewText = (document.getElementById('reviewText') as HTMLTextAreaElement).value.trim();

    const { error } = await supabase.from('reviews').insert({
      order_number: reviewOrderNumber,
      client_email: reviewClientEmail,
      client_id: reviewClientId || null,
      rating: selectedRating,
      review_text: reviewText || null
    });

    if (error) {
      console.error(error);
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Review';
      alert('Could not save your review. Please try again.');
      return;
    }

    document.getElementById('reviewSuccess')!.style.display = 'block';
    submitBtn.style.display = 'none';
    document.getElementById('skipReviewBtn')!.textContent = 'Close';
  });

  document.getElementById('skipReviewBtn')!.addEventListener('click', closeReviewModal);
  document.getElementById('reviewOverlay')!.addEventListener('click', closeReviewModal);

  // ═══ ORDER CHAT (client side) ═══
  let ocConvId: string | null = null;
  let ocOrder: any = null;
  let ocSub: any = null;

  function ocRender(messages: any[]) {
    const c = document.getElementById('ocMessages');
    if (!c) return;
    if (!messages.length) { c.innerHTML = '<div class="oc-empty">No messages yet. Say hello to your writer!</div>'; return; }
    c.innerHTML = messages.map((m: any) => {
      const mine = m.sender_id === currentSession.user.id;
      const time = m.created_at ? new Date(m.created_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '';
      const who = m.sender_role === 'support' ? 'Support' : (m.sender_name || 'Writer');
      return `<div class="oc-row ${mine ? 'mine' : 'theirs'}">
        ${!mine ? `<div class="oc-name">${esc(who)}</div>` : ''}
        <div class="oc-bubble">${esc(m.content)}</div>
        <div class="oc-time">${time}</div>
      </div>`;
    }).join('');
    c.scrollTop = c.scrollHeight;
  }

  async function ocFindConversation(orderId: string) {
    const res = await fetch(
      `${SUPABASE_URL}/rest/v1/conversations?type=eq.order&order_id=eq.${orderId}&select=id&limit=1`,
      { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` } }
    );
    const rows = await res.json();
    return rows[0]?.id || null;
  }

  async function openOrderChat(order: any) {
    ocOrder = order;
    ocConvId = null;
    if (ocSub) { ocSub.unsubscribe(); ocSub = null; }
    const c = document.getElementById('ocMessages')!;
    c.innerHTML = '<div class="oc-loading">Loading…</div>';
    try {
      ocConvId = await ocFindConversation(String(order.id));
      if (!ocConvId) { ocRender([]); return; }
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/messages?conversation_id=eq.${ocConvId}&order=created_at.asc`,
        { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` } }
      );
      ocRender(await res.json());
      ocSubscribe();
      if (ocConvId) markConversationRead(ocConvId, String(order.id));
    } catch (err) { console.error(err); c.innerHTML = '<div class="oc-empty">Could not load chat.</div>'; }
  }

  function ocSubscribe() {
    if (!ocConvId || ocSub) return;
    ocSub = supabase.channel(`oc-${ocConvId}`)
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages', filter: `conversation_id=eq.${ocConvId}` },
        (payload: any) => {
          const m = payload.new;
          const c = document.getElementById('ocMessages')!;
          const ph = c.querySelector('.oc-empty, .oc-loading'); if (ph) c.innerHTML = '';
          const mine = m.sender_id === currentSession.user.id;
          const time = m.created_at ? new Date(m.created_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '';
          const who = m.sender_role === 'support' ? 'Support' : (m.sender_name || 'Writer');
          c.insertAdjacentHTML('beforeend', `<div class="oc-row ${mine ? 'mine' : 'theirs'}">${!mine ? `<div class="oc-name">${esc(who)}</div>` : ''}<div class="oc-bubble">${esc(m.content)}</div><div class="oc-time">${time}</div></div>`);
          c.scrollTop = c.scrollHeight;
        }).subscribe();
  }

  async function ocSend() {
    const input = document.getElementById('ocInput') as HTMLInputElement;
    const text = input.value.trim();
    if (!text || !ocOrder) return;
    const btn = document.getElementById('ocSend') as HTMLButtonElement;
    btn.disabled = true; input.value = '';
    const clientName = currentSession.user.email?.split('@')[0] || 'Client';
    try {
      // First message creates the conversation + adds client as participant
      if (!ocConvId) {
        const title = `Order ${ocOrder.order_number || ocOrder.id}`;
        const cRes = await fetch(`${SUPABASE_URL}/rest/v1/conversations`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}`, 'Prefer': 'return=representation' },
          body: JSON.stringify({ type: 'order', order_id: Number(ocOrder.id), title })
        });
        ocConvId = (await cRes.json())[0]?.id;
        if (!ocConvId) throw new Error('Could not create conversation');
        await fetch(`${SUPABASE_URL}/rest/v1/conversation_participants`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` },
          body: JSON.stringify({ conversation_id: ocConvId, user_id: currentSession.user.id, role: 'client', display_name: clientName })
        });
        ocSubscribe();
      }
      await fetch(`${SUPABASE_URL}/rest/v1/messages`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ conversation_id: ocConvId, sender_id: currentSession.user.id, sender_name: clientName, sender_role: 'client', content: text })
      });
      await fetch(`${SUPABASE_URL}/rest/v1/conversations?id=eq.${ocConvId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}`, 'Prefer': 'return=minimal' },
        body: JSON.stringify({ updated_at: new Date().toISOString() })
      });
    } catch (err) { console.error(err); alert('Could not send message. Please try again.'); }
    btn.disabled = false; input.focus();
  }

  document.addEventListener('click', (e) => { if ((e.target as HTMLElement)?.id === 'ocSend') ocSend(); });
  document.addEventListener('keydown', (e) => { if ((e.target as HTMLElement)?.id === 'ocInput' && (e as KeyboardEvent).key === 'Enter') { e.preventDefault(); ocSend(); } });
  async function loadClientFiles(orderId: string) {
    const box = document.getElementById('clientFilesList');
    if (!box) return;
    box.innerHTML = '<div class="om-nofile">Loading files…</div>';
    try {
      const { data: { session } } = await supabase.auth.getSession();
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/order_files?order_id=eq.${orderId}&order=created_at.desc`,
        { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${session?.access_token}` } }
      );
      const files = await res.json();
      if (!Array.isArray(files) || !files.length) {
        box.innerHTML = '<div class="om-nofile">Your files will appear here once the writer delivers them.</div>';
        return;
      }
      box.innerHTML = files.map((f: any) => `
        <div class="cf-row">
          <div class="cf-info"><span class="cf-type">${esc(f.file_type || 'File')}</span><span class="cf-name">${esc(f.file_name || 'file')}</span></div>
          <button class="cf-dl" data-path="${esc(f.file_path)}">📥 Download</button>
        </div>`).join('');
      box.querySelectorAll('.cf-dl').forEach(btn => {
        btn.addEventListener('click', async () => {
          const path = (btn as HTMLElement).dataset.path || '';
          (btn as HTMLButtonElement).disabled = true; btn.textContent = '⏳ Preparing…';
          try {
            const { data, error } = await supabase.storage.from('completed-files').createSignedUrl(path, 120);
            if (error || !data?.signedUrl) throw error || new Error('No URL');
            window.open(data.signedUrl, '_blank');
          } catch { alert('Could not prepare the download. Please try again.'); }
          (btn as HTMLButtonElement).disabled = false; btn.textContent = '📥 Download';
        });
      });
    } catch (err) { console.error(err); box.innerHTML = '<div class="om-nofile">Could not load files.</div>'; }
  }
  // ═══ HIRE WRITER PAYMENT FLOW ═══
  let hireBidId = '';
  let hireWriterId = '';
  let hireOrderId = '';
  let hireBidPrice = 0;

  function openHirePaymentModal(bidId: string, writerId: string, bidPrice: number, orderId: string) {
    hireBidId = bidId; hireWriterId = writerId; hireOrderId = orderId; hireBidPrice = bidPrice;
    const isDeposit = bidPrice >= 30;
    const amountNow = isDeposit ? bidPrice * 0.5 : bidPrice;
    const pd = document.getElementById('hirePaymentDetails');
    if (pd) pd.innerHTML = `
      <p style="font-size:0.9rem;color:#64748b;margin:0 0 0.4rem;">Writer's Bid</p>
      <p style="font-size:1.7rem;color:#0f172a;font-weight:800;margin:0 0 0.3rem;">$${bidPrice.toFixed(2)}</p>
      <p style="font-size:0.9rem;color:#64748b;margin:0 0 0.3rem;">Pay Now</p>
      <p style="font-size:1.9rem;color:#c5a059;font-weight:800;margin:0;">$${amountNow.toFixed(2)}</p>`;
    const pp = document.getElementById('hirePaymentPolicy');
    if (pp) pp.textContent = isDeposit
      ? `50% deposit now. Remaining $${(bidPrice * 0.5).toFixed(2)} due on delivery.`
      : 'Full payment required for orders under $30.';
    const txn = document.getElementById('hireTxnId') as HTMLInputElement;
    if (txn) txn.value = '';
    const btn = document.getElementById('hireConfirmBtn') as HTMLButtonElement;
    if (btn) { btn.disabled = true; btn.style.opacity = '0.5'; btn.textContent = '✅ I Have Paid — Hire Writer'; }
    document.getElementById('hirePaymentModal')!.classList.add('open');
  }

  document.getElementById('writerProfileClose')!.addEventListener('click', () => {
    document.getElementById('writerProfileModal')!.classList.remove('open');
  });
  document.getElementById('writerProfileOverlay')!.addEventListener('click', () => {
    document.getElementById('writerProfileModal')!.classList.remove('open');
  });

  document.getElementById('hirePaymentClose')!.addEventListener('click', () => {
    document.getElementById('hirePaymentModal')!.classList.remove('open');
  });
  document.getElementById('hirePaymentOverlay')!.addEventListener('click', () => {
    document.getElementById('hirePaymentModal')!.classList.remove('open');
  });
  document.getElementById('hireTxnId')!.addEventListener('input', (e) => {
    const v = (e.target as HTMLInputElement).value.trim();
    const btn = document.getElementById('hireConfirmBtn') as HTMLButtonElement;
    if (btn) { btn.disabled = v.length < 5; btn.style.opacity = v.length >= 5 ? '1' : '0.5'; }
  });

  document.getElementById('hireConfirmBtn')!.addEventListener('click', async () => {
    const txnId = (document.getElementById('hireTxnId') as HTMLInputElement)?.value.trim();
    const btn = document.getElementById('hireConfirmBtn') as HTMLButtonElement;
    if (!/^[A-Z0-9]{8,20}$/i.test(txnId)) { alert('❌ Invalid Transaction ID format.'); return; }
    btn.textContent = '⏳ Checking...'; btn.disabled = true;
    try {
      const r = await fetch(`${SUPABASE_URL}/rest/v1/orders?select=id&transaction_id=eq.${txnId}`, {
        headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession?.access_token}` }
      });
      const d = await r.json();
      if (d.length > 0) { alert('❌ This Transaction ID has already been used.'); btn.textContent = '✅ I Have Paid — Hire Writer'; btn.disabled = false; return; }

      // Accept bid, reject others, update order
      await fetch(`${SUPABASE_URL}/rest/v1/bids?id=eq.${hireBidId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=minimal' },
        body: JSON.stringify({ status: 'accepted' })
      });
      await fetch(`${SUPABASE_URL}/rest/v1/bids?order_id=eq.${hireOrderId}&id=neq.${hireBidId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=minimal' },
        body: JSON.stringify({ status: 'rejected' })
      });
      const orderObj = allOrders.find((o: any) => String(o.id) === hireOrderId);
      const orderNumber = orderObj?.order_number;
      await fetch(`${SUPABASE_URL}/rest/v1/orders?id=eq.${hireOrderId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=minimal' },
        body: JSON.stringify({ order_status: 'in_progress', status_updated_at: new Date().toISOString() })
      });
      const isDeposit = hireBidPrice >= 30;
      const amountPaid = isDeposit ? hireBidPrice * 0.5 : hireBidPrice;
      await fetch(`${SUPABASE_URL}/rest/v1/orders?order_number=eq.${orderNumber}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=minimal' },
        body: JSON.stringify({ writer_id: parseInt(hireWriterId), transaction_id: txnId, amount_paid: amountPaid, payment_status: isDeposit ? '50% Deposit Paid' : 'Paid in Full' })
      });
      socket.emit('bid:accept', { bidId: hireBidId, orderId: hireOrderId, writerId: hireWriterId });
      localStorage.removeItem('wizPendingOrderId');
      document.getElementById('hirePaymentModal')!.classList.remove('open');
      closeModal();
      closeOrderModal();
      await loadOrders(currentSession);
      alert('✅ Writer hired! Your order is now in progress.');
    } catch (err) {
      console.error(err);
      btn.textContent = '✅ I Have Paid — Hire Writer'; btn.disabled = false;
      alert('❌ Something went wrong. Please try again.');
    }
  });
  // ═══ END HIRE WRITER PAYMENT FLOW ═══

  function closeModal() {
    document.getElementById('detailModal')!.classList.remove('open');
  }

  document.getElementById('modalClose')!.addEventListener('click', closeModal);
  document.getElementById('modalOverlay')!.addEventListener('click', closeModal);

  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentTab = (tab as HTMLElement).dataset.tab || 'in_progress';
      renderOrders();
    });
  });

  document.getElementById('searchInput')!.addEventListener('input', renderOrders);

  // Open Chat widget when "Chats" is clicked
  document.getElementById('chatsLink')!.addEventListener('click', (e) => {
  e.preventDefault();
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('chatsLink')!.classList.add('active');
  (document.querySelector('.main-header') as HTMLElement).style.display = 'none';
  (document.querySelector('.tabs-bar') as HTMLElement).style.display = 'none';
  (document.querySelector('.controls-bar') as HTMLElement).style.display = 'none';
  (document.querySelector('.orders-area') as HTMLElement).style.display = 'none';
  document.getElementById('chatsPanelWrap')!.style.display = 'flex';
  loadChatsPanel();
});
document.getElementById('myOrdersLink')!.addEventListener('click', (e) => {
  e.preventDefault();
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('myOrdersLink')!.classList.add('active');
  document.getElementById('chatsPanelWrap')!.style.display = 'none';
  (document.querySelector('.main-header') as HTMLElement).style.display = 'flex';
  (document.querySelector('.tabs-bar') as HTMLElement).style.display = 'flex';
  (document.querySelector('.controls-bar') as HTMLElement).style.display = 'flex';
  (document.querySelector('.orders-area') as HTMLElement).style.display = 'flex';

});


  document.getElementById('logoutBtn')!.addEventListener('click', async (e) => {
    e.preventDefault();
    await supabase.auth.signOut();
    window.location.href = `${base}/login/`;
  });

  init();

  // ═══ UNREAD / NOTIFICATIONS ═══
  let unreadOrderIds = new Set<string>();
  let myConvParticipants: any[] = [];   // {conversation_id, last_read_at, order_id}
  let unreadGlobalSub: any = null;

  function playPing() {
    try {
      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc = ctx.createOscillator(); const gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(880, ctx.currentTime);
      osc.frequency.setValueAtTime(660, ctx.currentTime + 0.12);
      gain.gain.setValueAtTime(0.18, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.35);
      osc.start(); osc.stop(ctx.currentTime + 0.35);
    } catch (e) {}
  }

  async function refreshUnread() {
    if (!currentSession) return;
    try {
      // 1. My participant rows + the conversation's order_id
      const pRes = await fetch(
        `${SUPABASE_URL}/rest/v1/conversation_participants?user_id=eq.${currentSession.user.id}&select=conversation_id,last_read_at,conversations(order_id,type)`,
        { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` } }
      );
      const parts = await pRes.json();
      myConvParticipants = parts.map((p: any) => ({
        conversation_id: p.conversation_id,
        last_read_at: p.last_read_at,
        order_id: p.conversations?.order_id ? String(p.conversations.order_id) : null
      }));

      if (!myConvParticipants.length) { unreadOrderIds = new Set(); paintUnread(); return; }

      // 2. Fetch recent messages for those conversations in one call
      const ids = myConvParticipants.map(p => p.conversation_id);
      const inList = ids.map(i => `"${i}"`).join(',');
      const mRes = await fetch(
        `${SUPABASE_URL}/rest/v1/messages?conversation_id=in.(${inList})&select=conversation_id,sender_id,created_at&order=created_at.desc&limit=200`,
        { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` } }
      );
      const msgs = await mRes.json();

      // 3. A conversation is unread if it has a message from someone else, newer than my last_read_at
      const newUnread = new Set<string>();
      for (const p of myConvParticipants) {
        const lr = p.last_read_at ? new Date(p.last_read_at).getTime() : 0;
        const hasNew = msgs.some((m: any) =>
          m.conversation_id === p.conversation_id &&
          m.sender_id !== currentSession.user.id &&
          new Date(m.created_at).getTime() > lr
        );
        if (hasNew && p.order_id) newUnread.add(p.order_id);
      }
      unreadOrderIds = newUnread;
      paintUnread();
    } catch (err) { console.error('refreshUnread', err); }
  }

  function paintUnread() {
    // Sidebar badge
    const badge = document.getElementById('chatsBadge');
    if (badge) {
      const n = unreadOrderIds.size;
      if (n > 0) { badge.textContent = String(n); (badge as HTMLElement).style.display = 'inline-flex'; }
      else (badge as HTMLElement).style.display = 'none';
    }
    // Dots on order rows
    document.querySelectorAll('.order-row').forEach(row => {
      const id = (row as HTMLElement).dataset.id || '';
      let dot = row.querySelector('.unread-dot');
      if (unreadOrderIds.has(id)) {
        if (!dot) {
          dot = document.createElement('span');
          dot.className = 'unread-dot';
          (row as HTMLElement).querySelector('.col-right')?.prepend(dot);
        }
      } else if (dot) { dot.remove(); }
    });
  }

  // Mark a conversation read (stamp last_read_at = now)
  async function markConversationRead(conversationId: string, orderId: string) {
    try {
      await fetch(`${SUPABASE_URL}/rest/v1/conversation_participants?user_id=eq.${currentSession.user.id}&conversation_id=eq.${conversationId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}`, 'Prefer': 'return=minimal' },
        body: JSON.stringify({ last_read_at: new Date().toISOString() })
      });
    } catch (e) { console.error(e); }
    unreadOrderIds.delete(orderId);
    paintUnread();
  }

  // Global subscription: any new message in ANY of my conversations
  function startGlobalUnreadSub() {
    if (unreadGlobalSub) return;
    unreadGlobalSub = supabase.channel('client-unread-all')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages' }, (payload: any) => {
        const m = payload.new;
        if (m.sender_id === currentSession.user.id) return;            // ignore my own
        const mine = myConvParticipants.find(p => p.conversation_id === m.conversation_id);
        if (!mine) return;                                             // not my conversation
        playPing();
        if (mine.order_id) { unreadOrderIds.add(mine.order_id); paintUnread(); }
      }).subscribe();
  }

  // Kick off once orders + session are ready
  (async function initUnread() {
    for (let i = 0; i < 40 && !currentSession; i++) await new Promise(r => setTimeout(r, 250));
    if (!currentSession) return;
    await refreshUnread();
    startGlobalUnreadSub();
  })();

  // ── THEME TOGGLE (icon + popup) ──
  const THEME_KEY = 'dashboard-theme';
  const themeIconBtn = document.getElementById('themeIconBtn');
  const themePopup = document.getElementById('themePopup');
  const themePopupOverlay = document.getElementById('themePopupOverlay');
  const themeIconCurrent = document.getElementById('themeIconCurrent');

  const themeIcons: Record<string, string> = { dark: '🌙', light: '☀️', system: '💻' };

  function getSystemPref() {
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme(setting: string) {
    const actual = setting === 'system' ? getSystemPref() : setting;
    if (actual === 'dark') {
      document.body.classList.add('dark-mode');
    } else {
      document.body.classList.remove('dark-mode');
    }
    document.querySelectorAll('.theme-popup__opt').forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.theme === setting);
    });
    if (themeIconCurrent) themeIconCurrent.textContent = themeIcons[setting] || '☀️';
    localStorage.setItem(THEME_KEY, setting);
  }

  // Open popup
  themeIconBtn?.addEventListener('click', () => {
    themePopup?.classList.add('open');
  });

  // Close popup
  themePopupOverlay?.addEventListener('click', () => {
    themePopup?.classList.remove('open');
  });

  // Option clicks
  document.querySelectorAll('.theme-popup__opt').forEach(btn => {
    btn.addEventListener('click', () => {
      applyTheme((btn as HTMLElement).dataset.theme || 'light');
      themePopup?.classList.remove('open');
    });
  });

  // System preference change
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (localStorage.getItem(THEME_KEY) === 'system') applyTheme('system');
  });

  applyTheme(localStorage.getItem(THEME_KEY) || 'light');
</script>
</BaseLayout>
