// ORDER FORM MODAL — WIZARD LOGIC
// ═══════════════════════════════════════════
const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxVL-dECKrdcEyyJObsP9KCQnRJ_TnmTT7qB6rvx-89cSmDbGIUKzviUAX83wPkYtZWzg/exec';

const wizState = { service: '', serviceBase: 0, levelAdd: 0, levelLabel: '' };
const wizAddons: Record<string, number> = { graphics: 0, psources: 0, abstract: 0 };
const wizAddonPrices: Record<string, number> = { graphics: 5, psources: 4, abstract: 7 };
let wizTotal = 0;
let wsRevealed = 1;
let wsPages = 1;

function openOrderModal() {
  resetWizard();
  document.getElementById('orderFormModal')!.classList.add('open');
}

function closeOrderModal() {
  document.getElementById('orderFormModal')!.classList.remove('open');
}

function resetWizard() {
  wsRevealed = 1;
  wsPages = 1;
  wizState.service = ''; wizState.serviceBase = 0;
  wizState.levelAdd = 0; wizState.levelLabel = '';
  Object.keys(wizAddons).forEach(k => wizAddons[k] = 0);
  wizTotal = 0;

  // Show only step 1, hide 2–8, clear done state
  for (let i = 1; i <= 8; i++) {
    const el = document.getElementById(`ws${i}`);
    if (!el) continue;
    el.style.display = i === 1 ? 'block' : 'none';
    el.classList.remove('s-done');
  }

  // Clear chip selections
  document.querySelectorAll('.s-chip').forEach(c => c.classList.remove('s-sel'));

  // Clear visible inputs
  const wsInstr = document.getElementById('wsInstructions') as HTMLTextAreaElement;
  const wsDeadline = document.getElementById('wsDeadline') as HTMLInputElement;
  const wsPagesVal = document.getElementById('wsPagesVal');
  const wsPagesHint = document.getElementById('wsPagesHint');
  const wsTypeDropdown = document.getElementById('wsTypeDropdown') as HTMLSelectElement;
  if (wsInstr) wsInstr.value = '';
  if (wsDeadline) wsDeadline.value = '';
  if (wsPagesVal) wsPagesVal.textContent = '1';
  if (wsPagesHint) wsPagesHint.textContent = '≈ 275 words';
  if (wsTypeDropdown) wsTypeDropdown.value = '';
  const wsSubjectOther = document.getElementById('wsSubjectOther') as HTMLInputElement;
  const wsTypeOther = document.getElementById('wsTypeOther') as HTMLInputElement;
  if (wsSubjectOther) wsSubjectOther.value = '';
  if (wsTypeOther) wsTypeOther.value = '';
  const wsDouble = document.getElementById('wsDouble');
  const wsSingle = document.getElementById('wsSingle');
  if (wsDouble) wsDouble.classList.add('s-sel');
  if (wsSingle) wsSingle.classList.remove('s-sel');

  // Clear hidden compat fields
  (['wizTopic','wizType','wizSubject','wizLanguage','wizInstructions'] as string[]).forEach(id => {
    const el = document.getElementById(id) as HTMLInputElement;
    if (el) el.value = '';
  });
  const wizPagesInp = document.getElementById('wizPages') as HTMLInputElement;
  if (wizPagesInp) wizPagesInp.value = '1';
  const wizDeadlineInp = document.getElementById('wizDeadline') as HTMLInputElement;
  if (wizDeadlineInp) wizDeadlineInp.value = '';
  const wizLevelSel = document.getElementById('wizLevel') as HTMLSelectElement;
  if (wizLevelSel) wizLevelSel.value = '';

  // Reset success/flow
  const success = document.getElementById('wizSuccess'); if (success) success.style.display = 'none';
  const flow = document.getElementById('wizStepsFlow'); if (flow) flow.style.display = 'block';
  wizSetChatLayout(false);
  const info = document.getElementById('wizInfoCard'); if (info) info.style.display = 'block';
  const price = document.getElementById('wizPriceCard'); if (price) price.style.display = 'none';
  const bar = document.getElementById('wizProgressBar'); if (bar) bar.style.display = 'block';

  updateWizBar();
  wizRefreshInfo();
}

function updateWizBar() {
  const bar = document.getElementById('wizModalBar');
  if (bar) bar.style.width = `${(wsRevealed / 8) * 100}%`;
}

function wizSetChatLayout(active: boolean) {
  const box = document.querySelector('#orderFormModal .modal-box');
  const grid = document.getElementById('wizModalGrid');
  if (box) box.classList.toggle('wiz-wide', active);
  if (grid) grid.classList.toggle('wiz-chat-layout', active);
}

function revealStep(n: number) {
  const el = document.getElementById(`ws${n}`);
  if (!el) return;
  el.style.display = 'block';
  wsRevealed = Math.max(wsRevealed, n);
  updateWizBar();
  setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 80);
  // Switch summary card at step 6
  const info = document.getElementById('wizInfoCard');
  const price = document.getElementById('wizPriceCard');
  if (n >= 6) {
    if (info) info.style.display = 'none';
    if (price) price.style.display = 'block';
    wizCalc();
  } else {
    if (info) info.style.display = 'block';
    if (price) price.style.display = 'none';
  }
}

function markDone(n: number) {
  const el = document.getElementById(`ws${n}`);
  if (el) el.classList.add('s-done');
}

function wizRefreshInfo() {
  const pages = parseInt((document.getElementById('wizPages') as HTMLInputElement)?.value || '1');
  const set = (id: string, v: string) => { const e = document.getElementById(id); if (e) e.textContent = v; };
  set('wizISvc', wizState.service || '—');
  set('wizIType', (document.getElementById('wizType') as HTMLInputElement)?.value || '—');
  set('wizISubject', (document.getElementById('wizSubject') as HTMLInputElement)?.value || '—');
  set('wizIPages', `${pages} double-spaced page${pages > 1 ? 's' : ''}`);
  const instr = (document.getElementById('wsInstructions') as HTMLTextAreaElement)?.value || '';
  set('wizIInstr', instr.trim() ? (instr.length > 50 ? instr.slice(0, 50) + '…' : instr) : '—');
  const dl = (document.getElementById('wizDeadline') as HTMLInputElement)?.value;
  set('wizIDeadline', dl ? new Date(dl).toLocaleString('en-US', { hour: '2-digit', minute: '2-digit', month: 'short', day: 'numeric' }) : '—');
}

function wizLevelAdd(): number { return wizState.levelAdd || 0; }
function wizLevelLabel(): string { return wizState.levelLabel || '—'; }

function wizCalc() {
  const pages = parseInt((document.getElementById('wizPages') as HTMLInputElement)?.value || '1');
  const rate = wizState.serviceBase ? wizState.serviceBase + wizLevelAdd() : 0;

  let urgencyPerPage = 0, urgencyText = '';
  const dlInput = document.getElementById('wizDeadline') as HTMLInputElement;
  if (dlInput?.value) {
    const h = (new Date(dlInput.value).getTime() - Date.now()) / 3600000;
    if (h < 6)       { urgencyPerPage = rate * 0.5; urgencyText = '🔴 RUSH (under 6h): +50%'; }
    else if (h < 12) { urgencyPerPage = rate * 0.3; urgencyText = '🟠 Urgent (6–12h): +30%'; }
    else if (h < 24) { urgencyPerPage = rate * 0.2; urgencyText = '🟡 Same day (12–24h): +20%'; }
    else if (h < 48) { urgencyPerPage = rate * 0.1; urgencyText = '🟢 Standard (1–2 days): +10%'; }
  }

  const baseTotal = rate * pages;
  const urgencyTotal = urgencyPerPage * pages;
  let addonsTotal = 0;
  for (const [k, q] of Object.entries(wizAddons)) addonsTotal += (wizAddonPrices[k] || 0) * q;
  wizTotal = baseTotal + urgencyTotal + addonsTotal;

  const set = (id: string, v: string) => { const e = document.getElementById(id); if (e) e.textContent = v; };
  set('wizSumService', wizState.service || '—');
  set('wizSumLevel', wizLevelLabel());
  set('wizSumBase', rate ? `$${rate.toFixed(2)}/pg` : '—');
  set('wizSumPages', `x ${pages}`);
  set('wizCalcTotal', `$${wizTotal.toFixed(2)}`);
  set('wizSumTotal', `$${wizTotal.toFixed(2)}`);
  const uRow = document.getElementById('wizSumUrgencyRow');
  if (uRow) uRow.style.display = urgencyTotal > 0 ? 'flex' : 'none';
  set('wizSumUrgencyLabel', urgencyText.split(':')[0] || 'Urgency');
  set('wizSumUrgency', `+$${urgencyTotal.toFixed(2)}`);
  const aRow = document.getElementById('wizSumAddonsRow');
  if (aRow) aRow.style.display = addonsTotal > 0 ? 'flex' : 'none';
  set('wizSumAddons', `+$${addonsTotal.toFixed(2)}`);
  wizRefreshInfo();
}

