  async function refreshWalletBalance() {
    if (!currentSession) return;
    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/wallets?user_id=eq.${currentSession.user.id}&select=available_balance`,
        { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
      );
      const data = await res.json();
      walletBalance = data[0]?.available_balance ? Number(data[0].available_balance) : 0;
      const el = document.getElementById('walletBalanceDisplay');
      if (el) el.textContent = `$${walletBalance.toFixed(2)}`;
    } catch (e) { console.error('refreshWalletBalance error', e); }
  }
 
