---
import BaseLayout from '../layouts/BaseLayout.astro';
// import SimpleOrderForm from '../components/SimpleOrderForm.astro';
const base = '';
---

<BaseLayout title="Get Started — ThesisArcPro" description="Get matched with a vetted academic consultant. Start your order in minutes.">

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --ink: #0f172a;
    --muted: #64748b;
    --faint: #94a3b8;
    --border: #e2e8f0;
    --accent: #046fcd;
    --accent-dark: #0361b3;
    --surface: #f8fafc;
  }

  body {
    font-family: 'Poppins', 'Inter', 'Segoe UI', sans-serif;
    color: var(--ink);
    background: #fff;
  }

  a { text-decoration: none; color: inherit; }

  /* ── NAV ── */
  .lp-nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 2rem; border-bottom: 1px solid var(--border);
  }
  .lp-logo { font-size: 1.15rem; font-weight: 700; }
  .lp-logo span { color: #c5a059; }
  .lp-nav-links { display: none; gap: 1.75rem; font-size: 0.88rem; color: var(--muted); }
  .lp-nav-cta {
    background: var(--accent); color: #fff; border: none; border-radius: 8px;
    padding: 0.6rem 1.3rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;
  }
  .lp-nav-cta:hover { background: var(--accent-dark); }

  @media (min-width: 860px) {
    .lp-nav-links { display: flex; }
  }

  /* ── HERO SECTION ── */
  .lp-hero {
    display: grid; grid-template-columns: 1fr; gap: 2.5rem;
    max-width: 1180px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem;
  }
  @media (min-width: 960px) {
    .lp-hero { grid-template-columns: 1.05fr 1fr; padding: 3.5rem 2rem 5rem; }
  }

  .lp-badge {
    display: inline-block; background: #eef6fb; color: var(--accent);
    font-size: 0.78rem; font-weight: 600; padding: 0.35rem 0.85rem;
    border-radius: 20px; margin-bottom: 1.1rem;
  }
  .lp-headline { font-size: 2rem; font-weight: 700; line-height: 1.3; margin-bottom: 1rem; }
  @media (min-width: 640px) { .lp-headline { font-size: 2.4rem; } }
  .lp-sub { font-size: 1rem; color: var(--muted); line-height: 1.7; margin-bottom: 1.8rem; max-width: 480px; }

  .lp-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-bottom: 1.8rem; max-width: 480px; }
  .lp-stat { border: 1px solid var(--border); border-radius: 12px; padding: 0.85rem; text-align: center; }
  .lp-stat-num { font-size: 1.25rem; font-weight: 700; }
  .lp-stat-label { font-size: 0.7rem; color: var(--faint); margin-top: 0.2rem; }

  .lp-testimonial { border: 1px solid var(--border); border-radius: 14px; padding: 1.1rem 1.3rem; max-width: 480px; }
  .lp-stars { color: #f5b301; font-size: 0.85rem; margin-bottom: 0.5rem; }
  .lp-quote { font-size: 0.85rem; color: var(--muted); font-style: italic; line-height: 1.65; margin-bottom: 0.6rem; }
  .lp-author { display: flex; align-items: center; gap: 0.6rem; }
  .lp-author-badge {
    width: 32px; height: 32px; border-radius: 50%; background: var(--accent);
    color: #fff; font-size: 0.75rem; font-weight: 700; display: flex;
    align-items: center; justify-content: center; flex-shrink: 0;
  }
  .lp-author-name { font-size: 0.83rem; font-weight: 600; }
  .lp-author-role { font-size: 0.74rem; color: var(--faint); }

  /* ── ORDER FORM CARD WRAPPER ── */
  .lp-form-card { align-self: start; }

  /* ── FEATURE STRIP ── */
  .lp-features {
    max-width: 1180px; margin: 0 auto; padding: 0 1.5rem 4rem;
    display: grid; grid-template-columns: 1fr; gap: 0.9rem;
  }
  @media (min-width: 720px) { .lp-features { grid-template-columns: repeat(3, 1fr); } }
  .lp-feature { border: 1px solid var(--border); border-radius: 12px; padding: 1.2rem; }
  .lp-feature-title { font-weight: 700; font-size: 0.92rem; margin-bottom: 0.3rem; }
  .lp-feature-text { font-size: 0.83rem; color: var(--muted); line-height: 1.6; }

  /* ── FOOTER ── */
  .lp-footer {
    border-top: 1px solid var(--border); padding: 1.5rem 2rem;
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
    text-align: center;
  }
  .lp-footer-email { font-size: 0.8rem; color: var(--faint); }
  .lp-footer-email a { color: var(--accent); font-weight: 500; }
  .lp-footer-copy { font-size: 0.74rem; color: var(--faint); }
</style>

<!-- NAV -->
<nav class="lp-nav">
  <a href={`${base}/`} class="lp-logo">Thesis<span>Arc</span>Pro</a>
  <div class="lp-nav-links">
    <span>Services</span>
    <span>How It Works</span>
    <span>Writers</span>
  </div>
  <a href={`${base}/login/`}><button class="lp-nav-cta">Log In</button></a>
</nav>

<!-- HERO + FORM -->
<section class="lp-hero">
  <div>
    <span class="lp-badge">Trusted by 1,200+ graduate students</span>
    <h1 class="lp-headline">Get expert academic help, matched to your exact assignment</h1>
    <p class="lp-sub">Tell us what you need — we'll match you with a vetted subject-matter consultant in minutes. Your payment stays protected until you approve the final work.</p>

    <div class="lp-stats">
      <div class="lp-stat">
        <div class="lp-stat-num">1,200+</div>
        <div class="lp-stat-label">Papers delivered</div>
      </div>
      <div class="lp-stat">
        <div class="lp-stat-num">48hr</div>
        <div class="lp-stat-label">Avg turnaround</div>
      </div>
      <div class="lp-stat">
        <div class="lp-stat-num">4.9/5</div>
        <div class="lp-stat-label">Client rating</div>
      </div>
    </div>

    <div class="lp-testimonial">
      <div class="lp-stars">★★★★★</div>
      <p class="lp-quote">"Helped me finish my dissertation when I was completely overwhelmed. Passed my defence with distinction."</p>
      <div class="lp-author">
        <div class="lp-author-badge">SM</div>
        <div>
          <div class="lp-author-name">Sarah M.</div>
          <div class="lp-author-role">PhD Student</div>
        </div>
      </div>
    </div>
  </div>

  <div class="lp-form-card">
    <!-- Simplified single-view form. On submit it stores the order
         in sessionStorage and redirects to /signup/ instead of hitting Supabase -->
    {/* <SimpleOrderForm /> */}
  </div>
</section>

<!-- FEATURE STRIP -->
<section class="lp-features">
  <div class="lp-feature">
    <div class="lp-feature-title">APA / MLA / Harvard</div>
    <div class="lp-feature-text">Every major citation style, free and included on every order.</div>
  </div>
  <div class="lp-feature">
    <div class="lp-feature-title">Payment protection</div>
    <div class="lp-feature-text">Funds held in your account until you approve the delivered work.</div>
  </div>
  <div class="lp-feature">
    <div class="lp-feature-title">Vetted consultants</div>
    <div class="lp-feature-text">5+ years of academic writing experience, verified before joining.</div>
  </div>
</section>

<!-- FOOTER -->
<footer class="lp-footer">
  <div class="lp-footer-email">Prefer email? <a href="mailto:support@thesisarcpro.com">support@thesisarcpro.com</a></div>
  <div class="lp-footer-copy">© {new Date().getFullYear()} ThesisArcPro. All rights reserved.</div>
</footer>

</BaseLayout>