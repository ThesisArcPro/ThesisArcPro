---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout 
  title="Login" 
  description="Login to your ThesisArcPro account to place orders and track your academic writing projects."
  url="https://thesisarcpro.github.io/login">
  <Header />

  <main>
    <section class="auth-section">
      <div class="auth__inner">

        <div class="auth-col auth-form-col">
          <div class="auth-card__header">
            <h1>Log in to your account</h1>
            <p>Don't have an account? <a href="/signup/">Sign up</a></p>
          </div>

          <div id="errorMsg" class="auth-error" style="display:none;"></div>

          <div class="oauth-group">
            <button type="button" class="oauth-btn" id="googleBtn">
              <svg viewBox="0 0 48 48" width="18" height="18">
                <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.1 8 3l5.7-5.7C34.6 6 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"/>
                <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.6 18.9 12 24 12c3.1 0 5.9 1.1 8 3l5.7-5.7C34.6 6 29.6 4 24 4 16.3 4 9.6 8.3 6.3 14.7z"/>
                <path fill="#4CAF50" d="M24 44c5.5 0 10.4-1.9 14.2-5.1l-6.6-5.4C29.5 35.4 26.9 36 24 36c-5.3 0-9.7-3.3-11.3-8l-6.6 5.1C9.5 39.6 16.2 44 24 44z"/>
                <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.7l6.6 5.4C39.9 37 44 31.5 44 24c0-1.3-.1-2.7-.4-3.5z"/>
              </svg>
              Google
            </button>
            <button type="button" class="oauth-btn" id="appleBtn">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="#000">
                <path d="M16.365 1.43c0 1.14-.468 2.226-1.157 3.02-.775.9-2.04 1.593-3.06 1.51-.13-1.11.44-2.28 1.14-3.04.77-.85 2.13-1.49 3.077-1.49zm4.475 16.99c-.44 1.02-.65 1.47-1.21 2.36-.79 1.26-1.9 2.82-3.29 2.83-1.23.02-1.55-.8-3.22-.79-1.68.01-2.03.81-3.26.79-1.39-.02-2.44-1.42-3.24-2.68-2.22-3.49-2.45-7.57-1.08-9.75.97-1.55 2.52-2.46 3.98-2.46 1.48 0 2.42.82 3.65.82 1.19 0 1.93-.83 3.65-.83 1.3 0 2.68.71 3.66 1.94-3.22 1.77-2.7 6.37.36 7.77z"/>
              </svg>
              Apple
            </button>
          </div>

          <div class="divider"><span>or</span></div>

          <form class="auth-form" id="loginForm">
            <div class="form-group">
              <label for="email">Email address</label>
              <input type="email" id="email" placeholder="Enter your email" required />
            </div>

            <div class="form-group">
              <label for="password">Password</label>
              <div class="password-wrap">
                <input type="password" id="password" placeholder="Enter your password" required />
                <button type="button" class="toggle-password" id="togglePassword" aria-label="Show password">
                  <svg id="eyeIcon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </button>
              </div>
              <a href="/forgot-password/" class="forgot-link">Forgot your password?</a>
            </div>

            <button type="submit" class="btn-login auth-submit" id="submitBtn">
              Log in
            </button>

            <p class="auth-terms">
              By clicking 'Log in', you agree to our <a href="/terms/">Terms and Conditions</a> and <a href="/privacy/">Privacy Policy</a>.
            </p>
          </form>
        </div>

        <div class="auth-col auth-benefits">
          <h2>Enhance your grades with our experts' help</h2>
          <div class="benefit">
            <span class="benefit-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#807ee7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 12h-5"/><path d="M15 8h-5"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/><path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"/></svg>
            </span>
            <div>
              <h3>Human-crafted papers</h3>
              <p>Our papers are crafted by verified experts, avoiding AI use, ensuring each page is written from scratch.</p>
            </div>
          </div>
          <div class="benefit">
            <span class="benefit-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0008fa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/></svg>
            </span>
            <div>
              <h3>Personal approach</h3>
              <p>We create a unique, one-of-a-kind paper that meets your goals.</p>
            </div>
          </div>
          <div class="benefit">
            <span class="benefit-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d9bd08" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 15h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 17"/><path d="m7 21 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9"/><path d="m2 16 6 6"/><circle cx="16" cy="9" r="2.9"/><circle cx="6" cy="5" r="3"/></svg>
            </span>
            <div>
              <h3>Payment protection</h3>
              <p>The deposit remains on your balance until your order is ready and you're satisfied.</p>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>
</BaseLayout>

<style>
.auth-section { background-color: #ffffff; min-height: 100vh; }
.auth__inner { display: flex; min-height: 100vh; }

.auth-col { padding: 4rem 4vw; }
.auth-form-col { flex: 1 1 50%; max-width: 620px; display: flex; flex-direction: column; justify-content: center; }

.auth-card__header { margin-bottom: 1.75rem; }
.auth-card__header h1 { color: #1a1f2b; font-size: 1.7rem; font-weight: 700; margin-bottom: 0.5rem; }
.auth-card__header p { color: #6b7280; font-size: 0.9rem; }
.auth-card__header a { color: #2f6fed; font-weight: 600; text-decoration: underline; }

.oauth-group { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem; }
.oauth-btn {
  display: flex; align-items: center; justify-content: center; gap: 0.6rem;
  width: 100%; padding: 0.85rem 1rem;
  border: none; border-radius: 6px;
  background: #e8f0fc; color: #1a1f2b;
  font-family: var(--font-body); font-size: 0.95rem; font-weight: 500;
  cursor: pointer; transition: background 0.2s ease;
}
.oauth-btn:hover { background: #d9e7fb; }

.divider { display: flex; align-items: center; text-align: center; color: #6b7280; font-size: 0.85rem; margin-bottom: 1.5rem; }
.divider::before, .divider::after { content: ''; flex: 1; border-bottom: 1px solid #e2e8f0; }
.divider span { padding: 0 1rem; }

.auth-form { display: flex; flex-direction: column; gap: 1.2rem; }
.form-group { display: flex; flex-direction: column; gap: 0.4rem; position: relative; }
.form-group label { color: #1a1f2b; font-size: 0.9rem; font-weight: 500; }
.form-group input {
  padding: 0.85rem 1rem; border: 1.5px solid #b8d4f5; border-radius: 6px;
  font-family: var(--font-body); font-size: 0.95rem; color: #1a1f2b;
  background-color: #ffffff; transition: border-color 0.3s ease; outline: none; width: 100%;
}
.form-group input:focus { border-color: #2f6fed; box-shadow: 0 0 0 3px rgba(47,111,237,0.12); }
.password-wrap { position: relative; display: flex; align-items: center; }
.password-wrap input { padding-right: 2.75rem; }
.toggle-password {
  position: absolute; right: 0.85rem; background: none; border: none; cursor: pointer;
  color: #9aa4b2; display: flex; align-items: center; padding: 0;
}
.forgot-link { align-self: flex-end; font-size: 0.85rem; color: #2f6fed; text-decoration: underline; margin-top: 0.2rem; }

.btn-login {
  width: 100%; padding: 1rem; font-size: 1rem; border: none; cursor: pointer;
  border-radius: 8px; font-weight: 700; margin-top: 0.5rem;
  background-color: #ffcc00; color: #1a1f2b;
  transition: background 0.2s ease;
}
.btn-login:hover { background-color: #f0c000; }
.auth-terms { text-align: center; color: #9aa4b2; font-size: 0.78rem; margin-top: 0.75rem; }
.auth-terms a { color: #6b7280; text-decoration: underline; }

.auth-error { background: #fdeaea; border: 1px solid #e74c3c; color: #c0392b; padding: 0.8rem 1rem; border-radius: 8px; font-size: 0.9rem; margin-bottom: 1rem; }

.auth-benefits {
  flex: 1 1 50%;
  background: #edf1f9;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.auth-benefits h2 { color: #1a1f2b; font-size: 1.3rem; font-weight: 700; margin-bottom: 1.75rem; line-height: 1.4; max-width: 480px; }
.benefit { display: flex; gap: 1rem; margin-bottom: 1.5rem; max-width: 480px; }
.benefit:last-child { margin-bottom: 0; }
.benefit-icon {
  flex-shrink: 0; width: 42px; height: 42px; border-radius: 8px;
  background: #ffffff; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.benefit-icon svg { display: block; }
.benefit h3 { color: #1a1f2b; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.3rem; }
.benefit p { color: #6b7280; font-size: 0.85rem; line-height: 1.5; }

@media (max-width: 900px) {
  .auth__inner { flex-direction: column; min-height: auto; }
  .auth-benefits { order: -1; }
  .auth-col { max-width: 100%; padding: 2.5rem 6vw; }
}
</style>

<script>
  import { supabase } from '../lib/supabase.js';

  const form = document.getElementById('loginForm');
  const errorMsg = document.getElementById('errorMsg');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const googleBtn = document.getElementById('googleBtn');
  const appleBtn = document.getElementById('appleBtn');
  const togglePassword = document.getElementById('togglePassword');
  const passwordInput = document.getElementById('password') as HTMLInputElement;

  function getRedirect() {
    const params = new URLSearchParams(window.location.search);
    return params.get('redirect') || '/dashboard/';
  }

  togglePassword?.addEventListener('click', () => {
    const isPassword = passwordInput.type === 'password';
    passwordInput.type = isPassword ? 'text' : 'password';
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = passwordInput.value;

    errorMsg!.style.display = 'none';
    submitBtn.textContent = 'Logging in...';
    submitBtn.disabled = true;

    try {
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) throw error;
      window.location.href = getRedirect();
    } catch (error: any) {
      errorMsg!.textContent = error.message || 'Invalid email or password.';
      errorMsg!.style.display = 'block';
      submitBtn.textContent = 'Log in';
      submitBtn.disabled = false;
    }
  });

  googleBtn?.addEventListener('click', async () => {
    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: `${window.location.origin}${getRedirect()}` }
    });
  });

  appleBtn?.addEventListener('click', async () => {
    await supabase.auth.signInWithOAuth({
      provider: 'apple',
      options: { redirectTo: `${window.location.origin}${getRedirect()}` }
    });
  });
</script>