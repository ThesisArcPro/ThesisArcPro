---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const base = '';
---

<BaseLayout title="Order Now - Custom Academic Writing | ThesisArcPro" description="Get a custom essay written by a vetted expert. Free plagiarism report, unlimited revisions, and on-time delivery guaranteed.">
  <Header />

  <main>
    <!-- HERO -->
    <section class="order-hero">
      <div class="container hero-grid">
        <div class="hero-left">

          <!-- Main Heading -->
          <h1>Get your paper written by a real expert</h1>
          
          <!-- Subtext -->
          <p class="hero-sub">Tell us what you need — matched with a qualified writer in minutes, with free revisions and a money-back guarantee.</p>

          <!-- Feature List Row -->
          <div class="hero-features">
            <div class="feature-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-off-icon lucide-shield-off"><path d="m2 2 20 20"/><path d="M5 5a1 1 0 0 0-1 1v7c0 5 3.5 7.5 7.67 8.94a1 1 0 0 0 .67.01c2.35-.82 4.48-1.97 5.9-3.71"/><path d="M9.309 3.652A12.252 12.252 0 0 0 11.24 2.28a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1v7a9.784 9.784 0 0 1-.08 1.264"/></svg>
              <span>AI & Plagiarism Report</span>
            </div>
            <div class="feature-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-repeat-icon lucide-repeat"><path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/></svg>
              <span>Free Revisions</span>
            </div>
            <div class="feature-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock-icon lucide-lock"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>Confidential & Secure</span>
          </div>
          </div>

          <!-- CTAs -->
          <div class="hero-cta-group">
            <a href="#orderForm" class="btn-primary">Start My Order &rarr;</a>
            <a href="/samples" class="btn-secondary">View Samples</a>
          </div>

          <!-- Social Proof Avatars -->
          <div class="social-proof">
            <p class="social-proof__label">Trusted by students from 120+ countries</p>
            <div class="avatar-stack">
              <img src="https://i.pravatar.cc/100?img=32" alt="Student" />
              <img src="https://i.pravatar.cc/100?img=47" alt="Student" />
              <img src="https://i.pravatar.cc/100?img=12" alt="Student" />
              <img src="https://i.pravatar.cc/100?img=68" alt="Student" />
              <div class="avatar-more">+</div>
            </div>
          </div>
        </div>

        <div class="quote-card">
          <div class="quote-card__title">Calculate your price</div>
          <label class="quote-label">Service</label>
          <select class="quote-select" id="qService">
            <option value="Writing" data-base="7">Writing</option>
            <option value="Rewriting" data-base="6">Rewriting</option>
            <option value="Editing" data-base="5">Editing</option>
            <option value="Proofreading" data-base="5">Proofreading</option>
            <option value="Problem solving" data-base="8">Problem solving</option>
            <option value="Calculations" data-base="8">Calculations</option>
            <option value="Review my work" data-base="4">Review my work</option>
          </select>

          <label class="quote-label">Academic level</label>
          <select class="quote-select" id="qLevel">
            <option value="High school" data-add="0">High school</option>
            <option value="College" data-add="1">College</option>
            <option value="Bachelor's" data-add="1">Bachelor's</option>
            <option value="Master's" data-add="2">Master's</option>
            <option value="Doctorate" data-add="3">Doctorate</option>
          </select>

          <label class="quote-label">Pages</label>
          <div class="quote-counter">
            <button type="button" id="qPagesMinus">−</button>
            <span id="qPagesVal">1</span>
            <button type="button" id="qPagesPlus">+</button>
          </div>

          <label class="quote-label">Deadline</label>
          <select class="quote-select" id="qDeadline">
            <option value="3">3 hours</option>
            <option value="6">6 hours</option>
            <option value="12">12 hours</option>
            <option value="24" selected>1 day</option>
            <option value="48">2 days</option>
            <option value="120">5 days</option>
          </select>

          <div class="quote-total-row">
            <span>Estimated price</span>
            <span class="quote-total" id="qTotal">$0.00</span>
          </div>
          <button type="button" class="quote-cta" id="qContinue">Continue to order →</button>
        </div>
      </div>
    </section>

    <!-- MEET OUR WRITERS -->
    <section class="writers-profile-section">
      <div class="container writers-profile-grid">
        <div class="writers-avatar-container" id="writersAvatarStack">
          <img src="https://i.pravatar.cc/150?img=32" alt="Writer Profile 1" class="writer-avatar-lg" />
          <img src="https://i.pravatar.cc/150?img=47" alt="Writer Profile 2" class="writer-avatar-lg" />
          <img src="https://i.pravatar.cc/150?img=12" alt="Writer Profile 3" class="writer-avatar-lg" />
          <img src="https://i.pravatar.cc/150?img=68" alt="Writer Profile 4" class="writer-avatar-lg" />
        </div>
        <div class="writers-content">
          <h2>Meet Our Writers</h2>
          <p>Qualified, subject-matter experts handpicked for your work. Every order is handled by a vetted professional in the relevant field.</p>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="testimonials-section">
      <div class="container">
        <h2 class="testi-title">What our students say</h2>
        <p class="testi-sub">Join students who have achieved academic success with ThesisArcPro</p>
        <div class="testi-grid" id="testiGrid">
          <div class="testi-loading">Loading reviews…</div>
        </div>
        <p class="testi-verified"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px;margin-right:4px;"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg>All reviews are from verified users</p>
      </div>
    </section>

    <!-- OFFER BANNER -->
    <section class="offer-banner">
      <div class="container offer-inner">
        <div class="offer-text">
          <strong>15% off your first order</strong> — automatically applied at checkout, no code needed.
        </div>
        <div class="offer-text offer-secondary">
          Refer a friend and you both get $10 credit toward your next paper.
        </div>
      </div>
    </section>

    <!-- ORDER FORM MODAL -->
    <div class="modal" id="orderForm">
      <div class="modal-overlay" id="orderFormOverlay"></div>
      <div class="modal-box">
        <button class="modal-close" id="orderFormClose">✕</button>
        <div class="order-grid">

        <!-- LEFT: wizard -->
        <div class="order-main">

          <!-- Success state -->
          <div id="ordSuccess" style="display:none;">
            <div class="success-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#1B2A4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-party-popper-icon lucide-party-popper"><path d="M5.8 11.3 2 22l10.7-3.79"/><path d="M4 3h.01"/><path d="M22 8h.01"/><path d="M15 2h.01"/><path d="M22 20h.01"/><path d="m22 2-2.24.75a2.9 2.9 0 0 0-1.96 3.12c.1.86-.57 1.63-1.45 1.63h-.38c-.86 0-1.6.6-1.76 1.44L14 10"/><path d="m22 13-.82-.33c-.86-.34-1.82.2-1.98 1.11c-.11.7-.72 1.22-1.43 1.22H17"/><path d="m11 2 .33.82c.34.86-.2 1.82-1.11 1.98C9.52 4.9 9 5.52 9 6.23V7"/><path d="M11 13c1.93 1.93 2.83 4.17 2 5-.83.83-3.07-.07-5-2-1.93-1.93-2.83-4.17-2-5 .83-.83 3.07.07 5 2Z"/></svg>
            </div>
            <h2>Order received!</h2>
            <p>We're matching you with writers now. Track live proposals below.</p>
            <div class="ticket-box">
              <span class="ticket-label">Your ticket number</span>
              <span class="ticket-id" id="ordTicketId">T-0000</span>
            </div>
          </div>

          <div id="ordStepsFlow">

            <!-- STEP 1: TOPIC -->
            <div class="stack-step" id="o1">
              <div class="step-title"><span class="step-check">✓</span>Topic / title</div>
              <input type="text" class="text-field" id="oTopic" placeholder="Enter your assignment topic or title" style="margin-top:0;" />
              <div class="next-wrap"><button type="button" class="next-btn" id="oNext1">Next</button></div>
            </div>

            <!-- STEP 2: TYPE -->
            <div class="stack-step" id="o2" style="display:none;">
              <div class="step-title"><span class="step-check">✓</span>Assignment type</div>
              <div class="chip-row">
                <span class="chip" data-asgn="Essay (any type)">Essay (any type)</span>
                <span class="chip" data-asgn="Research paper">Research paper</span>
                <span class="chip" data-asgn="Case study">Case study</span>
                <span class="chip" data-asgn="Discussion post">Discussion post</span>
                <span class="chip" data-asgn="Coursework">Coursework</span>
              </div>
              <input type="text" class="text-field" id="oTypeOther" placeholder="Or type your own assignment type" />
              <div class="next-wrap"><button type="button" class="next-btn" id="oNext2" disabled>Next</button></div>
            </div>

            <!-- STEP 3: EDUCATION LEVEL -->
            <div class="stack-step" id="o3" style="display:none;">
              <div class="step-title"><span class="step-check">✓</span>Academic level</div>
              <div class="chip-row">
                <span class="chip" data-lvl="HighSchool" data-step-add="0">High school</span>
                <span class="chip" data-lvl="College" data-step-add="1">College</span>
                <span class="chip" data-lvl="Bachelor" data-step-add="1">Bachelor's</span>
                <span class="chip" data-lvl="Masters" data-step-add="2">Master's</span>
                <span class="chip" data-lvl="PhD" data-step-add="3">Doctorate</span>
              </div>
              <div class="next-wrap"><button type="button" class="next-btn" id="oNext3" disabled>Next</button></div>
            </div>

            <!-- STEP 4: SUBJECT -->
            <div class="stack-step" id="o4" style="display:none;">
              <div class="step-title"><span class="step-check">✓</span>Subject</div>
              <div class="chip-row">
                <span class="chip" data-sub="English & Literature">English</span>
                <span class="chip" data-sub="Psychology">Psychology</span>
                <span class="chip" data-sub="Nursing & Healthcare">Nursing</span>
                <span class="chip" data-sub="Business Management">Business</span>
                <span class="chip" data-sub="History">History</span>
                <span class="chip" data-sub="Law">Law</span>
                <span class="chip" data-sub="Science">Science</span>
              </div>
              <input type="text" class="text-field" id="oSubjectOther" placeholder="Or type your own subject" />
              <div class="next-wrap"><button type="button" class="next-btn" id="oNext4" disabled>Next</button></div>
            </div>

            <!-- STEP 5: SERVICE -->
            <div class="stack-step" id="o5" style="display:none;">
              <div class="step-title"><span class="step-check">✓</span>What do you need?</div>
              <div class="chip-row">
                <span class="chip" data-svc="Writing" data-base="7">Writing</span>
                <span class="chip" data-svc="Rewriting" data-base="6">Rewriting</span>
                <span class="chip" data-svc="Editing" data-base="5">Editing</span>
                <span class="chip" data-svc="Proofreading" data-base="5">Proofreading</span>
                <span class="chip" data-svc="Problem solving" data-base="8">Problem solving</span>
                <span class="chip" data-svc="Calculations" data-base="8">Calculations</span>
                <span class="chip" data-svc="Review my work" data-base="4">Review my work</span>
              </div>
              <div class="next-wrap"><button type="button" class="next-btn" id="oNext5" disabled>Next</button></div>
            </div>

            <!-- STEP 6: LANGUAGE -->
            <div class="stack-step" id="o6" style="display:none;">
              <div class="step-title"><span class="step-check">✓</span>Language</div>
              <div class="chip-row">
                <span class="chip" data-lang="English (US)">English (US)</span>
                <span class="chip" data-lang="English (UK)">English (UK)</span>
              </div>
              <div class="next-wrap"><button type="button" class="next-btn" id="oNext6" disabled>Next</button></div>
            </div>

            <!-- STEP 7: CITATION STYLE -->
            <div class="stack-step" id="o7" style="display:none;">
              <div class="step-title"><span class="step-check">✓</span>Citation style</div>
              <select class="text-field" id="oCitation" style="margin-top:0;">
                <option value="">Not required</option>
                <option>APA 7</option>
                <option>MLA 9</option>
                <option>Chicago</option>
                <option>Harvard</option>
                <option>APA 6</option>
                <option>Turabian</option>
                <option>IEEE</option>
                <option>Vancouver</option>
                <option>Other</option>
              </select>
              <div class="next-wrap"><button type="button" class="next-btn" id="oNext7">Next</button></div>
            </div>

            <!-- STEP 8: SOURCES -->
            <div class="stack-step" id="o8" style="display:none;">
              <div class="step-title"><span class="step-check">✓</span>Sources required</div>
              <input type="number" class="text-field" id="oSources" min="0" max="999" placeholder="e.g. 5" style="margin-top:0;" />
              <div class="next-wrap"><button type="button" class="next-btn" id="oNext8">Next</button></div>
            </div>

            <!-- STEP 9: SIZE -->
            <div class="stack-step" id="o9" style="display:none;">
              <div class="step-title"><span class="step-check">✓</span>Size</div>
              <div class="size-row">
                <div>
                  <div class="mini-label">Pages</div>
                  <div class="counter-row">
                    <button type="button" id="oPagesMinus">−</button>
                    <span class="counter-val" id="oPagesVal">1</span>
                    <button type="button" id="oPagesPlus">+</button>
                  </div>
                  <div class="size-hint" id="oPagesHint">≈ 275 words</div>
                </div>
              </div>
              <div class="next-wrap"><button type="button" class="next-btn" id="oNext9">Next</button></div>
            </div>

            <!-- STEP 10: DEADLINE -->
            <div class="stack-step" id="o10" style="display:none;">
              <div class="step-title"><span class="step-check">✓</span>Deadline</div>
              <div class="date-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4191c3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v3"/><path d="M16 2v3"/><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M8 13h.01"/><path d="M12 13h.01"/><path d="M16 13h.01"/><path d="M8 17h.01"/><path d="M12 17h.01"/><path d="M16 17h.01"/></svg>
                <input type="datetime-local" id="oDeadline" />
              </div>
              <div class="mini-label">Quick pick:</div>
              <div class="chip-row">
                <span class="chip" data-dlh="3">3 hours</span>
                <span class="chip" data-dlh="6">6 hours</span>
                <span class="chip" data-dlh="12">12 hours</span>
                <span class="chip" data-dlh="24">1 day</span>
                <span class="chip" data-dlh="48">2 days</span>
                <span class="chip" data-dlh="120">5 days</span>
              </div>
              <div class="next-wrap"><button type="button" class="next-btn" id="oNext10">Next</button></div>
            </div>

            <!-- STEP 11: DESCRIPTION -->
            <div class="stack-step" id="o11" style="display:none;">
              <div class="step-title"><span class="step-check">✓</span>Description</div>
              <textarea class="text-area" id="oInstructions" placeholder="Describe your assignment. Share references, links, and any other instructions." rows="4"></textarea>
              <div class="next-wrap"><button type="button" class="next-btn" id="oNext11">Next</button></div>
            </div>

            <!-- STEP 12: AUTH GATE -->
            <div class="stack-step" id="o12" style="display:none;">
              <div class="step-title"><span class="step-check">✓</span>Almost done</div>
              <p class="mini-note" style="margin:0 0 12px;">Sign up or log in to post your order and track proposals from writers.</p>
              <div class="next-wrap"><button type="button" class="next-btn" id="oSubmit">Continue to sign up / login →</button></div>
            </div>

          </div>
        </div>

        <!-- RIGHT: summary -->
        <aside class="order-aside">
          <div class="summary-card" id="ordSummaryCard">
            <div class="summary-price" id="ordTotal">$0.00</div>
            <div class="summary-label">Estimated total</div>
            <div class="summary-rows">
              <div class="row"><span>Service</span><span id="sumSvc">—</span></div>
              <div class="row"><span>Level</span><span id="sumLvl">—</span></div>
              <div class="row"><span>Base price</span><span id="sumBase">—</span></div>
              <div class="row"><span>Pages</span><span id="sumPages">x 1</span></div>
              <div class="row" id="sumUrgRow" style="display:none;"><span id="sumUrgLbl">Urgency</span><span id="sumUrg">+$0.00</span></div>
              <div class="row" id="sumDiscRow"><span>First-order discount</span><span id="sumDisc">−15%</span></div>
            </div>
            <div class="summary-benefits">
              <div>✔ Free plagiarism & AI report</div>
              <div>✔ Free unlimited revisions</div>
              <div>✔ On-time delivery guaranteed</div>
              <div>✔ Money-back guarantee</div>
            </div>
          </div>
        </aside>

        </div>
      </div>
    </div>

    <!-- TRUST STRIP -->
    <section class="trust-strip">
      <div class="container trust-grid">
        <div class="trust-item">
          <div class="trust-ico">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#e28d8d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-icon lucide-shield"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
          </div>
          <div><strong>Plagiarism-free</strong><p>Every paper checked before delivery</p></div>
        </div>
        <div class="trust-item">
          <div class="trust-ico">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8084ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-icon lucide-shield"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
          </div>
          <div><strong>Unlimited revisions</strong><p>Free until you're satisfied</p></div>
        </div>
        <div class="trust-item">
          <div class="trust-ico">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0c1017" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-alarm-clock-minus-icon lucide-alarm-clock-minus"><circle cx="12" cy="13" r="8"/><path d="M5 3 2 6"/><path d="m22 6-3-3"/><path d="M6.38 18.7 4 21"/><path d="M17.64 18.67 20 21"/><path d="M9 13h6"/></svg>
          </div>
          <div><strong>On-time delivery</strong><p>Deadlines from 3 hours</p></div>
        </div>
        <div class="trust-item">
          <div class="trust-ico">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#c2bb00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-hand-coins-icon lucide-hand-coins"><path d="M11 15h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 17"/><path d="m7 21 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9"/><path d="m2 16 6 6"/><circle cx="16" cy="9" r="2.9"/><circle cx="6" cy="5" r="3"/></svg>
          </div>
          <div><strong>Money-back guarantee</strong><p>Refund if we don't deliver</p></div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="order-faq">
      <div class="container">
        <h2 class="faq-title">FAQ</h2>
        <div class="faq-grid">
          <button class="faq-item" data-faq="1">
            <div class="faq-q"><span>How fast can I get my paper?</span><span class="faq-icon">+</span></div>
            <div class="faq-a">Deadlines start from 3 hours for shorter assignments. Choose your deadline in the order form and we'll match you with writers who can deliver in time.</div>
          </button>
          <button class="faq-item" data-faq="2">
            <div class="faq-q"><span>What if I'm not happy with the result?</span><span class="faq-icon">+</span></div>
            <div class="faq-a">You get free unlimited revisions. If it still doesn't meet your requirements, our money-back guarantee applies.</div>
          </button>
          <button class="faq-item" data-faq="3">
            <div class="faq-q"><span>Is my information kept private?</span><span class="faq-icon">+</span></div>
            <div class="faq-a">Yes. We never share your personal details with writers or third parties — communication happens through your dashboard with a client ID, not your name.</div>
          </button>
          <button class="faq-item" data-faq="4">
            <div class="faq-q"><span>How does pricing work?</span><span class="faq-icon">+</span></div>
            <div class="faq-a">Price depends on service type, academic level, page count, and deadline urgency. You'll see the exact total before you pay — no hidden fees.</div>
          </button>
          <button class="faq-item" data-faq="5">
            <div class="faq-q"><span>Can I choose my writer?</span><span class="faq-icon">+</span></div>
