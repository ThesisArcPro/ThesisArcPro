<script>
  import { supabase } from '../lib/supabase.js';
  import { io } from 'socket.io-client';
  const base = '';
  const socket = io('https://thesisarcpro.onrender.com', { transports: ['websocket'] });
  const SUPABASE_URL = 'https://rehvwvujuamehoanfomj.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_CKxnbue4T6cVn9BOIg8BkQ_kBNBiM_h';
  const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxVL-dECKrdcEyyJObsP9KCQnRJ_TnmTT7qB6rvx-89cSmDbGIUKzviUAX83wPkYtZWzg/exec';

  const state = { service: '', base: 0, subject: '', type: '', levelAdd: 0, levelLabel: '', pages: 1, deadline: '', instructions: '', email: '', topic: '', citation: '', sources: '', language: '' };
  let total = 0;
  let qPages = 1;

  function $(id: string) { return document.getElementById(id); }
  function enableNext(id: string) { const b = $(id) as HTMLButtonElement; if (b) b.disabled = false; }

  function reveal(n: number) {
    const el = $(`o${n}`);
    if (el) el.style.display = 'block';
    if (n >= 4) updateSummary();
    setTimeout(() => el?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 80);
  }
  function markDone(n: number) { const chk = document.querySelector(`#o${n} .step-check`) as HTMLElement; if (chk) chk.style.display = 'inline-flex'; }

  function updateSummary() {
    const rate = state.base ? state.base + state.levelAdd : 0;
    let urgencyPerPage = 0, urgencyText = '';
    if (state.deadline) {
      const h = (new Date(state.deadline).getTime() - Date.now()) / 3600000;
      if (h < 6) { urgencyPerPage = rate * 0.5; urgencyText = '🔴 Rush: +50%'; }
      else if (h < 12) { urgencyPerPage = rate * 0.3; urgencyText = '🟠 Urgent: +30%'; }
      else if (h < 24) { urgencyPerPage = rate * 0.2; urgencyText = '🟡 Same day: +20%'; }
      else if (h < 48) { urgencyPerPage = rate * 0.1; urgencyText = '🟢 Standard: +10%'; }
    }
    const baseTotal = rate * state.pages;
    const urgencyTotal = urgencyPerPage * state.pages;
    const subtotal = baseTotal + urgencyTotal;
    total = subtotal * 0.85;

    const set = (id: string, v: string) => { const e = $(id); if (e) e.textContent = v; };
    set('sumSvc', state.service || '—');
    set('sumLvl', state.levelLabel || '—');
    set('sumBase', rate ? `$${rate.toFixed(2)}/pg` : '—');
    set('sumPages', `x ${state.pages}`);
    set('ordTotal', `$${total.toFixed(2)}`);
    const uRow = $('sumUrgRow'); if (uRow) (uRow as HTMLElement).style.display = urgencyTotal > 0 ? 'flex' : 'none';
    set('sumUrgLbl', urgencyText.split(':')[0] || 'Urgency');
    set('sumUrg', `+$${urgencyTotal.toFixed(2)}`);
  }

  // STEP 1: TOPIC
  $('oNext1')?.addEventListener('click', () => {
    const val = (($('oTopic') as HTMLInputElement)).value.trim();
    if (!val) { alert('Please enter a topic or title.'); return; }
    state.topic = val;
    markDone(1); reveal(2);
  });

  // STEP 2: TYPE
  document.querySelectorAll('.chip[data-asgn]').forEach(c => c.addEventListener('click', () => {
    document.querySelectorAll('.chip[data-asgn]').forEach(x => x.classList.remove('sel'));
    c.classList.add('sel');
    state.type = (c as HTMLElement).dataset.asgn || '';
    (($('oTypeOther') as HTMLInputElement)).value = '';
    enableNext('oNext2');
  }));
  $('oTypeOther')?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value.trim();
    state.type = val;
    document.querySelectorAll('.chip[data-asgn]').forEach(x => x.classList.remove('sel'));
    const b = $('oNext2') as HTMLButtonElement; if (b) b.disabled = !val;
  });
  $('oNext2')?.addEventListener('click', () => { markDone(2); reveal(3); });

  // STEP 3: LEVEL
  document.querySelectorAll('.chip[data-lvl]').forEach(c => c.addEventListener('click', () => {
    document.querySelectorAll('.chip[data-lvl]').forEach(x => x.classList.remove('sel'));
    c.classList.add('sel');
    state.levelAdd = parseInt((c as HTMLElement).dataset.stepAdd || '0');
    state.levelLabel = c.textContent?.trim() || '';
    enableNext('oNext3');
  }));
  $('oNext3')?.addEventListener('click', () => { markDone(3); reveal(4); });

  // STEP 4: SUBJECT
  document.querySelectorAll('.chip[data-sub]').forEach(c => c.addEventListener('click', () => {
    document.querySelectorAll('.chip[data-sub]').forEach(x => x.classList.remove('sel'));
    c.classList.add('sel');
    state.subject = (c as HTMLElement).dataset.sub || '';
    (($('oSubjectOther') as HTMLInputElement)).value = '';
    enableNext('oNext4');
  }));
  $('oSubjectOther')?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value.trim();
    state.subject = val;
    document.querySelectorAll('.chip[data-sub]').forEach(x => x.classList.remove('sel'));
    const b = $('oNext4') as HTMLButtonElement; if (b) b.disabled = !val;
  });
  $('oNext4')?.addEventListener('click', () => { markDone(4); reveal(5); });

  // STEP 5: SERVICE
  document.querySelectorAll('.chip[data-svc]').forEach(c => c.addEventListener('click', () => {
    document.querySelectorAll('.chip[data-svc]').forEach(x => x.classList.remove('sel'));
    c.classList.add('sel');
    state.service = (c as HTMLElement).dataset.svc || '';
    state.base = parseFloat((c as HTMLElement).dataset.base || '0');
    enableNext('oNext5');
  }));
  $('oNext5')?.addEventListener('click', () => { markDone(5); reveal(6); });

  // STEP 6: LANGUAGE
  document.querySelectorAll('.chip[data-lang]').forEach(c => c.addEventListener('click', () => {
    document.querySelectorAll('.chip[data-lang]').forEach(x => x.classList.remove('sel'));
    c.classList.add('sel');
    state.language = (c as HTMLElement).dataset.lang || '';
    enableNext('oNext6');
  }));
  $('oNext6')?.addEventListener('click', () => { markDone(6); reveal(7); });

  // STEP 7: CITATION
  $('oNext7')?.addEventListener('click', () => {
    state.citation = (($('oCitation') as HTMLSelectElement))?.value || '';
    markDone(7); reveal(8);
  });

  // STEP 8: SOURCES
  $('oNext8')?.addEventListener('click', () => {
    state.sources = (($('oSources') as HTMLInputElement))?.value || '';
    markDone(8); reveal(9);
  });

  // STEP 9: SIZE
  $('oPagesMinus')?.addEventListener('click', () => {
    state.pages = Math.max(1, state.pages - 1);
    const v = $('oPagesVal'); if (v) v.textContent = String(state.pages);
    const h = $('oPagesHint'); if (h) h.textContent = `≈ ${state.pages * 275} words`;
    updateSummary();
  });
  $('oPagesPlus')?.addEventListener('click', () => {
    state.pages = Math.min(500, state.pages + 1);
    const v = $('oPagesVal'); if (v) v.textContent = String(state.pages);
    const h = $('oPagesHint'); if (h) h.textContent = `≈ ${state.pages * 275} words`;
    updateSummary();
  });
  $('oNext9')?.addEventListener('click', () => { markDone(9); reveal(10); });

  // STEP 10: DEADLINE
  document.querySelectorAll('.chip[data-dlh]').forEach(c => c.addEventListener('click', () => {
    document.querySelectorAll('.chip[data-dlh]').forEach(x => x.classList.remove('sel'));
    c.classList.add('sel');
    const hours = parseInt((c as HTMLElement).dataset.dlh || '0');
    const d = new Date(); d.setHours(d.getHours() + hours);
    state.deadline = new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    (($('oDeadline') as HTMLInputElement)).value = state.deadline;
    updateSummary();
  }));
  $('oDeadline')?.addEventListener('change', (e) => { state.deadline = (e.target as HTMLInputElement).value; updateSummary(); });
  $('oNext10')?.addEventListener('click', () => {
    if (!state.deadline) { alert('Please choose a deadline.'); return; }
    markDone(10); reveal(11);
  });

  // STEP 11: DESCRIPTION
  $('oNext11')?.addEventListener('click', () => {
    const instr = (($('oInstructions') as HTMLTextAreaElement)).value.trim();
    if (!instr) { alert('Please add your instructions.'); return; }
    state.instructions = instr;
    markDone(11); reveal(12);
  });

  // STEP 12: AUTH
  $('oSubmit')?.addEventListener('click', () => {
    localStorage.setItem('pendingOrderDraft', JSON.stringify(state));
    window.location.href = `${base}/login/?redirect=/order/`;
  });

  (async function checkPendingDraft() {
    const draft = localStorage.getItem('pendingOrderDraft');
    if (!draft) return;
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    let d: any;
    try { d = JSON.parse(draft); } catch { localStorage.removeItem('pendingOrderDraft'); return; }

    const email = session.user.email || '';
    const ticketId = `T-${Date.now().toString().slice(-6)}`;
    const rate = d.base ? d.base + (d.levelAdd || 0) : 0;
    const orderTotal = rate * d.pages * 0.85;

    try {
      await fetch(APPS_SCRIPT_URL, {
        method: 'POST', mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ clientEmail: email, topic: d.topic || (d.instructions || '').slice(0, 60), assignmentType: d.type, subject: d.subject, service: d.service, level: d.levelLabel, pages: d.pages, deadline: d.deadline, totalPrice: `$${orderTotal.toFixed(2)}`, instructions: d.instructions, ticketId })
      });

      const insertRes = await fetch(`${SUPABASE_URL}/rest/v1/orders`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${session.access_token}`, Prefer: 'return=representation' },
        body: JSON.stringify({ order_number: ticketId, client_email: email, topic: d.topic || (d.instructions || '').slice(0, 60), assignment_type: d.type, subject: d.subject, service: d.service, education_level: d.levelLabel, pages: d.pages, deadline: d.deadline, total_amount: orderTotal, amount_paid: 0, payment_status: 'Pending', order_status: 'open_for_bids', instructions: d.instructions })
      });
      const inserted = await insertRes.json();
      const newOrderDbId = inserted[0]?.id;

      socket.emit('order:new', { id: ticketId, order_number: ticketId, topic: d.topic || (d.instructions || '').slice(0, 60), assignment_type: d.type, subject: d.subject, pages: d.pages, deadline: d.deadline, total_amount: orderTotal, order_status: 'open_for_bids' });

      localStorage.removeItem('pendingOrderDraft');
      if (newOrderDbId) localStorage.setItem('wizPendingOrderId', String(newOrderDbId));
      window.location.href = `${base}/dashboard/`;
    } catch (err) {
      console.error('Failed to post order from landing page draft', err);
    }
  })();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });

  const qBase: Record<string, number> = {};
  document.querySelectorAll('#qService option').forEach(o => { qBase[(o as HTMLOptionElement).value] = parseFloat((o as HTMLOptionElement).dataset.base || '0'); });
  const qLevelAdd: Record<string, number> = {};
  document.querySelectorAll('#qLevel option').forEach(o => { qLevelAdd[(o as HTMLOptionElement).value] = parseInt((o as HTMLOptionElement).dataset.add || '0'); });

  function updateQuote() {
    const svc = ($('qService') as HTMLSelectElement).value;
    const lvl = ($('qLevel') as HTMLSelectElement).value;
    const hours = parseInt(($('qDeadline') as HTMLSelectElement).value);
    const rate = (qBase[svc] || 0) + (qLevelAdd[lvl] || 0);
    let urgencyPct = 0;
    if (hours < 6) urgencyPct = 0.5;
    else if (hours < 12) urgencyPct = 0.3;
    else if (hours < 24) urgencyPct = 0.2;
    else if (hours < 48) urgencyPct = 0.1;
    const subtotal = rate * qPages * (1 + urgencyPct);
    const t = subtotal * 0.85;
    const el = $('qTotal'); if (el) el.textContent = `$${t.toFixed(2)}`;
  }
  $('qService')?.addEventListener('change', updateQuote);
  $('qLevel')?.addEventListener('change', updateQuote);
  $('qDeadline')?.addEventListener('change', updateQuote);
  $('qPagesMinus')?.addEventListener('click', () => { qPages = Math.max(1, qPages - 1); ($('qPagesVal') as HTMLElement).textContent = String(qPages); updateQuote(); });
  $('qPagesPlus')?.addEventListener('click', () => { qPages = Math.min(500, qPages + 1); ($('qPagesVal') as HTMLElement).textContent = String(qPages); updateQuote(); });
  updateQuote();

  function revealOrderForm() {
    const modal = $('orderForm');
    modal?.classList.add('open');
  }
  function closeOrderForm() {
    const modal = $('orderForm');
    modal?.classList.remove('open');
  }
  $('orderFormClose')?.addEventListener('click', closeOrderForm);
  $('orderFormOverlay')?.addEventListener('click', closeOrderForm);

  $('qContinue')?.addEventListener('click', () => {
    revealOrderForm();
  });

  document.querySelectorAll('.hero-cta-group .btn-primary, .cta-btn, .promo-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      revealOrderForm();
    });
  });

  updateSummary();

  async function loadStatsAndTestimonials() {
    try {
      const wRes = await fetch(`${SUPABASE_URL}/rest/v1/writers?is_active=eq.true&select=id,on_time_percentage,rating`, { headers: { apikey: SUPABASE_KEY } });
      const writers = await wRes.json();
      const activeCount = Array.isArray(writers) ? writers.length : 0;
      const ontimeVals = writers.filter((w: any) => w.on_time_percentage != null).map((w: any) => w.on_time_percentage);
      const avgOntime = ontimeVals.length ? Math.round(ontimeVals.reduce((a: number, b: number) => a + b, 0) / ontimeVals.length) : null;
      const ratingVals = writers.filter((w: any) => w.rating != null).map((w: any) => Number(w.rating));
      const avgRating = ratingVals.length ? (ratingVals.reduce((a: number, b: number) => a + b, 0) / ratingVals.length) : null;

      const rRes = await fetch(`${SUPABASE_URL}/rest/v1/reviews?select=rating,review_text,client_id,created_at&order=created_at.desc&limit=50`, { headers: { apikey: SUPABASE_KEY } });
      const reviews = await rRes.json();
      const reviewCount = Array.isArray(reviews) ? reviews.length : 0;

      const set = (id: string, v: string) => { const e = document.getElementById(id); if (e) e.textContent = v; };
      set('statWriters', String(activeCount));
      set('statRating', avgRating != null ? avgRating.toFixed(1) : '—');
      set('statReviews', String(reviewCount));
      set('statOntime', avgOntime != null ? `${avgOntime}%` : '—');

      const grid = document.getElementById('testiGrid');
      if (!grid) return;
      const withText = (reviews || []).filter((r: any) => r.review_text).slice(0, 6);
      if (!withText.length) { grid.innerHTML = '<div class="testi-loading">No reviews yet.</div>'; return; }
      grid.innerHTML = withText.map((r: any) => {
        const stars = '★'.repeat(Math.round(r.rating || 5)) + '☆'.repeat(5 - Math.round(r.rating || 5));
        const date = r.created_at ? new Date(r.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
        const label = r.client_id ? `Customer #${r.client_id}` : 'Verified customer';
        return `
          <div class="testi-card">
            <div class="testi-stars">${stars}</div>
            <p class="testi-text">${(r.review_text || '').replace(/</g, '&lt;')}</p>
            <div class="testi-who">
              <div class="testi-avatar">CU</div>
              <div>
                <div class="testi-name">${label}</div>
                <div class="testi-date">${date}</div>
              </div>
            </div>
          </div>
        `;
      }).join('');
    } catch (err) {
      console.error('loadStatsAndTestimonials error', err);
    }
  }
  loadStatsAndTestimonials();
</script>