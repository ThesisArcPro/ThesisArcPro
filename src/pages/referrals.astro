---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Refer a Friend"
  description="Refer a friend to ThesisArcPro and earn rewards for every completed order."
  url="https://thesisarcpro.github.io/referrals">
  <Header />

  <main>
    <section class="refer-section">
      <div class="container">

        <div class="refer-hero">
          <h1>Refer a Friend. Get <span id="rewardAmount">$34.70</span></h1>
          <p>Bring your friend over to ThesisArcPro! We'll add <span id="rewardAmountInline">$34.70</span> to your balance for every friend who completes an order. Each friend gets 10% off their first order, too!</p>
        </div>

        <div id="authGate" class="refer-card" style="display:none;">
          <p>Please <a href="/login/?redirect=/referrals/">log in</a> to see your referral link.</p>
        </div>

        <div id="referContent" style="display:none;">
          <div class="refer-card">
            <h3>Share your unique link</h3>
            <div class="link-row">
              <input type="text" id="referralLink" readonly />
              <button type="button" id="copyBtn" class="btn-copy" aria-label="Copy link">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>

            <div class="share-row">
              <a id="shareWhatsapp" href="#" target="_blank" rel="noopener noreferrer" class="share-btn share-btn--whatsapp">
                Message It!
              </a>
              <a id="shareFacebook" href="#" target="_blank" rel="noopener noreferrer" class="share-btn share-btn--facebook">
                Post It!
              </a>
              <a id="shareTwitter" href="#" target="_blank" rel="noopener noreferrer" class="share-btn share-btn--twitter">
                Share It!
              </a>
            </div>
          </div>

          <div class="stats-grid">
            <div class="stat-card">
              <span class="stat-value" id="statSent">0</span>
              <span class="stat-label">Referrals sent</span>
            </div>
            <div class="stat-card">
              <span class="stat-value" id="statCompleted">0</span>
              <span class="stat-label">Referrals completed</span>
            </div>
            <div class="stat-card stat-card--highlight">
              <span class="stat-value" id="statEarned">$0.00</span>
              <span class="stat-label">You've earned</span>
            </div>
          </div>

          <div class="refer-card how-it-works">
            <h3>How it works?</h3>
            <p>You can get <span id="rewardAmountHow">$34.70</span> on your ThesisArcPro balance for every friend you refer to us. It's a good way to help someone. Use your earnings next time you place an order.</p>

            <h4>What should I do?</h4>
            <p>Copy the link above. Share it via your messengers, social network accounts or email. When someone signs up using your link, they save 10% on their first order.</p>

            <h4>When will I get my reward?</h4>
            <p>Once we confirm your referral completed their first order, you'll get a top-up to your balance. Track your results right here on this page.</p>
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
.refer-section { padding: 8rem 0 5rem; background-color: var(--off-white); min-height: 100vh; }
.refer-hero { text-align: center; max-width: 640px; margin: 0 auto 2.5rem; }
.refer-hero h1 { color: var(--navy); font-size: 2rem; margin-bottom: 1rem; }
.refer-hero h1 span { color: var(--gold); }
.refer-hero p { color: var(--text-mid); line-height: 1.6; }

.refer-card {
  background: var(--white); border-radius: 16px; padding: 2rem;
  box-shadow: 0 4px 24px rgba(0,0,0,0.06); max-width: 640px; margin: 0 auto 1.5rem;
}
.refer-card h3 { color: var(--navy); font-size: 1.1rem; margin-bottom: 1rem; }

.link-row { display: flex; gap: 0.6rem; margin-bottom: 1.25rem; }
.link-row input {
  flex: 1; padding: 0.85rem 1rem; border: 1.5px solid rgba(0,0,0,0.12);
  border-radius: 6px; font-family: var(--font-body); font-size: 0.9rem;
  color: var(--text-dark); background: var(--off-white);
}
.btn-copy {
  flex-shrink: 0; width: 46px; border-radius: 6px; border: none; cursor: pointer;
  background: var(--navy); color: var(--white); display: flex; align-items: center; justify-content: center;
  transition: background 0.2s ease;
}
.btn-copy:hover { background: #14213d; }
.btn-copy.copied { background: #2ecc71; }

.share-row { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.share-btn {
  flex: 1; min-width: 130px; text-align: center; padding: 0.75rem 1rem;
  border-radius: 8px; font-weight: 700; font-size: 0.9rem; color: var(--white);
  text-decoration: none; transition: opacity 0.2s ease;
}
.share-btn:hover { opacity: 0.9; }
.share-btn--whatsapp { background: #25D366; }
.share-btn--facebook { background: #1877F2; }
.share-btn--twitter { background: #000000; }

.stats-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
  max-width: 640px; margin: 0 auto 1.5rem;
}
.stat-card {
  background: var(--white); border-radius: 12px; padding: 1.5rem 1rem; text-align: center;
  box-shadow: 0 4px 24px rgba(0,0,0,0.06);
}
.stat-card--highlight { background: var(--navy); }
.stat-value { display: block; font-size: 1.5rem; font-weight: 700; color: var(--navy); margin-bottom: 0.4rem; }
.stat-card--highlight .stat-value { color: var(--gold); }
.stat-label { font-size: 0.8rem; color: var(--text-mid); }
.stat-card--highlight .stat-label { color: rgba(255,255,255,0.7); }

.how-it-works h4 { color: var(--navy); font-size: 0.95rem; margin: 1.25rem 0 0.4rem; }
.how-it-works p { color: var(--text-mid); font-size: 0.9rem; line-height: 1.6; margin: 0; }

@media (max-width: 600px) {
  .stats-grid { grid-template-columns: 1fr; }
  .share-row { flex-direction: column; }
}
</style>

<script>
  import { supabase } from '../lib/supabase.js';

  const REWARD_AMOUNT = 34.70; // keep in sync with the schema's default reward_amount

  async function init() {
    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
      document.getElementById('authGate')!.style.display = 'block';
      return;
    }

    document.getElementById('referContent')!.style.display = 'block';

    // Get this user's referral code
    const { data: codeRow } = await supabase
      .from('referral_codes')
      .select('code')
      .eq('user_id', user.id)
      .maybeSingle();

    const code = codeRow?.code ?? '';
    const referralLink = `${window.location.origin}/?ref=${code}`;

    const linkInput = document.getElementById('referralLink') as HTMLInputElement;
    linkInput.value = referralLink;

    // Share buttons
    const shareText = `Check out ThesisArcPro — sign up with my link and get 10% off your first order!`;
    (document.getElementById('shareWhatsapp') as HTMLAnchorElement).href =
      `https://wa.me/?text=${encodeURIComponent(shareText + ' ' + referralLink)}`;
    (document.getElementById('shareFacebook') as HTMLAnchorElement).href =
      `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(referralLink)}`;
    (document.getElementById('shareTwitter') as HTMLAnchorElement).href =
      `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(referralLink)}`;

    // Copy button
    const copyBtn = document.getElementById('copyBtn')!;
    copyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(referralLink);
      copyBtn.classList.add('copied');
      setTimeout(() => copyBtn.classList.remove('copied'), 1500);
    });

    // Stats
    const { data: referrals } = await supabase
      .from('referrals')
      .select('status, reward_amount')
      .eq('referrer_id', user.id);

    const sent = referrals?.length ?? 0;
    const completed = referrals?.filter(r => r.status === 'completed').length ?? 0;
    const earned = referrals
      ?.filter(r => r.status === 'completed')
      .reduce((sum, r) => sum + Number(r.reward_amount), 0) ?? 0;

    document.getElementById('statSent')!.textContent = String(sent);
    document.getElementById('statCompleted')!.textContent = String(completed);
    document.getElementById('statEarned')!.textContent = `$${earned.toFixed(2)}`;
  }

  init();
</script>