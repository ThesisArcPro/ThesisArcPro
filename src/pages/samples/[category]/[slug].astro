  }
  .essay-body :global(h2) {
    background: #F7F5F0;
    border-radius: 12px 12px 0 0;
    padding: 20px 24px 4px;
    margin: 32px 0 0;
    font-size: 18px;
    font-weight: 700;
    color: #1B2A4A;
    font-family: system-ui, sans-serif;
    text-align: left;
    border-bottom: none;
  }
  .essay-body :global(h2) ~ :global(p) {
    background: #F7F5F0;
    padding: 4px 24px;
    margin: 0;
    text-align: left;
    font-size: 13px;
  }
