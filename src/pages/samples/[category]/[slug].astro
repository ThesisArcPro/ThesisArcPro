    position: absolute; top: 12px; right: 16px; background: none; border: none;
    font-size: 22px; color: #9ca3af; cursor: pointer; line-height: 1;
  }
  .modal-icon { font-size: 32px; color: #C5A059; margin-bottom: 12px; }
  .modal-title { font-size: 18px; font-weight: 700; color: #1B2A4A; margin: 0 0 10px; }
  .modal-body { font-size: 13px; color: #6b7280; line-height: 1.6; margin: 0 0 24px; }
  .modal-cta {
    display: block; background: #1B2A4A; color: #fff; font-weight: 700; font-size: 14px;
    padding: 12px 0; border-radius: 8px; text-decoration: none; margin-bottom: 10px;
  }
  .modal-secondary {
    display: block; width: 100%; background: none; border: none; color: #6b7280;
    font-size: 12px; text-decoration: underline; cursor: pointer; padding: 4px 0;
  }
</style>