---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';

export async function getStaticPaths() {
  const entries = await getCollection('samples');
  console.log('SAMPLES FOUND:', entries.length);
  return entries.map((entry) => ({
    params: {
      category: entry.data.category.toLowerCase().replace(/\s+/g, '-'),
      slug: entry.id,
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const SPLIT = '<!--split-->';
const rawBody = entry.body ?? '';
const [firstRaw, secondRaw] = rawBody.includes(SPLIT) ? rawBody.split(SPLIT) : [rawBody, ''];

function toHtml(md: string) {
  return md.trim().split(/\r?\n\s*\r?\n+/).map((block: string) => {
    const trimmed = block.trim();
    if (trimmed.startsWith('## ')) return `<h2>${trimmed.slice(3).trim()}</h2>`;
    const inline = trimmed
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>');
    return `<p>${inline}</p>`;
  }).join('\n');
}

const firstHtml = toHtml(firstRaw);
const secondHtml = toHtml(secondRaw);

let related = [];
if (data.related.length > 0) {
  const relatedEntries = await Promise.all(data.related.map((slug) => getEntry('samples', slug)));
  related = relatedEntries.filter((r) => r !== undefined);
} else {
  const all = await getCollection('samples');
  related = all.filter((e) => e.id !== entry.id && e.data.subject === data.subject).slice(0, 3);
}

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit', month: '2-digit', year: 'numeric',
}).format(data.date);
---

<BaseLayout title={data.meta_title} description={data.description}>
  <Header />
  <div class="hero-band">
    <div class="sample-page">
      <nav class="breadcrumb">
        <a href="/" class="home-icon" aria-label="Home">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
            <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          </svg>
        </a>
        / <a href={`/samples/${data.category.toLowerCase().replace(/\s+/g, '-')}`}>{data.category}</a>
        / <span class="breadcrumb-current">{data.title}</span>
      </nav>

      <div class="hero-row">
        <h1>{data.title}</h1>
        <div class="hero-search">
          <div class="search-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
            <input type="text" placeholder="I'm looking for..." />
          </div>
          <button>Search</button>
        </div>
      </div>
    </div>
  </div>

  <div class="sample-page">
    <div class="layout-grid">
      <aside class="writer-card">
        <div class="writer-header">
          {data.writer_photo ? (
            <img src={data.writer_photo} alt={data.writer_name} class="avatar-photo" />
          ) : (
            <div class="avatar">{data.writer_name.split(' ').map((n) => n[0]).join('')}</div>
          )}
          <div>
            <p class="writer-name">{data.writer_name}</p>
            <p class="writer-tagline">{data.writer_tagline}</p>
          </div>
        </div>

        {data.writer_subjects.length > 0 && (
          <>
            <p class="highlights-label">Highlights</p>
            <div class="writer-chips">
              {data.writer_subjects.map((s) => <span>{s}</span>)}
            </div>
          </>
        )}

        <div class="stats-row">
          {data.writer_ontime && (
            <div>
              <p class="stat-num">{data.writer_ontime}%</p>
              <p class="stat-label">On-time Delivery</p>
            </div>
          )}
          <div>
            <p class="stat-num"><span class="star">★</span> {data.writer_rating.toFixed(1)}</p>
            <p class="stat-label">Reviews: {data.writer_reviews}</p>
          </div>
        </div>

        <a href={data.order_service_link} class="hire-btn">Hire {data.writer_name.split(' ')[0]}</a>

        <div class="trust-list">
          <p>✔ Tailored to your requirements</p>
          <p>✔ Deadlines from 3 hours</p>
          <p>✔ Easy Refund Policy</p>
        </div>
      </aside>

      <div class="content">
        <div class="meta-row">
          <div class="chips">
            <span>{data.essay_type} Essay</span>
            <span>{data.word_count} words</span>
            <span>{data.pages} pages</span>
            <span>{formattedDate}</span>
          </div>
          <button class="download-btn" data-count="0" onclick="const btn=this; const n=parseInt(btn.dataset.count)+1; btn.dataset.count=n; btn.textContent='Download: '+n+' ↓';">Download: 0 ↓</button>
        </div>

        <div class="essay-body">
          <div set:html={firstHtml} />

          {secondRaw && (
            <div class="cta-banner">
              <div class="cta-badges">
                <span class="cta-badge">Ready in 3+ hours</span>
                <span class="cta-badge">Plagiarism &amp; AI free</span>
                <span class="cta-badge">50+ writers online</span>
              </div>
              <div class="cta-text">
                <p class="cta-title">Put your paper in expert hands</p>
                <p class="cta-sub">Get a custom essay written to your exact requirements researched, structured, and delivered on time.</p>
                <a href={data.order_service_link} class="cta-btn">Write my essay</a>
              </div>
            </div>
          )}

          <div set:html={secondHtml} />
        </div>

        <div class="cta-banner">
          <div>
            <p class="cta-title">Need a custom essay like this?</p>
            <p class="cta-sub">Matched with a {data.subject.toLowerCase()} writer in as little as 3 hours</p>
          </div>
          <a href={data.order_service_link} class="cta-btn">Order now</a>
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="related">s
        <h2>Related samples</h2>
        <div class="related-grid">
          {related.map((r) => (
            <a class="related-card" href={`/samples/${r.data.category.toLowerCase().replace(/\s+/g, '-')}/${r.id}`}>
              <p class="related-title">{r.data.title}</p>
              <p class="related-meta">{r.data.word_count} words</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <p class="disclaimer">
      ThesisArcPro essays are provided strictly for research and study purposes and are not
      intended to be submitted as finished work. ThesisArcPro does not endorse or condone plagiarism.
    </p>
  </div>
  <Footer />
</BaseLayout>

<style>
  .sample-page { max-width: 900px; margin: 0 auto; padding: 32px 20px 64px; font-family: system-ui, sans-serif; color: #1B2A4A; }
  .breadcrumb { font-size: 13px; color: #6b7280; margin-bottom: 16px; }
  .breadcrumb a { color: #6b7280; text-decoration: none; }
  h1 { font-size: 26px; font-weight: 700; line-height: 1.3; margin: 0; color: #1B2A4A; max-width: 460px; flex: 1 1 auto; }
  .layout-grid { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; }
  @media (max-width: 700px) {
  .hero-row { flex-wrap: wrap; }
  .hero-search { flex-basis: 100%; }
} { .layout-grid { grid-template-columns: 1fr; } }
  .writer-card { background: #F7F5F0; border: 1px solid #E8E2D6; border-radius: 12px; padding: 16px; align-self: start; position: sticky; top: 20px; }
  .writer-header { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .avatar { width: 40px; height: 40px; border-radius: 50%; background: #1B2A4A; color: #C5A059; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; }
  .writer-name { font-weight: 600; font-size: 14px; margin: 0; }
  .writer-tagline { font-size: 12px; color: #6b7280; margin: 2px 0 0; line-height: 1.4; }
  .writer-stat { font-size: 13px; color: #4b5563; margin: 0 0 14px; }
  .hire-btn { display: block; text-align: center; background: #C5A059; color: #1B2A4A; font-weight: 600; font-size: 13px; padding: 9px 0; border-radius: 8px; text-decoration: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips span { background: #F7F5F0; color: #4b5563; font-size: 12px; padding: 5px 12px; border-radius: 20px; border: 1px solid #E8E2D6; }
  .essay-body { font-size: 16px; line-height: 1.75; color: #2a3550; }
  .essay-body :global(p) { margin: 0 0 18px; }
  .cta-banner {
    display: flex; align-items: center; gap: 32px; flex-wrap: wrap;
    background: linear-gradient(135deg, #1B2A4A 0%, #2c4270 100%);
    border-radius: 16px; padding: 28px 32px; margin: 32px 0;
  }
  .cta-badges { display: flex !important; flex-direction: column !important; gap: 10px !important; }
  .cta-badge {
    display: inline-block !important;
    background: #fff !important; color: #1B2A4A !important; font-size: 13px !important; font-weight: 600 !important;
    padding: 10px 18px !important; border-radius: 999px !important; box-shadow: 0 4px 10px rgba(0,0,0,0.15) !important;
    white-space: nowrap !important; text-align: center !important; font-family: system-ui, sans-serif !important;
  }
  .cta-text { flex: 1; min-width: 240px; }
  .cta-title.cta-title { color: #fff !important; font-weight: 700 !important; font-size: 20px !important; margin: 0 0 8px !important; text-align: left !important; font-family: system-ui, sans-serif !important; }
  .cta-sub.cta-sub { color: #cbd5e1 !important; font-size: 14px !important; line-height: 1.5 !important; margin: 0 0 16px !important; max-width: 380px; text-align: left !important; font-family: system-ui, sans-serif !important; }
  .cta-btn { display: inline-block; background: #C5A059; color: #1B2A4A; font-weight: 700; font-size: 14px; padding: 12px 22px; border-radius: 8px; text-decoration: none; }
  .related { margin-top: 48px; }
  .related h2 { font-size: 18px; font-weight: 700; color: #1B2A4A; margin: 0 0 16px; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .related-card { border: 1px solid #E8E2D6; border-radius: 10px; padding: 14px; text-decoration: none; color: inherit; }
  .related-title { font-size: 14px; font-weight: 600; margin: 0 0 4px; color: #1B2A4A; }
  .related-meta { font-size: 12px; color: #6b7280; margin: 0; }
  .disclaimer { margin-top: 40px; font-size: 11px; color: #9a9da6; line-height: 1.6; border-top: 1px solid #E8E2D6; padding-top: 16px; }

  .avatar-photo { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .writer-chips { display: flex; flex-wrap: wrap; gap: 5px; margin: 10px 0; }
  .writer-chips span { background: #E8E2D6; color: #1B2A4A; font-size: 10px; padding: 3px 8px; border-radius: 10px; }
  .trust-list { margin-top: 12px; }
  .trust-list p { font-size: 11px; color: #4b5563; margin: 0 0 4px; }
  .writer-card { background: #FFFFFF !important; }
  .highlights-label { font-size: 11px; font-weight: 600; color: #6b7280; margin: 0 0 8px; }
  .stats-row { display: flex; gap: 20px; margin: 14px 0; }
  .stat-num { font-size: 16px; font-weight: 700; color: #1B2A4A; margin: 0; }
  .star { color: #C5A059; }
  .stat-label { font-size: 11px; color: #6b7280; margin: 2px 0 0; }
  .hero-band {
    background: linear-gradient(to bottom, #FFFFFF 0%, #F7F8FE 50%, #EFF2FC 100%);
    border-top: 1px solid #DCE1F2;
    padding-top: 110px;
    margin-bottom: 0;
  }
  .hero-band .sample-page { padding: 20px 20px 48px; margin: 0; }

  .essay-body, .essay-body :global(p) {
    color: #475569;
    font-size: 12pt;
    line-height: 1.5;
    font-family: Georgia, 'Times New Roman', serif;
    text-align: justify;
  }
  .essay-body :global(h2) {
    background: #F7F5F0;
    border-radius: 12px 12px 0 0;
    padding: 20px 24px 4px;
    margin: 32px 0 0;
    font-size: 18px;
    font-weight: 700;
    color: #1B2A4A;
    font-family: system-ui, sans-serif;
    text-align: left;
    border-bottom: none;
  }
  .essay-body :global(h2) ~ :global(p) {
    background: #F7F5F0;
    padding: 4px 24px;
    margin: 0;
    text-align: left;
    font-size: 13px;
  }
  .essay-body :global(h2) ~ :global(p:last-of-type) {
    border-radius: 0 0 12px 12px;
    padding-bottom: 20px;
  }
  .home-icon { display: inline-flex; vertical-align: -3px; color: #3A75B4; }
  .breadcrumb a { color: #3A75B4; }
  .hero-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: nowrap; }
  .hero-search { display: flex; gap: 8px; flex: 0 0 340px; }
  .hero-search input { flex: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid #E8E2D6; font-size: 13px; }
  .hero-search button { background: #C5A059; color: #1B2A4A; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 500; font-size: 13px; cursor: pointer; }
  .search-input-wrap { position: relative; flex: 1; display: flex; align-items: center; }
  .search-input-wrap svg { position: absolute; left: 12px; color: #9ca3af; pointer-events: none; }
  .meta-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-bottom: 20px; border-bottom: 1px solid #E8E2D6; margin-bottom: 24px; }
  .download-btn { background: #F7F5F0; color: #1B2A4A; border: 1px solid #E8E2D6; padding: 8px 14px; border-radius: 8px; font-size: 12px; font-weight: 500; cursor: pointer; white-space: nowrap; }
  .dl-icon { font-size: 12px; }
  .hero-search input { padding-left: 36px; }
  .breadcrumb-current { color: #6b7280; }
</style>