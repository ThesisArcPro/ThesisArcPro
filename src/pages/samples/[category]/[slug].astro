---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { supabase } from '../../../lib/supabase.js';

export async function getStaticPaths() {
  const entries = await getCollection('samples');
  console.log('SAMPLES FOUND:', entries.length);
  return entries.map((entry) => ({
    params: {
      category: entry.data.category.toLowerCase().replace(/\s+/g, '-'),
      slug: entry.id,
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const SPLIT = '<!--split-->';
const rawBody = entry.body ?? '';
const [firstRaw, secondRaw] = rawBody.includes(SPLIT) ? rawBody.split(SPLIT) : [rawBody, ''];

function toHtml(md: string) {
  return md.trim().split(/\r?\n\s*\r?\n+/).map((block: string) => {
    const trimmed = block.trim();
    if (trimmed.startsWith('## ')) return `<h2>${trimmed.slice(3).trim()}</h2>`;
    const inline = trimmed
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>');
    return `<p>${inline}</p>`;
  }).join('\n');
}

const firstHtml = toHtml(firstRaw);
const secondHtml = toHtml(secondRaw);

let related = [];
if (data.related.length > 0) {
  const relatedEntries = await Promise.all(data.related.map((slug) => getEntry('samples', slug)));
  related = relatedEntries.filter((r) => r !== undefined);
} else {
  const all = await getCollection('samples');
  related = all.filter((e) => e.id !== entry.id && e.data.subject === data.subject).slice(0, 3);
}

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit', month: '2-digit', year: 'numeric',
}).format(data.date);
---

<BaseLayout title={data.meta_title} description={data.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": data.title,
    "description": data.description,
    "datePublished": data.date.toISOString(),
    "author": {
      "@type": "Person",
      "name": data.writer_name
    },
    "publisher": {
      "@type": "Organization",
      "name": "ThesisArcPro"
    }
  })} />
  <Header />
  <div class="hero-band">
    <div class="sample-page">
      <nav class="breadcrumb">
        <a href="/" class="home-icon" aria-label="Home">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
            <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          </svg>
        </a>
        / <a href={`/samples/${data.category.toLowerCase().replace(/\s+/g, '-')}`}>{data.category}</a>
        / <span class="breadcrumb-current">{data.title}</span>
      </nav>

      <div class="hero-row">
        <h1>{data.title}</h1>
        <div class="hero-search">
          <div class="search-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
            <input type="text" placeholder="I'm looking for..." />
          </div>
          <button>Search</button>
        </div>
      </div>
    </div>
  </div>

  <div class="sample-page">
    <div class="layout-grid">
      <aside class="writer-card">
        <div class="writer-header">
          {data.writer_photo ? (
            <img src={data.writer_photo} alt={data.writer_name} class="avatar-photo" />
          ) : (
            <div class="avatar">{data.writer_name.split(' ').map((n) => n[0]).join('')}</div>
          )}
          <div>
            <p class="writer-name">{data.writer_name}</p>
            <p class="writer-tagline">{data.writer_tagline}</p>
          </div>
        </div>

        {data.writer_subjects.length > 0 && (
          <>
            <p class="highlights-label">Highlights</p>
            <div class="writer-chips">
              {data.writer_subjects.map((s) => <span>{s}</span>)}
            </div>
          </>
        )}

        <div class="stats-row">
          {data.writer_ontime && (
            <div>
              <p class="stat-num">{data.writer_ontime}%</p>
              <p class="stat-label">On-time Delivery</p>
            </div>
          )}
          <div>
            <p class="stat-num"><span class="star">★</span> {data.writer_rating.toFixed(1)}</p>
            <p class="stat-label">Reviews: {data.writer_reviews}</p>
          </div>
        </div>

        <a href="/order/" class="hire-btn">Hire {data.writer_name.split(' ')[0]}</a>

        <div class="trust-list">
          <p>✔ Tailored to your requirements</p>
          <p>✔ Deadlines from 3 hours</p>
          <p>✔ Easy Refund Policy</p>
        </div>
      </aside>

      <div class="content">
        <div class="meta-row">
          <div class="chips">
            <span>{data.essay_type} Essay</span>
            <span>{data.word_count} words</span>
            <span>{data.pages} pages</span>
            <span>{formattedDate}</span>
          </div>
          <button class="download-btn" id="downloadBtn" data-slug={entry.id}>Download: 0 ↓</button>
        </div>

        <div class="essay-body">
          <div set:html={firstHtml} />

          {secondRaw && (
            <div class="cta-banner">
              <div class="cta-badges">
                <span class="cta-badge">Ready in 3+ hours</span>
                <span class="cta-badge">Plagiarism &amp; AI free</span>
                <span class="cta-badge">50+ writers online</span>
              </div>
              <div class="cta-text">
                <p class="cta-title">Put your paper in expert hands</p>
                <p class="cta-sub">Get a custom essay written to your exact requirements researched, structured, and delivered on time.</p>
                <a href="/order/" class="cta-btn">Write my essay</a>
              </div>
            </div>
          )}

          <div set:html={secondHtml} />
        </div>

        <div class="promo-strip" id="promoStrip"></div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="related">s
        <h2>Related samples</h2>
        <div class="related-grid">
          {related.map((r) => (
            <a class="related-card" href={`/samples/${r.data.category.toLowerCase().replace(/\s+/g, '-')}/${r.id}`}>
              <p class="related-title">{r.data.title}</p>
              <p class="related-meta">{r.data.word_count} words</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <div id="downloadModal" class="modal-overlay" style="display:none;">
      <div class="modal-box">
        <button id="modalClose" class="modal-close" aria-label="Close">&times;</button>
        <div class="modal-icon">⚠</div>
        <p class="modal-title">This is a public sample</p>
        <p class="modal-body">
          This essay is published openly on our site — other students can find and download this exact same text.
          Submitting shared content as your own work risks a plagiarism flag.
        </p>
        <a href="/order/" class="modal-cta">Get a custom, original essay</a>
        <button id="modalDownloadAnyway" class="modal-secondary">Download sample anyway</button>
      </div>
    </div>

    <p class="disclaimer">
      ThesisArcPro essays are provided strictly for research and study purposes and are not
      intended to be submitted as finished work. ThesisArcPro does not endorse or condone plagiarism.
    </p>
  </div>
  <Footer />
  <script>
  import { supabase } from '../../../lib/supabase.js';

  const btn = document.getElementById('downloadBtn');
  const slug = btn?.dataset.slug || '';
  const title = document.querySelector('h1')?.textContent || '';

  async function loadCount() {
    const { data } = await supabase.from('sample_downloads').select('count').eq('slug', slug).maybeSingle();
    const n = data?.count || 0;
    if (btn) btn.textContent = `Download: ${n} ↓`;
  }

  async function handleDownload() {
    const { data: result, error } = await supabase.rpc('increment_download', { slug_param: slug });
    if (!error && btn) btn.textContent = `Download: ${result} ↓`;

    const bodyText = document.querySelector('.essay-body')?.textContent?.trim() || '';
    const fileContent = `${title}\n\n${bodyText}`;
    const blob = new Blob([fileContent], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${slug}.txt`;
    a.click();
    URL.revokeObjectURL(url);
  }

  const modal = document.getElementById('downloadModal');
  const modalClose = document.getElementById('modalClose');
  const modalDownloadAnyway = document.getElementById('modalDownloadAnyway');

  btn?.addEventListener('click', () => {
    if (modal) modal.style.display = 'flex';
  });

  modalClose?.addEventListener('click', () => { if (modal) modal.style.display = 'none'; });
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.style.display = 'none'; });

  modalDownloadAnyway?.addEventListener('click', () => {
    if (modal) modal.style.display = 'none';
    handleDownload();
  });

  loadCount();

  const promoVariants = [
    {
      icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="m9 15 2 2 4-4"/></svg>`,
      title: 'Get a custom-written paper',
      sub: 'Grab a <strong>100% original</strong> academic paper tailored to your instructions',
      btn: 'Let us help you',
    },
    {
      icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M5 3 2 6"/><path d="m22 6-3-3"/></svg>`,
      title: 'On-time essay delivery!',
      sub: 'Get your custom, <strong>100% plagiarism-free</strong> paper in as little as 1 hour',
      btn: "Let's start",
    },
    {
      icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>`,
      title: 'Cut 15% off your first order',
      sub: `We'll deliver a <strong>100% custom paper</strong> perfectly tailored to your needs`,
      btn: 'Use discount',
    },
  ];

  const promoBox = document.getElementById('promoStrip');
  if (promoBox) {
    const pick = promoVariants[Math.floor(Math.random() * promoVariants.length)];
    promoBox.innerHTML = `
      <div class="promo-left">
        <div class="promo-icon">${pick.icon}</div>
        <div>
          <p class="promo-title">${pick.title}</p>
          <p class="promo-sub">${pick.sub}</p>
        </div>
      </div>
      <a href="/order/" class="promo-btn">${pick.btn}</a>
    `;
  }
</script>
</BaseLayout>

<style>
  .sample-page { max-width: 900px; margin: 0 auto; padding: 32px 20px 64px; font-family: system-ui, sans-serif; color: #1B2A4A; }
  .breadcrumb { font-size: 13px; color: #6b7280; margin-bottom: 16px; }
  .breadcrumb a { color: #6b7280; text-decoration: none; }
  h1 { font-size: 26px; font-weight: 700; line-height: 1.3; margin: 0; color: #1B2A4A; max-width: 460px; flex: 1 1 auto; }
  .layout-grid { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; }
  @media (max-width: 700px) {
  .hero-row { flex-wrap: wrap; }
  .hero-search { flex-basis: 100%; }
} { .layout-grid { grid-template-columns: 1fr; } }
