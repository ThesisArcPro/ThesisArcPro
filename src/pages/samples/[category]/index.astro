---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  const entries = await getCollection('samples');
  const categories = [...new Set(entries.map((e) => e.data.category))];
  return categories.map((category) => ({
    params: { category: category.toLowerCase().replace(/\s+/g, '-') },
    props: { category },
  }));
}

const { category } = Astro.props;
const allSamples = await getCollection('samples');
const essays = allSamples.filter((e) => e.data.category === category);
---

<BaseLayout title={`${category} - Essay Examples - ThesisArcPro`} description={`Browse free ${category.toLowerCase()} sample essays written by ThesisArcPro's academic writers.`}>
  <Header />
  <div class="hero-band">
    <div class="page-inner">
      <nav class="breadcrumb">
        <a href="/samples" class="home-icon" aria-label="Samples">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
            <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          </svg>
        </a>
      </nav>
      <h1>{category}</h1>
    </div>
  </div>

  <div class="page-inner">
    <div class="essay-grid">
      {essays.map((essay) => (
        <a class="essay-card" href={`/samples/${category.toLowerCase().replace(/\s+/g, '-')}/${essay.id}`}>
          <p class="essay-title">{essay.data.title}</p>
          <p class="essay-desc">{essay.data.description}</p>
          <div class="essay-meta">
            <span>{essay.data.essay_type} Essay</span>
            <span>{essay.data.word_count} words</span>
          </div>
        </a>
      ))}
    </div>
  </div>
  <Footer />
</BaseLayout>

<style>
  .page-inner { max-width: 1100px; margin: 0 auto; padding: 0 20px 64px; }
  .hero-band { background: linear-gradient(to bottom, #FFFFFF 0%, #F7F8FE 50%, #EFF2FC 100%); border-top: 1px solid #DCE1F2; padding: 110px 0 32px; }
  .breadcrumb { margin-bottom: 12px; }
  .home-icon { color: #3A75B4; }
  h1 { font-size: 28px; font-weight: 700; color: #1B2A4A; margin: 0; }
  .essay-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; padding-top: 32px; }
  .essay-card { display: block; border: 1px solid #E8E2D6; border-radius: 12px; padding: 18px; text-decoration: none; color: inherit; }
  .essay-card:hover { border-color: #C5A059; }
  .essay-title { font-size: 15px; font-weight: 700; color: #1B2A4A; margin: 0 0 8px; }
  .essay-desc { font-size: 13px; color: #6b7280; line-height: 1.5; margin: 0 0 12px; }
  .essay-meta { display: flex; gap: 6px; }
  .essay-meta span { background: #F7F5F0; color: #4b5563; font-size: 11px; padding: 3px 10px; border-radius: 12px; border: 1px solid #E8E2D6; }
</style>