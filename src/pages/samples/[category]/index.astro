---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  const entries = await getCollection('samples');
  const categories = [...new Set(entries.map((e) => e.data.category))];
  return categories.map((category) => ({
    params: { category: category.toLowerCase().replace(/\s+/g, '-') },
    props: { category },
  }));
}

const { category } = Astro.props;
const allSamples = await getCollection('samples');
const essays = allSamples.filter((e) => e.data.category === category);
const assignmentTypes = [...new Set(essays.map((e) => e.data.assignment_type))];
---

<BaseLayout title={`${category} - Essay Examples - ThesisArcPro`} description={`Browse free ${category.toLowerCase()} sample essays written by ThesisArcPro's academic writers.`}>
  <Header />
  <div class="hero-band">
    <div class="page-inner">
      <nav class="breadcrumb">
        <a href="/samples" class="home-icon" aria-label="Samples">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
            <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          </svg>
        </a>
      </nav>
      <h1>{category}</h1>
    </div>
  </div>

  <div class="page-inner">
    <div class="category-layout">
      <aside class="filter-card">
        <p class="filter-title">Select your assignment type</p>
        <p class="filter-popular">Popular</p>
        {assignmentTypes.map((type) => (
          <label class="filter-checkbox">
            <input type="checkbox" name="assignment_type" value={type} />
            {type}
          </label>
        ))}
        <button class="filter-apply" type="button">Apply filter</button>
      </aside>

      <div class="essay-list" id="essayList">
      {essays.map((essay) => {
        const formattedDate = new Intl.DateTimeFormat('en-GB', {
          day: '2-digit', month: '2-digit', year: 'numeric',
        }).format(essay.data.date);
        return (
          <div class="essay-row" data-assignment-type={essay.data.assignment_type}>
            <div class="essay-row-text">
              <p class="essay-title">{essay.data.title}</p>
              <p class="essay-desc">{essay.data.description}</p>
              <div class="essay-meta">
                <span>{essay.data.essay_type} Essay</span>
                <span>{essay.data.subject}</span>
                <span>{essay.data.word_count} words</span>
                <span>{essay.data.pages} pages</span>
                <span>{formattedDate}</span>
              </div>
            </div>
            <a href={`/samples/${category.toLowerCase().replace(/\s+/g, '-')}/${essay.id}`} class="read-more-btn">Read more</a>
          </div>
        );
      })}
    </div>
    </div>
  </div>
  <Footer />
  <script>
  const checkboxes = document.querySelectorAll('input[name="assignment_type"]');
  const applyBtn = document.querySelector('.filter-apply');
  const rows = document.querySelectorAll('.essay-row');

  applyBtn?.addEventListener('click', () => {
    const checked = Array.from(checkboxes)
      .filter((cb) => (cb as HTMLInputElement).checked)
      .map((cb) => (cb as HTMLInputElement).value);

    rows.forEach((row) => {
      const rowType = row.getAttribute('data-assignment-type');
      const show = checked.length === 0 || checked.includes(rowType || '');
      (row as HTMLElement).style.display = show ? 'flex' : 'none';
    });
  });
</script>
</BaseLayout>

<style>
  .page-inner { max-width: 1100px; margin: 0 auto; padding: 0 20px 64px; }
  .hero-band { background: linear-gradient(to bottom, #FFFFFF 0%, #F7F8FE 50%, #EFF2FC 100%); border-top: 1px solid #DCE1F2; padding: 110px 0 32px; }
  .breadcrumb { margin-bottom: 12px; }
  .home-icon { color: #3A75B4; }
  h1 { font-size: 28px; font-weight: 700; color: #1B2A4A; margin: 0; }
  .essay-list { display: flex; flex-direction: column; gap: 16px; padding-top: 32px; }
  .essay-row {
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    border: 1px solid #E8E2D6; border-radius: 12px; padding: 20px 24px;
  }
  .essay-row:hover { border-color: #C5A059; }
  .essay-row-text { flex: 1; min-width: 0; }
  .essay-title { font-size: 16px; font-weight: 700; color: #1B2A4A; margin: 0 0 6px; }
  .essay-desc { font-size: 13px; color: #6b7280; line-height: 1.5; margin: 0 0 12px; }
  .essay-meta { display: flex; flex-wrap: wrap; gap: 6px; }
  .essay-meta span { background: #F7F5F0; color: #4b5563; font-size: 11px; padding: 3px 10px; border-radius: 12px; border: 1px solid #E8E2D6; }
  .read-more-btn {
    flex-shrink: 0; background: #F7F5F0; color: #1B2A4A; border: 1px solid #E8E2D6;
    padding: 10px 20px; border-radius: 8px; font-size: 13px; font-weight: 600;
    text-decoration: none; white-space: nowrap;
  }
  .read-more-btn:hover { border-color: #C5A059; }
  .category-layout { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 32px; padding-top: 32px; }
  @media (max-width: 800px) { .category-layout { grid-template-columns: 1fr; } }
  .filter-card { background: #ECEEFF; border-radius: 14px; padding: 20px; align-self: start; }
  .filter-title { font-size: 14px; font-weight: 600; color: #1B2A4A; margin: 0 0 10px; }
  .filter-popular { font-size: 12px; color: #C5A059; margin: 0 0 8px; font-weight: 600; }
  .filter-checkbox {
    display: flex; align-items: center; gap: 8px; font-size: 13px; color: #334155;
    padding: 8px 0; border-bottom: 1px solid #dfe2fb; cursor: pointer;
  }
  .filter-apply {
    width: 100%; margin-top: 14px; background: #1B2A4A; color: #fff; border: none;
    padding: 12px 0; border-radius: 8px; font-weight: 600; font-size: 13px; cursor: pointer;
  }
  .essay-list { padding-top: 0 !important; }
</style>