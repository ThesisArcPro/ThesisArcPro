---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = '';
---

<BaseLayout title="Team Login" description="ThesisArcPro Team Login">
  <main class="team-login-page">
    <div class="team-login-card">
      <div class="team-login-brand">
        <div class="team-login-brand-icon">A</div>
        <span>Team Login</span>
      </div>
      <p class="team-login-sub">Sign in with the email and password your admin gave you.</p>

      <div id="teamLoginError" class="team-login-error" style="display:none;"></div>

      <form id="teamLoginForm">
        <div class="team-login-field">
          <label>Email address</label>
          <input type="email" id="teamLoginEmail" placeholder="you@company.com" required autocomplete="username" />
        </div>
        <div class="team-login-field">
          <label>Password</label>
          <input type="password" id="teamLoginPassword" placeholder="Your password" required autocomplete="current-password" />
        </div>
        <button type="submit" id="teamLoginBtn" class="team-login-btn">Log in</button>
      </form>

      <p class="team-login-note">Not a team member? <a href={`${base}/login/`}>Client login</a></p>
    </div>
  </main>
</BaseLayout>

<style>
  .team-login-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #0f1117; padding: 1.5rem; }
  .team-login-card { background: #1a1f2e; border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 2.2rem 2rem; width: 100%; max-width: 380px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
  .team-login-brand { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.4rem; }
  .team-login-brand-icon { width: 32px; height: 32px; border-radius: 8px; background: #046fcd; color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .team-login-brand span { color: #e2e8f0; font-weight: 700; font-size: 1.1rem; }
  .team-login-sub { color: #64748b; font-size: 0.85rem; margin-bottom: 1.4rem; }
  .team-login-error { background: rgba(220,38,38,0.12); border: 1px solid rgba(220,38,38,0.3); color: #fca5a5; font-size: 0.82rem; padding: 0.7rem 0.9rem; border-radius: 8px; margin-bottom: 1rem; }
  .team-login-field { margin-bottom: 1.1rem; }
  .team-login-field label { display: block; color: #e2e8f0; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem; }
  .team-login-field input { width: 100%; padding: 0.7rem 0.9rem; background: #161b27; border: 1.5px solid rgba(255,255,255,0.1); border-radius: 10px; color: #e2e8f0; font-size: 0.9rem; outline: none; box-sizing: border-box; }
  .team-login-field input:focus { border-color: #046fcd; }
  .team-login-btn { width: 100%; padding: 0.85rem; background: #046fcd; color: #fff; border: none; border-radius: 10px; font-size: 0.95rem; font-weight: 700; cursor: pointer; }
  .team-login-btn:hover { background: #0361b3; }
  .team-login-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .team-login-note { text-align: center; color: #64748b; font-size: 0.8rem; margin-top: 1.2rem; }
  .team-login-note a { color: #60a5fa; text-decoration: none; }
  .team-login-note a:hover { text-decoration: underline; }
</style>

<script>
  import { supabase } from '../lib/supabase.js';
  const base = '';

  // If already logged in, skip straight to admin (checkAuth there decides final access).
  (async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) window.location.replace(`${base}/admin/`);
  })();

  const form = document.getElementById('teamLoginForm') as HTMLFormElement;
  const errorBox = document.getElementById('teamLoginError') as HTMLElement;
  const btn = document.getElementById('teamLoginBtn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.style.display = 'none';
    const email = (document.getElementById('teamLoginEmail') as HTMLInputElement).value.trim();
    const password = (document.getElementById('teamLoginPassword') as HTMLInputElement).value;

    btn.disabled = true;
    btn.textContent = 'Logging in…';

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      errorBox.textContent = error.message === 'Email not confirmed'
        ? 'This account has not been confirmed yet. Contact your admin.'
        : error.message === 'Invalid login credentials'
        ? 'Incorrect email or password.'
        : error.message;
      errorBox.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Log in';
      return;
    }

    // checkAuth() in /admin/ handles role lookup, linking, and permission-based landing section.
    window.location.replace(`${base}/admin/`);
  });
</script>
</BaseLayout>