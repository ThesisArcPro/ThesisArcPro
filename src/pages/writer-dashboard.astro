  // ═══ MY PUBLIC PROFILE MODAL ═══
  let ppActiveTab = 'statistics';

  function ppRatingBreakdown() {
    const counts = [0, 0, 0, 0, 0]; // index 0 = 5-star ... index 4 = 1-star
    writerReviews.forEach((r: any) => {
      const rating = Math.round(r.rating || 0);
      if (rating >= 1 && rating <= 5) counts[5 - rating]++;
    });
    const total = writerReviews.length || 1;
    return [5, 4, 3, 2, 1].map((star, i) => ({
      star,
      pct: Math.round((counts[i] / total) * 100)
    }));
  }

  function renderPpStatistics() {
    const avgRating = writerReviews.length
      ? (writerReviews.reduce((s: number, r: any) => s + (r.rating || 0), 0) / writerReviews.length).toFixed(1)
