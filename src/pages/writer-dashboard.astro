  async function loadProposalClientFiles(orderId: number) {
    const box = document.getElementById('proposalFilesList');
    if (!box) return;
    box.innerHTML = '<div class="no-files">Loading files…</div>';
    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/order_files?order_id=eq.${orderId}&uploaded_by=eq.client&order=created_at.desc`,
        { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
      );
      const files = await res.json();
      if (!Array.isArray(files) || !files.length) {
        box.innerHTML = '<div class="no-files">No files attached by the client.</div>';
        return;
      }
      box.innerHTML = files.map((f: any) => `
        <div class="file-row">
          <div class="file-info">
            <span class="file-type-badge">${esc(f.file_type || 'File')}</span>
            <div class="file-name">${esc(f.file_name)}</div>
          </div>
          <a href="${esc(f.file_url || '#')}" target="_blank" style="font-size:0.78rem;color:#046fcd;font-weight:600;text-decoration:none;">Download</a>
        </div>`).join('');
    } catch (err) {
      console.error(err);
      box.innerHTML = '<div class="no-files">Could not load files.</div>';
    }
  }
 
  async function proposalChatLoad(orderId: number, order: any) {
    const sub = document.getElementById('bidChatSub');
    const locked = document.getElementById('bidChatLocked');
    const messagesBox = document.getElementById('bidChatMessages');
    const inputBar = document.getElementById('bidChatInputBar');
    if (!messagesBox || !locked || !inputBar) return;
 
    try {
      const convId = await wocFindConversation(String(orderId));
      if (!convId) {
        if (sub) sub.textContent = 'No conversation yet';
        locked.style.display = 'flex';
        return;
      }
      await wocEnsureSelf(convId);
      bidChatConvId = convId;
      if (sub) sub.textContent = 'Waiting for client reply';
      locked.style.display = 'none';
      messagesBox.style.display = 'flex';
      inputBar.style.display = 'flex';
 
      const mRes = await fetch(
        `${SUPABASE_URL}/rest/v1/messages?conversation_id=eq.${convId}&order=created_at.asc`,
        { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
      );
      bidChatRender(await mRes.json());
 
      if (bidChatSubRT) { bidChatSubRT.unsubscribe(); bidChatSubRT = null; }
      bidChatSubRT = supabase.channel(`bidchat-${convId}`)
        .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages', filter: `conversation_id=eq.${convId}` },
          (payload: any) => bidChatAppend(payload.new)).subscribe();
    } catch (e) {
      console.error('proposalChatLoad error', e);
      if (sub) sub.textContent = 'Could not load conversation';
      locked.style.display = 'flex';
    }
  }
 
