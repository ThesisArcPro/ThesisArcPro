<script>
  import { supabase } from '../lib/supabase.js';
  import { io } from 'socket.io-client';
 
  const BIDDING_SERVER = 'https://thesisarcpro.onrender.com';
  const socket = io(BIDDING_SERVER, { transports: ['websocket'] });
 
  socket.on('connect', () => console.log('Connected to bidding server:', socket.id));
  socket.on('disconnect', () => console.log('Disconnected from bidding server'));
 
  const base = '';
  const SUPABASE_URL = 'https://rehvwvujuamehoanfomj.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_CKxnbue4T6cVn9BOIg8BkQ_kBNBiM_h';
 
  let allOrders: any[] = [];
  let currentTab = 'in_progress';
  let currentProfileTab = 'overview';
  let currentSession: any = null;
  let writerId: number | null = null;
  let writerData: any = null;
  let writerReviews: any[] = [];
  let activeOrderId: number | null = null;
  let activeOrderNumber = '';
  let availableOrders: any[] = [];
  let myBids: any[] = [];
  let currentProposalTab = 'pending';
 
  function esc(v: any) {
    return String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
 
  function deadlineInfo(deadline: string) {
    if (!deadline) return { text: 'No deadline', cls: '' };
    const diff = new Date(deadline).getTime() - Date.now();
    const days = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    if (diff < 0) return { text: `⚠️ ${Math.abs(days)}d overdue`, cls: 'overdue' };
    if (days === 0 && hours > 0) return { text: `⏰ ${hours}h left`, cls: 'urgent' };
    if (days <= 2) return { text: `⏰ ${days}d left`, cls: 'urgent' };
    return { text: `⏰ ${days}d left`, cls: 'ok' };
  }
 
  function statusClass(status: string) {
    const known = ['new','in_progress','in_review','completed','revision','cancelled'];
    return known.includes(status) ? status : 'new';
  }
 
  async function init() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { window.location.replace(`${base}/writer-login/`); return; }
    currentSession = session;
 
    const res = await fetch(
      `${SUPABASE_URL}/rest/v1/writers?auth_user_id=eq.${session.user.id}&select=*`,
      { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${session.access_token}` } }
    );
    const data = await res.json();
    if (!data.length) {
      await supabase.auth.signOut();
      window.location.replace(`${base}/writer-login/`);
      return;
    }
 
    writerData = data[0];
    writerId = writerData.id;
 
    socket.emit('writer:online', String(writerId));
 
    socket.on('order:available', async () => {
      await loadAvailableOrders();
      const badge = document.getElementById('availBadge');
      if (badge) {
        const current = parseInt(badge.textContent || '0') || 0;
        badge.textContent = String(current + 1);
        (badge as HTMLElement).style.display = 'inline-flex';
      }
    });
 
    socket.on('bid:accepted', (data: any) => {
      loadOrders();
      loadMyBids();
      const badge = document.getElementById('notifBadge');
      if (badge) { badge.textContent = '!'; (badge as HTMLElement).style.display = 'inline-flex'; }
    });
 
    // Real-time: order assigned to writer
    supabase.channel(`writer-orders-${writerId}`)
      .on('postgres_changes', {
        event: 'UPDATE',
        schema: 'public',
        table: 'orders',
        filter: `writer_id=eq.${writerId}`
      }, async () => {
        await loadOrders();
        await loadMyBids();
        await refreshNotifBadge();
      })
      .subscribe();
 
    // Real-time: new available orders
    let newAvailCount = 0;
    supabase.channel('new-available-orders')
      .on('postgres_changes', {
        event: 'INSERT',
        schema: 'public',
        table: 'orders'
      }, (payload: any) => {
        if (payload.new?.order_status === 'open_for_bids') {
          newAvailCount++;
          const badge = document.getElementById('availBadge');
          if (badge) { badge.textContent = String(newAvailCount); badge.style.display = 'inline-flex'; }
        }
      })
      .subscribe();
 
    document.querySelector('.nav-item[data-view="available"]')?.addEventListener('click', () => {
      newAvailCount = 0;
      const badge = document.getElementById('availBadge');
      if (badge) badge.style.display = 'none';
    }, { capture: true });
    const nameEl = document.getElementById('writerName');
    const subEl = document.getElementById('writerSub');
    if (nameEl) nameEl.textContent = 'My Orders';
    if (subEl) subEl.textContent = `Welcome back, ${writerData.full_name}`;
 
    await loadOrders();
    await loadWriterReviews();
    await loadAvailableOrders();
    await loadMyBids();
    await refreshNotifBadge();
  }
 
  // ═══ AVAILABLE ORDERS (bidding) ═══
  async function loadAvailableOrders() {
    const loading = document.getElementById('availLoadingState');
    const empty = document.getElementById('availEmptyState');
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/open_orders_for_writer`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ p_writer_id: writerId })
      });
      availableOrders = await res.json();
      renderAvailableOrders();
    } catch (err) {
      console.error(err);
      if (loading) (loading as HTMLElement).style.display = 'none';
      if (empty) (empty as HTMLElement).style.display = 'flex';
    }
  }
 
  function renderAvailableOrders() {
    const loading = document.getElementById('availLoadingState')!;
    const empty = document.getElementById('availEmptyState')!;
    const table = document.getElementById('availTable')!;
    const list = document.getElementById('availList')!;
    const search = (document.getElementById('availSearchInput') as HTMLInputElement)?.value.toLowerCase() || '';
 
    loading.style.display = 'none';
 
    let filtered = availableOrders;
    if (search) {
      filtered = filtered.filter((o: any) => (o.topic || '').toLowerCase().includes(search) || (o.subject || '').toLowerCase().includes(search));
    }
 
    if (!filtered.length) {
      empty.style.display = 'flex';
      table.style.display = 'none';
      return;
    }
    empty.style.display = 'none';
    table.style.display = 'flex';
 
    list.innerHTML = filtered.map((o: any) => {
      const dl = deadlineInfo(o.deadline);
      const budget = Number(o.total_amount||0).toFixed(2);
      return `
        <div class="order-row" data-id="${esc(o.id)}" style="justify-content:space-between;">
          <div class="col-left">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.3rem;">
              <span class="status-badge in_progress" style="background:rgba(34,197,94,0.12);color:#4ade80;">Available</span>
              <span class="meta-dot">·</span>
              <span style="font-size:0.76rem;color:#64748b;">${esc(o.pages||1)} page${(o.pages||1)>1?'s':''}</span>
              <span class="meta-dot">·</span>
              <span style="font-size:0.76rem;color:#64748b;">${esc(o.assignment_type||'Essay')}</span>
              <span class="meta-dot">·</span>
              <span class="order-id" style="font-size:0.76rem;">ID ${esc(o.order_number||o.id)}</span>
            </div>
            <div class="order-title">${esc(o.topic || '(no topic)')}</div>
          </div>
          <div class="col-right" style="display:flex;align-items:center;gap:2rem;">
            <div class="col-deadline ${dl.cls}">${dl.text}</div>
            <div style="font-size:0.9rem;font-weight:700;color:#4ade80;">$${budget}</div>
          </div>
        </div>`;
    }).join('');
 
    list.querySelectorAll('.order-row').forEach(row => {
      row.addEventListener('click', () => {
        const id = (row as HTMLElement).dataset.id;
        const order = availableOrders.find((o: any) => String(o.id) === id);
        if (order) showBidModal(order);
      });
    });
  }
 
  document.getElementById('availSearchInput')?.addEventListener('input', renderAvailableOrders);
 
  function showBidModal(order: any) {
    const dl = deadlineInfo(order.deadline);
    const dueDate = order.deadline ? new Date(order.deadline).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—';
    const budget = Number(order.total_amount||0).toFixed(2);
    const myShare = (Number(order.total_amount||0) * 0.8).toFixed(2);
 
    document.getElementById('modalContent')!.innerHTML = `
      <div class="modal-left">
      <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;">
        <span class="status-badge in_progress" style="background:rgba(34,197,94,0.12);color:#4ade80;font-size:0.72rem;">Available</span>
