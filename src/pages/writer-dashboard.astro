  // ── FILES: load + delete ──
  async function loadOrderFiles() {
    const filesList = document.getElementById('filesList');
    if (!filesList) return;
    filesList.innerHTML = '<div class="no-files">Loading…</div>';
 
    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/order_files?order_id=eq.${activeOrderId}&order=created_at.desc`,
        { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` } }
      );
      const files = await res.json();
 
      if (!files.length) {
        filesList.innerHTML = '<div class="no-files">No files uploaded yet.</div>';
        return;
      }
 
      filesList.innerHTML = files.map((f: any) => `
        <div class="file-row" data-file-id="${f.id}" data-file-path="${esc(f.file_path)}">
          <div class="file-info">
            <span class="file-type-badge">${esc(f.file_type)}</span>
            <div class="file-name">${esc(f.file_name)}</div>
          </div>
          <button class="file-delete" data-file-id="${f.id}" data-file-path="${esc(f.file_path)}">🗑️</button>
        </div>
      `).join('');
 
      filesList.querySelectorAll('.file-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const fileId = (btn as HTMLElement).dataset.fileId;
          const filePath = (btn as HTMLElement).dataset.filePath;
          if (!confirm('Delete this file?')) return;
 
          await supabase.storage.from('completed-files').remove([filePath || '']);
          await fetch(`${SUPABASE_URL}/rest/v1/order_files?id=eq.${fileId}`, {
            method: 'DELETE',
            headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${currentSession.access_token}` }
          });
          await loadOrderFiles();
        });
      });
 
    } catch (err) {
      console.error(err);
      filesList.innerHTML = '<div class="no-files">Could not load files.</div>';
    }
  }
 
  // ── UPLOAD ──
  async function handleUpload() {
    const fileType = (document.getElementById('fileType') as HTMLSelectElement).value;
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const btn = document.getElementById('uploadBtn') as HTMLButtonElement;
    const msg = document.getElementById('uploadMsg')!;
 
    if (!fileType) {
      msg.textContent = 'Please select a file type.';
      msg.className = 'upload-msg error';
      msg.style.display = 'block';
      return;
    }
 
    const file = fileInput.files && fileInput.files[0];
    if (!file) {
      msg.textContent = 'Please choose a file.';
      msg.className = 'upload-msg error';
      msg.style.display = 'block';
      return;
    }
 
    btn.disabled = true;
    btn.textContent = '⏳ Uploading…';
    msg.style.display = 'none';
 
    try {
      const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
      const path = `${activeOrderNumber}/${fileType.replace(/[^a-zA-Z0-9]/g, '_')}_${Date.now()}_${safeName}`;
 
      const { error: upErr } = await supabase.storage.from('completed-files').upload(path, file, { upsert: true });
      if (upErr) throw upErr;
 
      const res = await fetch(`${SUPABASE_URL}/rest/v1/order_files`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_KEY,
          'Authorization': `Bearer ${currentSession.access_token}`
        },
        body: JSON.stringify({
          order_id: activeOrderId,
          order_number: activeOrderNumber,
          file_type: fileType,
          file_name: file.name,
          file_path: path,
          uploaded_by: 'writer'
        })
      });
 
      if (!res.ok) throw new Error('Failed to save file record');
 
      msg.textContent = `✅ ${fileType} uploaded successfully!`;
      msg.className = 'upload-msg success';
      msg.style.display = 'block';
      btn.disabled = false;
      btn.textContent = '📤 Upload File';
      fileInput.value = '';
      (document.getElementById('fileType') as HTMLSelectElement).value = '';
 
      await loadOrderFiles();
 
    } catch (err) {
      console.error(err);
      msg.textContent = 'Upload failed. Please try again.';
      msg.className = 'upload-msg error';
      msg.style.display = 'block';
      btn.disabled = false;
      btn.textContent = '📤 Upload File';
    }
  }
// ═══ ORDER MODAL CHAT ═══
  let ocConvId: string | null = null;
  let ocOrder: any = null;
  let ocSub: any = null;
  let ocLastDate = '';

  async function ocFindConversation(orderId: string) {
    // Scope to conversations where THIS writer is a participant — prevents chat leaking to other writers
    const res = await fetch(
      `${SUPABASE_URL}/rest/v1/conversation_participants?user_id=eq.${currentSession.user.id}&select=conversation_id,conversations(id,order_id,type)`,
      { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
    );
    const parts = await res.json();
    const match = parts.find((p: any) =>
      p.conversations?.order_id === parseInt(orderId) &&
      p.conversations?.type === 'order'
    );
    return match?.conversation_id || null;
  }

  async function ocEnsureSelf(convId: string) {
    try {
      const existing = await (await fetch(
        `${SUPABASE_URL}/rest/v1/conversation_participants?conversation_id=eq.${convId}&user_id=eq.${currentSession.user.id}&select=id`,
        { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
      )).json();
      if (existing.length) return;
      await fetch(`${SUPABASE_URL}/rest/v1/conversation_participants`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ conversation_id: convId, user_id: currentSession.user.id, role: 'writer', display_name: writerData?.full_name || 'Writer' })
      });
    } catch (e) { console.error('ocEnsureSelf', e); }
  }

  function ocBubble(m: any) {
    const mine = m.sender_id === currentSession.user.id;
    const time = m.created_at ? new Date(m.created_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '';
    const who = m.sender_role === 'support' ? 'Support' : (m.sender_name || 'Client');
    return `<div class="bm-msg ${mine ? 'mine' : 'theirs'}">
      ${!mine ? `<div class="bm-msg-sender">${esc(who)}</div>` : ''}
      <div class="bm-bubble">${esc(m.content)}</div>
      <div class="bm-msg-meta">${time}${mine ? ' ✓' : ''}</div>
    </div>`;
  }

  function ocRender(messages: any[]) {
    const c = document.getElementById('ocMessages');
    if (!c) return;
    if (!messages.length) { c.innerHTML = `<div class="bm-chat-empty"><div class="bm-chat-empty-icon">✉️</div><p>No messages yet. Say hello to the client!</p></div>`; return; }
    ocLastDate = '';
    c.innerHTML = messages.map((m: any) => {
      const dateLabel = m.created_at ? bidChatDateLabel(m.created_at) : '';
      let divider = '';
      if (dateLabel && dateLabel !== ocLastDate) {
        ocLastDate = dateLabel;
        divider = `<div style="text-align:center;font-size:0.7rem;color:var(--text-muted);margin:0.4rem 0;">${dateLabel}</div>`;
      }
      return divider + ocBubble(m);
    }).join('');
    c.scrollTop = c.scrollHeight;
  }

  async function openOrderChat(order: any) {
    ocOrder = order;
    ocConvId = null;
    if (ocSub) { ocSub.unsubscribe(); ocSub = null; }
    const panel = document.getElementById('bmOrderChatPanel');
    if (!panel) return;
    const clientId = bmClientDisplayId(order);
    panel.innerHTML = `
      <div class="bm-chat-head">
        <div class="bm-chat-left">
          <div class="bm-chat-avatar">${esc((clientId[0] || 'C').toUpperCase())}</div>
          <div><div class="bm-chat-name">${esc(clientId)}</div></div>
        </div>
      </div>
      <div id="ocMessages" class="bm-chat-body"></div>
      <div class="bm-chat-input-bar">
        <input type="text" id="ocInput" class="bm-chat-input" placeholder="Type a message…" />
        <button id="ocSend" class="bm-chat-send">➤</button>
      </div>
    `;
    const c = document.getElementById('ocMessages')!;
    c.innerHTML = '<div style="text-align:center;color:var(--text-muted);padding:2rem;font-size:0.82rem;">Loading…</div>';
    try {
      ocConvId = await ocFindConversation(String(order.id));
      if (!ocConvId) { ocRender([]); return; }
      await ocEnsureSelf(ocConvId);
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/messages?conversation_id=eq.${ocConvId}&order=created_at.asc`,
        { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
      );
      ocRender(await res.json());
      ocSubscribe();
    } catch (err) { console.error(err); c.innerHTML = '<div style="text-align:center;color:var(--text-muted);padding:2rem;font-size:0.82rem;">Could not load chat.</div>'; }
  }

  function ocSubscribe() {
    if (!ocConvId || ocSub) return;
    ocSub = supabase.channel(`oc-${ocConvId}`)
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages', filter: `conversation_id=eq.${ocConvId}` },
        (payload: any) => {
          const m = payload.new;
          const c = document.getElementById('ocMessages')!;
          const ph = c.querySelector('.bm-chat-empty'); if (ph) c.innerHTML = '';
          const dateLabel = m.created_at ? bidChatDateLabel(m.created_at) : '';
          let divider = '';
          if (dateLabel && dateLabel !== ocLastDate) {
            ocLastDate = dateLabel;
            divider = `<div style="text-align:center;font-size:0.7rem;color:var(--text-muted);margin:0.4rem 0;">${dateLabel}</div>`;
          }
          c.insertAdjacentHTML('beforeend', divider + ocBubble(m));
          c.scrollTop = c.scrollHeight;
        }).subscribe();
  }

  async function ocSend() {
    const input = document.getElementById('ocInput') as HTMLInputElement;
    const text = input.value.trim();
    if (!text || !ocOrder) return;
    const btn = document.getElementById('ocSend') as HTMLButtonElement;
    btn.disabled = true; input.value = '';
    try {
      if (!ocConvId) {
        const title = `Order ${ocOrder.order_number || ocOrder.id}`;
        const cRes = await fetch(`${SUPABASE_URL}/rest/v1/conversations`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=representation' },
          body: JSON.stringify({ type: 'order', order_id: Number(ocOrder.id), title })
        });
        ocConvId = (await cRes.json())[0]?.id;
        if (!ocConvId) throw new Error('Could not create conversation');
        await ocEnsureSelf(ocConvId);
        ocSubscribe();
      }
      await fetch(`${SUPABASE_URL}/rest/v1/messages`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ conversation_id: ocConvId, sender_id: currentSession.user.id, sender_name: writerData?.full_name || 'Writer', sender_role: 'writer', content: text })
      });
      await fetch(`${SUPABASE_URL}/rest/v1/conversations?id=eq.${ocConvId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=minimal' },
        body: JSON.stringify({ updated_at: new Date().toISOString() })
      });
    } catch (err) { console.error(err); alert('Could not send message. Please try again.'); }
    btn.disabled = false; input.focus();
  }

  document.addEventListener('click', (e) => { if ((e.target as HTMLElement)?.id === 'ocSend') ocSend(); });
  document.addEventListener('keydown', (e) => { if ((e.target as HTMLElement)?.id === 'ocInput' && (e as KeyboardEvent).key === 'Enter') { e.preventDefault(); ocSend(); } });

  async function showProposalDetail(bid: any) {
    const o = bid.orders || {};

    // Fetch full order details if topic is missing
    let order = o;
    if (!order.topic && bid.order_id) {
      try {
        const r = await fetch(
          `${SUPABASE_URL}/rest/v1/orders?id=eq.${bid.order_id}&select=id,order_number,topic,assignment_type,pages,deadline,order_status,instructions,education_level,subject,language,service,created_at,client_email,total_amount`,
          { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
        );
        const data = await r.json();
        if (data[0]) order = data[0];
      } catch(e) { console.error(e); }
    }
    // bid.orders never includes an id field (only order_number, topic, etc.) — without this,
    // showBidModal's existingBid lookup (which matches on order.id) always fails to find the
    // bid, incorrectly showing the "no bid yet" state even when a bid clearly exists.
    if (order.id === undefined || order.id === null) {
      order.id = bid.order_id;
    }
    // Ensure total_amount is present so showBidModal's stats/bid-strip math works correctly
    if (order.total_amount === undefined || order.total_amount === null) {
      order.total_amount = bid.bid_price;
    }
    // Reuse the exact same redesigned modal used for Available Orders — one source of truth
    // for the bid-strip / tabs / chat, instead of a second parallel implementation.
    showBidModal(order);
    return;

    }
 
