<script>
  import { supabase } from '../lib/supabase.js';
  import { io } from 'socket.io-client';
  const BIDDING_SERVER = 'https://thesisarcpro.onrender.com';
  const socket = io(BIDDING_SERVER, { transports: ['websocket'] });
 
  socket.on('connect', () => console.log('Connected to bidding server:', socket.id));
  socket.on('disconnect', () => console.log('Disconnected from bidding server'));
 
  const base = '';
  const SUPABASE_URL = 'https://rehvwvujuamehoanfomj.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_CKxnbue4T6cVn9BOIg8BkQ_kBNBiM_h';
 
  let allOrders: any[] = [];
  let currentTab = 'in_progress';
  let currentProfileTab = 'overview';
  let currentSession: any = null;
  let writerId: number | null = null;
  let writerData: any = null;
  let writerReviews: any[] = [];
  let activeOrderId: number | null = null;
  let activeOrderNumber = '';
  let availableOrders: any[] = [];
  let myBids: any[] = [];
  let currentProposalTab = 'pending';
 
  function esc(v: any) {
    return String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
 
  const CLOCK_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;display:inline-block;"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M5 3 2 6"/><path d="m22 6-3-3"/><path d="M6.38 18.7 4 21"/><path d="M17.64 18.67 20 21"/></svg>`;
  const WARNING_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;display:inline-block;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>`;

  function deadlineInfo(deadline: string) {
    if (!deadline) return { text: 'No deadline', cls: '' };
    const diff = new Date(deadline).getTime() - Date.now();
    const days = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    if (diff < 0) return { text: `${WARNING_ICON_SVG} ${Math.abs(days)}d overdue`, cls: 'overdue' };
    if (days === 0 && hours > 0) return { text: `${CLOCK_ICON_SVG} ${hours}h left`, cls: 'urgent' };
    if (days <= 2) return { text: `${CLOCK_ICON_SVG} ${days}d left`, cls: 'urgent' };
    return { text: `${CLOCK_ICON_SVG} ${days}d left`, cls: 'ok' };
  }
 
  function statusClass(status: string) {
    const known = ['new','in_progress','in_review','completed','revision','cancelled'];
    return known.includes(status) ? status : 'new';
  }
 
  async function init() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { window.location.replace(`${base}/writer-login/`); return; }
    currentSession = session;
 
    const res = await fetch(
      `${SUPABASE_URL}/rest/v1/writers?auth_user_id=eq.${session.user.id}&select=*`,
      { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${session.access_token}` } }
    );
    const data = await res.json();
    if (!data.length) {
      await supabase.auth.signOut();
      window.location.replace(`${base}/writer-login/`);
      return;
    }
 
    writerData = data[0];
    writerId = writerData.id;

    // Populate the sidebar profile pill + popover with real data
    const pillName = document.getElementById('sidebarProfileName');
    const popName = document.getElementById('sidebarPopName');
    const pillAvatar = document.getElementById('sidebarProfileAvatar');
    const popAvatar = document.getElementById('sidebarPopAvatar');
    const popStatus = document.getElementById('sidebarPopStatus');
    const shortName = (writerData.full_name || '').trim();
    if (pillName) pillName.textContent = shortName || 'Writer';
    if (popName) popName.textContent = shortName || 'Writer';
    if (writerData.photo_url) {
      const avatarHtml = `<img src="${writerData.photo_url}" alt="" />`;
      if (pillAvatar) pillAvatar.innerHTML = avatarHtml;
      if (popAvatar) popAvatar.innerHTML = avatarHtml;
    }
    if (popStatus) {
      popStatus.innerHTML = `<span class="sp-pop-status-dot"></span>${writerData.is_active ? 'Active' : 'Offline'}`;
      popStatus.classList.toggle('offline', !writerData.is_active);
    }
 
    socket.emit('writer:online', String(writerId));
 
    socket.on('order:available', async () => {
      await loadAvailableOrders();
      const badge = document.getElementById('availBadge');
      if (badge) {
        const current = parseInt(badge.textContent || '0') || 0;
        badge.textContent = String(current + 1);
        (badge as HTMLElement).style.display = 'inline-flex';
      }
    });
 
    socket.on('bid:accepted', (data: any) => {
      loadOrders();
      loadMyBids();
      const badge = document.getElementById('notifBadge');
      if (badge) { badge.textContent = '!'; (badge as HTMLElement).style.display = 'inline-flex'; }
    });

    // bid:accept fired by client when they hire a writer
    socket.on('bid:accept', (data: any) => {
      const orderId = String(data.orderId);
      const hiredWriterId = String(data.writerId);
      // Remove from available orders instantly
      availableOrders = availableOrders.filter((o: any) => String(o.id) !== orderId);
      renderAvailableOrders();
      // If we are the hired writer — reload our orders to show it in My Orders
      if (hiredWriterId === String(writerId)) {
        loadOrders();
        loadMyBids();
        const badge = document.getElementById('notifBadge');
        if (badge) { badge.textContent = '!'; (badge as HTMLElement).style.display = 'inline-flex'; }
      } else {
        // We were not hired — remove our proposal for this order too
        myBids = myBids.filter((b: any) => String(b.order_id) !== orderId);
        renderProposals();
      }
    });
 
    // Real-time: order assigned to writer
    supabase.channel(`writer-orders-${writerId}`)
      .on('postgres_changes', {
        event: 'UPDATE',
        schema: 'public',
        table: 'orders',
        filter: `writer_id=eq.${writerId}`
      }, async () => {
        await loadOrders();
        await loadMyBids();
        await refreshNotifBadge();
      })
      .subscribe();
 
    // Real-time: new available orders
    let newAvailCount = 0;
    supabase.channel('new-available-orders')
      .on('postgres_changes', {
        event: 'INSERT',
        schema: 'public',
        table: 'orders'
      }, (payload: any) => {
        if (payload.new?.order_status === 'open_for_bids') {
          newAvailCount++;
          const badge = document.getElementById('availBadge');
          if (badge) { badge.textContent = String(newAvailCount); badge.style.display = 'inline-flex'; }
        }
      })
      .subscribe();
 
    supabase.channel('order-status-changes')
      .on('postgres_changes', {
        event: 'UPDATE',
        schema: 'public',
        table: 'orders'
      }, (payload: any) => {
        const updated = payload.new;
        if (updated.order_status !== 'open_for_bids') {
          availableOrders = availableOrders.filter((o: any) => String(o.id) !== String(updated.id));
          renderAvailableOrders();
          myBids = myBids.filter((b: any) => String(b.order_id) !== String(updated.id) || updated.writer_id === writerId);
          renderProposals();
        }
      })
      .subscribe();

    document.querySelector('.nav-item[data-view="available"]')?.addEventListener('click', () => {
      newAvailCount = 0;
      const badge = document.getElementById('availBadge');
      if (badge) badge.style.display = 'none';
    }, { capture: true });
    const nameEl = document.getElementById('writerName');
    const subEl = document.getElementById('writerSub');
    if (nameEl) nameEl.textContent = 'My Orders';
    if (subEl) subEl.textContent = `Welcome back, ${writerData.full_name}`;
 
    await loadOrders();
    await loadWriterReviews();
    await loadAvailableOrders();
    await loadMyBids();
    await refreshNotifBadge();
  }
 
  // ═══ AVAILABLE ORDERS (bidding) ═══
  async function loadAvailableOrders() {
    const loading = document.getElementById('availLoadingState');
    const empty = document.getElementById('availEmptyState');
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/open_orders_for_writer`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ p_writer_id: writerId })
      });
      availableOrders = await res.json();
      renderAvailableOrders();
    } catch (err) {
      console.error(err);
      if (loading) (loading as HTMLElement).style.display = 'none';
      if (empty) (empty as HTMLElement).style.display = 'flex';
    }
  }
 
  function renderAvailableOrders() {
    const loading = document.getElementById('availLoadingState')!;
    const empty = document.getElementById('availEmptyState')!;
    const table = document.getElementById('availTable')!;
    const list = document.getElementById('availList')!;
    const search = (document.getElementById('availSearchInput') as HTMLInputElement)?.value.toLowerCase() || '';
 
    loading.style.display = 'none';
 
    let filtered = availableOrders;
    if (search) {
      filtered = filtered.filter((o: any) => (o.topic || '').toLowerCase().includes(search) || (o.subject || '').toLowerCase().includes(search));
    }
 
    if (!filtered.length) {
      empty.style.display = 'flex';
      table.style.display = 'none';
      return;
    }
    empty.style.display = 'none';
    table.style.display = 'flex';
 
    list.innerHTML = filtered.map((o: any) => {
      const dl = deadlineInfo(o.deadline);
      const budget = Number(o.total_amount||0).toFixed(2);
      return `
        <div class="order-row" data-id="${esc(o.id)}" style="justify-content:space-between;">
          <div class="col-left">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.3rem;">
              <span class="status-badge in_progress" style="background:rgba(34,197,94,0.12);color:#4ade80;">Available</span>
              <span class="meta-dot">·</span>
              <span style="font-size:0.76rem;color:#64748b;">${esc(o.pages||1)} page${(o.pages||1)>1?'s':''}</span>
              <span class="meta-dot">·</span>
              <span style="font-size:0.76rem;color:#64748b;">${esc(o.assignment_type||'Essay')}</span>
              <span class="meta-dot">·</span>
              <span class="order-id" style="font-size:0.76rem;">ID ${esc(o.order_number||o.id)}</span>
            </div>
            <div class="order-title">${esc(o.topic || '(no topic)')}</div>
          </div>
          <div class="col-right" style="display:flex;align-items:center;gap:2rem;">
            <div class="col-deadline ${dl.cls}">${dl.text}</div>
            <div style="font-size:0.9rem;font-weight:700;color:#4ade80;">$${budget}</div>
          </div>
        </div>`;
    }).join('');
 
    list.querySelectorAll('.order-row').forEach(row => {
      row.addEventListener('click', () => {
        const id = (row as HTMLElement).dataset.id;
        const order = availableOrders.find((o: any) => String(o.id) === id);
        if (order) showBidModal(order);
      });
    });
  }
 
  document.getElementById('availSearchInput')?.addEventListener('input', renderAvailableOrders);
 
  let bmActiveTab = 'instructions';
  let bmCurrentOrder: any = null;

  function bmClientDisplayId(order: any) {
    // No real client_id field exists on orders yet — derive an ID-style value from client_email.
    // If a real client_id column gets added later, swap this one line for: return order.client_id;
    return (order.client_email || 'client').split('@')[0];
  }

  function showBidModal(order: any) {
    bmCurrentOrder = order;
    bmActiveTab = 'instructions';
    const dl = deadlineInfo(order.deadline);
    const dueDate = order.deadline ? new Date(order.deadline).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—';
    const budget = Number(order.total_amount||0).toFixed(2);
    const myShare = (Number(order.total_amount||0) * 0.2).toFixed(2);
    const existingBid = myBids.find((b: any) => String(b.order_id) === String(order.id));

    document.getElementById('modalContent')!.innerHTML = `
      <div class="modal-left">
        <div class="bm-header">
          <div>
            <div class="bm-title">${esc(order.topic || '(no topic)')}</div>
          </div>
          <div class="bm-head-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></div>
        </div>
        <div class="bm-id-row">
          <span>ID ${esc(order.order_number || order.id)}</span>
          ${existingBid ? `<span class="bm-status-pill">Open</span><span>·</span><span>⏰ ${dl.text}</span>` : `<span>· ${dueDate} · ${dl.text}</span>`}
        </div>

        ${existingBid ? `
        <div class="bm-bid-strip">
          <div class="bm-bid-col"><div class="bm-bid-lbl">My proposal</div><div class="bm-bid-val gold">$${Number(existingBid.bid_price).toFixed(2)}</div></div>
          <div class="bm-bid-col"><div class="bm-bid-lbl">My share</div><div class="bm-bid-val">$${(Number(existingBid.bid_price)*0.2).toFixed(2)}</div></div>
          <div class="bm-bid-col"><div class="bm-bid-lbl">Proposal placed</div><div class="bm-bid-val small">${existingBid.created_at ? new Date(existingBid.created_at).toLocaleString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '—'}</div></div>
          <button class="bm-edit-btn" id="bmEditProposalBtn">Edit proposal</button>
        </div>` : `
        <div class="bm-stats-strip">
          <div class="bm-stat"><div class="bm-stat-lbl">Min. price</div><div class="bm-stat-val">$${budget}</div></div>
          <div class="bm-stat"><div class="bm-stat-lbl">My share</div><div class="bm-stat-val gold">$${myShare}</div></div>
          <div class="bm-stat"><div class="bm-stat-lbl">Pages</div><div class="bm-stat-val">${esc(order.pages||1)}</div></div>
        </div>
        <button class="bm-make-proposal-btn" id="bmMakeProposalBtn">Make proposal</button>`}

        <div class="bm-tabs">
          <button class="bm-tab bm-tab--active" data-bmtab="instructions">Instructions</button>
          <button class="bm-tab" data-bmtab="files">Files</button>
        </div>

        <div class="bm-panel bm-panel--active" data-bmpanel="instructions">
          <div class="bm-instr-label">Topic</div>
          <div class="bm-instr-value">${esc(order.topic || '(no topic)')}</div>
          <div class="bm-instr-grid">
            <div class="bm-instr-field"><div class="bm-lbl">Type</div><div class="bm-val">${esc(order.assignment_type||'—')}</div></div>
            <div class="bm-instr-field"><div class="bm-lbl">Subject</div><div class="bm-val">${esc(order.subject||'—')}</div></div>
            <div class="bm-instr-field"><div class="bm-lbl">Education level</div><div class="bm-val">${esc(order.education_level||'—')}</div></div>
            <div class="bm-instr-field"><div class="bm-lbl">Language</div><div class="bm-val">${esc(order.language||'—')}</div></div>
            <div class="bm-instr-field"><div class="bm-lbl">Service</div><div class="bm-val">${esc(order.service||'—')}</div></div>
            <div class="bm-instr-field"><div class="bm-lbl">Deadline</div><div class="bm-val">${dueDate}</div></div>
          </div>
          <div class="bm-instr-desc-label">Description</div>
          <div class="bm-instr-desc">${order.instructions ? esc(order.instructions) : 'No description provided.'}</div>
        </div>
        <div class="bm-panel" data-bmpanel="files">
          <div style="color:var(--text-muted);font-size:0.82rem;padding:1rem 0;">No files attached.</div>
        </div>
      </div>
      <div class="bm-chat-panel" id="bmChatPanel"></div>
    `;

    // Tab switching (Instructions / Files)
    document.getElementById('modalContent')!.querySelectorAll('.bm-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const which = (tab as HTMLElement).dataset.bmtab!;
        bmActiveTab = which;
        document.querySelectorAll('#modalContent .bm-tab').forEach(t => t.classList.remove('bm-tab--active'));
        document.querySelectorAll('#modalContent .bm-panel').forEach(p => p.classList.remove('bm-panel--active'));
        tab.classList.add('bm-tab--active');
        document.querySelector(`#modalContent .bm-panel[data-bmpanel="${which}"]`)?.classList.add('bm-panel--active');
      });
    });

    document.getElementById('bmMakeProposalBtn')?.addEventListener('click', () => openBmProposal(false));
    document.getElementById('bmEditProposalBtn')?.addEventListener('click', () => openBmProposal(true));

    document.getElementById('detailModal')!.classList.add('open');

    // Render chat panel: empty state if no bid yet, otherwise starts the real chat (Step 4 wires this fully)
    if (existingBid) {
      bidChatStart(order.id, order, existingBid.note || '');
    } else {
      renderBmChatEmpty();
    }
  }

  function renderBmChatEmpty() {
    const panel = document.getElementById('bmChatPanel');
    if (!panel) return;
    panel.innerHTML = `
      <div class="bm-chat-head">
        <div class="bm-chat-left">
          <div class="bm-chat-avatar"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.925 20.056a6 6 0 0 0-11.851.001"/><circle cx="12" cy="11" r="4"/><circle cx="12" cy="12" r="10"/></svg></div>
          <div><div class="bm-chat-name">—</div><div class="bm-chat-sub">Place a proposal to chat</div></div>
        </div>
      </div>
      <div class="bm-chat-empty">
        <div class="bm-chat-empty-icon">💬</div>
        <p>Make a proposal to start a conversation</p>
      </div>`;
  }
 
  let bidChatConvId: string | null = null;
  let bidChatSubRT: any = null;
  let bidChatLastDate = '';
 
  // ═══ PROPOSAL POPUP (Step 3) ═══
  let bmPbAmount = 0;
  let bmPbIsEdit = false;

  function bmPbPages(order: any) {
    return Number(order.pages || 1) || 1;
  }

  function openBmProposal(isEdit: boolean) {
    if (!bmCurrentOrder) return;
    bmPbIsEdit = isEdit;
    const order = bmCurrentOrder;
    const budget = Number(order.total_amount || 0);
    const existingBid = myBids.find((b: any) => String(b.order_id) === String(order.id));
    bmPbAmount = isEdit && existingBid ? Number(existingBid.bid_price) : budget;

    (document.getElementById('bmPbHeading') as HTMLElement).textContent = isEdit ? 'Edit proposal' : 'Make proposal';
    (document.getElementById('bmPbMinDisplay') as HTMLElement).textContent = budget.toFixed(2);
    const msgEl = document.getElementById('bmPbMsg')!;
    msgEl.style.display = 'none';
    const confirmBtn = document.getElementById('bmPbConfirmBtn') as HTMLButtonElement;
    confirmBtn.disabled = false;
    confirmBtn.textContent = isEdit ? 'Update proposal' : 'Confirm proposal';

    updateBmProposalDisplay();
    document.getElementById('bmProposalOverlay')!.classList.add('open');
  }

  function closeBmProposal() {
    document.getElementById('bmProposalOverlay')!.classList.remove('open');
  }

  function bmAdjustAmount(dir: number) {
    if (!bmCurrentOrder) return;
    const budget = Number(bmCurrentOrder.total_amount || 0);
    bmPbAmount = Math.max(budget, bmPbAmount + dir);
    updateBmProposalDisplay();
  }

  function updateBmProposalDisplay() {
    if (!bmCurrentOrder) return;
    const pages = bmPbPages(bmCurrentOrder);
    const costPerPage = bmPbAmount / pages;
    const share = bmPbAmount * 0.2; // writer gets 20%, platform keeps 80%
    const myCostPerPage = share / pages;
    (document.getElementById('bmPbAmountDisplay') as HTMLElement).textContent = bmPbAmount.toFixed(2);
    (document.getElementById('bmPbCostPerPage') as HTMLElement).textContent = '$' + costPerPage.toFixed(2);
    (document.getElementById('bmPbMyShare') as HTMLElement).textContent = '$' + share.toFixed(2);
    (document.getElementById('bmPbMyCostPerPage') as HTMLElement).textContent = '$' + myCostPerPage.toFixed(2);
  }

  document.getElementById('bmPbCloseBtn')?.addEventListener('click', closeBmProposal);
  document.getElementById('bmPbCancelBtn')?.addEventListener('click', closeBmProposal);
  document.getElementById('bmProposalOverlay')?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).id === 'bmProposalOverlay') closeBmProposal();
  });
  document.getElementById('bmPbStepUp')?.addEventListener('click', () => bmAdjustAmount(1));
  document.getElementById('bmPbStepDown')?.addEventListener('click', () => bmAdjustAmount(-1));
  document.getElementById('bmPbConfirmBtn')?.addEventListener('click', () => {
    if (bmCurrentOrder) submitBid(bmCurrentOrder.id, bmCurrentOrder);
  });

  async function submitBid(orderId: number, order: any) {
    const price = bmPbAmount;
    const note = ''; // message is no longer collected up front — writer sends it via chat after the proposal is placed
    const msg = document.getElementById('bmPbMsg')!;
    const btn = document.getElementById('bmPbConfirmBtn') as HTMLButtonElement;

    if (!price || price <= 0) { msg.textContent = 'Please enter a valid bid price.'; msg.className = 'upload-msg error'; msg.style.display = 'block'; return; }

    btn.disabled = true; btn.textContent = '⏳ Submitting…';
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/place_bid`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ p_order_id: orderId, p_writer_id: writerId, p_bid_price: price, p_estimated_delivery: null, p_note: note })
      });
      if (!res.ok) throw new Error((await res.json())?.message || 'Failed to place bid');

      // Emit bid to client via Socket.io
      socket.emit('bid:submit', {
        orderId: String(orderId),
        writerId: String(writerId),
        writerName: writerData?.full_name || 'Writer',
        amount: price,
        message: note
      });

      await loadAvailableOrders();
      await loadMyBids();

      closeBmProposal();
      // Re-render the modal so the bid-strip / chat now reflect the placed proposal
      showBidModal(order);

    } catch (err: any) {
      msg.textContent = err?.message || 'Could not submit proposal.'; msg.className = 'upload-msg error'; msg.style.display = 'block';
      btn.disabled = false; btn.textContent = bmPbIsEdit ? 'Update proposal' : 'Confirm proposal';
    }
  }
 
  async function bidChatStart(orderId: number, order: any, note: string) {
    const panel = document.getElementById('bmChatPanel');
    if (panel && !panel.querySelector('#bidChatMessages')) {
      const clientId = bmClientDisplayId(order);
      panel.innerHTML = `
        <div class="bm-chat-head">
          <div class="bm-chat-left">
            <div class="bm-chat-avatar">${esc((clientId[0] || 'C').toUpperCase())}</div>
            <div>
              <div class="bm-chat-name">${esc(clientId)}</div>
              <div class="bm-chat-sub" id="bidChatSub">Waiting for client reply</div>
            </div>
          </div>
        </div>
        <div id="bidChatMessages" class="bm-chat-body"></div>
        <div id="bidChatInputBar" class="bm-chat-input-bar">
          <input type="text" id="bidChatInput" class="bm-chat-input" placeholder="Type a message…" />
          <button id="bidChatSend" class="bm-chat-send">➤</button>
        </div>
      `;
      document.getElementById('bidChatSend')?.addEventListener('click', bidChatSendMsg);
      document.getElementById('bidChatInput')?.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); bidChatSendMsg(); } });
    }
 
    const messagesBox = document.getElementById('bidChatMessages');
    if (!messagesBox) return;
    bidChatLastDate = '';
 
    try {
      let convId = await ocFindConversation(String(orderId));
      if (!convId) {
        const title = `Order ${order.order_number || orderId}`;
        const cRes = await fetch(`${SUPABASE_URL}/rest/v1/conversations`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=representation' },
          body: JSON.stringify({ type: 'order', order_id: Number(orderId), title })
        });
        convId = (await cRes.json())[0]?.id;
      }
      if (!convId) throw new Error('Could not create conversation');
      await ocEnsureSelf(convId);
 
      // Only seed a first message if a non-empty note was passed in (older bids may still have one;
      // new proposals no longer collect a note up front, so the chat simply starts empty).
      if (note && note.trim()) {
        const existingRes = await fetch(
          `${SUPABASE_URL}/rest/v1/messages?conversation_id=eq.${convId}&select=id&limit=1`,
          { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
        );
        const existing = await existingRes.json();
        if (!existing.length) {
          await fetch(`${SUPABASE_URL}/rest/v1/messages`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
            body: JSON.stringify({ conversation_id: convId, sender_id: currentSession.user.id, sender_name: writerData?.full_name || 'Writer', sender_role: 'writer', content: note })
          });
        }
      }
 
      bidChatConvId = convId;
 
      const mRes = await fetch(
        `${SUPABASE_URL}/rest/v1/messages?conversation_id=eq.${convId}&order=created_at.asc`,
        { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
      );
      bidChatRender(await mRes.json());
 
      if (bidChatSubRT) { bidChatSubRT.unsubscribe(); bidChatSubRT = null; }
      bidChatSubRT = supabase.channel(`bidchat-${convId}`)
        .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages', filter: `conversation_id=eq.${convId}` },
          (payload: any) => bidChatAppend(payload.new)).subscribe();
 
    } catch (e) { console.error('bidChatStart error', e); }
  }
 
  function bidChatDateLabel(dateStr: string) {
    const d = new Date(dateStr);
    const today = new Date();
    if (d.toDateString() === today.toDateString()) return 'Today';
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }
  function bidChatRender(messages: any[]) {
    const c = document.getElementById('bidChatMessages');
    if (!c) return;
    if (!messages.length) { c.innerHTML = `<div class="bm-chat-empty"><div class="bm-chat-empty-icon">✉️</div><p>Send a message to start conversation</p></div>`; return; }
    bidChatLastDate = '';
    c.innerHTML = messages.map((m: any) => {
      const dateLabel = m.created_at ? bidChatDateLabel(m.created_at) : '';
      let divider = '';
      if (dateLabel && dateLabel !== bidChatLastDate) {
        bidChatLastDate = dateLabel;
        divider = `<div style="text-align:center;font-size:0.7rem;color:var(--text-muted);margin:0.4rem 0;">${dateLabel}</div>`;
      }
      return divider + bidChatBubble(m);
    }).join('');
    c.scrollTop = c.scrollHeight;
  }
  function bidChatAppend(m: any) {
    const c = document.getElementById('bidChatMessages');
    if (!c) return;
    const ph = c.querySelector('.bm-chat-empty'); if (ph) c.innerHTML = '';
    const dateLabel = m.created_at ? bidChatDateLabel(m.created_at) : '';
    let divider = '';
    if (dateLabel && dateLabel !== bidChatLastDate) {
      bidChatLastDate = dateLabel;
      divider = `<div style="text-align:center;font-size:0.7rem;color:var(--text-muted);margin:0.4rem 0;">${dateLabel}</div>`;
    }
    c.insertAdjacentHTML('beforeend', divider + bidChatBubble(m));
    c.scrollTop = c.scrollHeight;
  }
  function bidChatBubble(m: any) {
    const mine = m.sender_id === currentSession.user.id;
    const time = m.created_at ? new Date(m.created_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '';
    const who = m.sender_role === 'support' ? 'Support' : (m.sender_name || 'Client');
    return `<div class="bm-msg ${mine ? 'mine' : 'theirs'}">
      ${!mine ? `<div class="bm-msg-sender">${esc(who)}</div>` : ''}
      <div class="bm-bubble">${esc(m.content)}</div>
      <div class="bm-msg-meta">${time}${mine ? ' ✓' : ''}</div>
    </div>`;
  }
 
  async function bidChatSendMsg() {
    const input = document.getElementById('bidChatInput') as HTMLInputElement;
    if (!input || !bidChatConvId) return;
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    try {
      await fetch(`${SUPABASE_URL}/rest/v1/messages`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ conversation_id: bidChatConvId, sender_id: currentSession.user.id, sender_name: writerData?.full_name || 'Writer', sender_role: 'writer', content: text })
      });
      await fetch(`${SUPABASE_URL}/rest/v1/conversations?id=eq.${bidChatConvId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=minimal' },
        body: JSON.stringify({ updated_at: new Date().toISOString() })
      });
    } catch (e) { console.error(e); }
  }
 
  // ═══ MY PROPOSALS (bids placed) ═══
  async function loadMyBids() {
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/my_bids_with_orders`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ p_writer_id: writerId })
      });
      const rows = await res.json();
      // Reshape to match the old { ...bid, orders: {...} } structure used by renderProposals/showProposalDetail
      myBids = (Array.isArray(rows) ? rows : []).map((r: any) => ({
        id: r.id,
        order_id: r.order_id,
        bid_price: r.bid_price,
        status: r.status,
        created_at: r.created_at,
        note: r.note,
        orders: {
          order_number: r.order_number,
          topic: r.topic,
          deadline: r.deadline,
          assignment_type: r.assignment_type,
          order_status: r.order_status,
          instructions: r.instructions,
          education_level: r.education_level,
          subject: r.subject,
          language: r.language,
          service: r.service,
          pages: r.pages,
          client_email: r.client_email
        }
      }));
      renderProposals();
    } catch (err) { console.error(err); }
  }
