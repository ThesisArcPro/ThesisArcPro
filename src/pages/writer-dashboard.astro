  .bm-proposal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.65); display: none; align-items: center; justify-content: center; z-index: 200; }
  .bm-proposal-overlay.open { display: flex; }
  .bm-proposal-box { width: 92%; max-width: 380px; background: var(--panel-bg); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; }
  .bm-pb-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.1rem; }
  .bm-pb-head h3 { font-size: 1rem; font-weight: 700; margin: 0; color: var(--text); }
  .bm-pb-close { background: none; border: none; color: var(--text-muted); font-size: 1rem; cursor: pointer; }
  .bm-pb-close:hover { color: var(--text); }

  .bm-pb-amount-box { border: 1.5px solid #c5a059; border-radius: 10px; padding: 0.75rem 1rem; display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.4rem; background: var(--main-bg); }
  .bm-pb-amount-left { display: flex; flex-direction: column; }
  .bm-pb-amount-label { font-size: 0.66rem; color: var(--text-muted); margin-bottom: 0.15rem; }
  .bm-pb-amount-val { font-size: 1.2rem; font-weight: 700; color: var(--text); display: flex; align-items: baseline; gap: 0.15rem; }
  .bm-pb-amount-val .bm-cur { font-size: 0.92rem; color: var(--text-muted); }
  .bm-pb-steppers { display: flex; flex-direction: column; gap: 0.15rem; }
  .bm-pb-step-btn { width: 22px; height: 18px; border-radius: 4px; border: 1px solid var(--border); background: var(--panel-bg); color: var(--text-muted); cursor: pointer; font-size: 0.62rem; display: flex; align-items: center; justify-content: center; }
  .bm-pb-step-btn:hover { border-color: #c5a059; color: #c5a059; }
  .bm-pb-min { font-size: 0.68rem; color: var(--text-muted); margin-bottom: 1rem; }

  .bm-pb-msg-label { font-size: 0.72rem; font-weight: 600; color: var(--text); margin-bottom: 0.4rem; display: block; }
  .bm-pb-msg-textarea { width: 100%; background: var(--main-bg); border: 1px solid var(--border); border-radius: 8px; padding: 0.6rem 0.75rem; font-size: 0.82rem; font-family: inherit; color: var(--text); outline: none; resize: vertical; margin-bottom: 1rem; }
  .bm-pb-msg-textarea:focus { border-color: #c5a059; }

  .bm-pb-breakdown { display: flex; flex-direction: column; gap: 0.55rem; margin-bottom: 1.3rem; }
  .bm-pb-row { display: flex; justify-content: space-between; font-size: 0.8rem; }
  .bm-pb-row .bm-lbl { color: var(--text-muted); }
  .bm-pb-row .bm-val { color: var(--text); font-weight: 600; }

  .bm-pb-actions { display: flex; gap: 0.6rem; }
  .bm-pb-cancel { flex: 1; padding: 0.65rem; border-radius: 9px; border: 1px solid var(--border); background: var(--main-bg); color: var(--text); font-size: 0.82rem; font-weight: 600; cursor: pointer; font-family: inherit; }
  .bm-pb-cancel:hover { border-color: var(--text-muted); }
  .bm-pb-confirm { flex: 1.4; padding: 0.65rem; border-radius: 9px; border: none; background: #c5a059; color: #1a1206; font-size: 0.82rem; font-weight: 700; cursor: pointer; font-family: inherit; }
  .bm-pb-confirm:hover { background: #d4b473; }
  .bm-pb-confirm:disabled { background: var(--border); color: var(--text-muted); cursor: not-allowed; }
  .modal-left { flex: 3; padding: 2.75rem 2.5rem 2rem; overflow-y: auto; min-width: 0; min-height: 0; height: 100%; }
  .modal-right { flex: 0 0 26%; background: var(--main-bg); border-left: 1.5px solid var(--border); display: flex; flex-direction: column; min-width: 180px; height: 100%; }
  #modalContent { min-height: 0; }
  .bm-chat-panel { flex: 0 0 32%; }

  @media (max-width: 720px) {
    .modal-left { flex: 1 1 50%; height: auto; padding: 1.2rem; }
    .modal-right, .bm-chat-panel { width: 100%; flex: 1 1 50%; border-left: none; border-top: 1px solid var(--border); height: auto; }
  }
  .bm-instr-desc, .bm-chat-body { overflow-y: auto; }
  .bm-instr-desc::-webkit-scrollbar,
  .bm-chat-body::-webkit-scrollbar,
  .modal-left::-webkit-scrollbar { width: 6px; }
  .bm-instr-desc::-webkit-scrollbar-track,
  .bm-chat-body::-webkit-scrollbar-track,
  .modal-left::-webkit-scrollbar-track { background: transparent; }
  .bm-instr-desc::-webkit-scrollbar-thumb,
  .modal-left::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
  .bm-chat-body::-webkit-scrollbar-thumb { background: #3a4150; border-radius: 3px; }
  .bm-instr-desc::-webkit-scrollbar-thumb:hover,
  .modal-left::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  .bm-chat-body::-webkit-scrollbar-thumb:hover { background: #4a5160; }

  /* ══ MY ORDERS — file upload area (gold theme) ══ */
  .bm-upload-label { font-size: 0.66rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.35rem; }
  .bm-upload-select { width: 100%; background: var(--main-bg); border: 1px solid var(--border); border-radius: 8px; padding: 0.55rem 0.75rem; font-size: 0.83rem; color: var(--text); font-family: inherit; outline: none; margin-bottom: 1rem; }
  .bm-upload-select:focus { border-color: #c5a059; }
  .bm-dropzone { position: relative; border: 1.5px dashed var(--border); border-radius: 10px; padding: 0.7rem 1rem; text-align: center; cursor: pointer; transition: 0.2s; background: var(--main-bg); margin-bottom: 1rem; }
  .bm-dropzone:hover { border-color: #c5a059; }
  .bm-dropzone p { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.4rem; }
  .bm-dropzone .bm-dz-filename { font-size: 0.78rem; color: #c5a059; font-weight: 600; margin-top: 0.4rem; }
  .bm-dropzone input[type="file"] { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
  .bm-upload-btn { background: #c5a059; color: #1a1206; border: none; border-radius: 8px; padding: 0.6rem 1.2rem; font-size: 0.83rem; font-weight: 700; cursor: pointer; font-family: inherit; }
  .bm-upload-btn:hover { background: #d4b473; }
  .bm-upload-btn:disabled { background: var(--border); color: var(--text-muted); cursor: not-allowed; }
  .bm-files-section { margin-top: 1.2rem; }
  .bm-files-section h3 { font-size: 0.82rem; font-weight: 700; margin-bottom: 0.6rem; color: var(--text); }
  .bm-file-row { display: flex; align-items: center; justify-content: space-between; background: var(--main-bg); border: 1px solid var(--border); border-radius: 8px; padding: 0.55rem 0.75rem; gap: 0.6rem; margin-bottom: 0.4rem; }
  .bm-file-type-badge { background: rgba(197,160,89,0.15); color: #c5a059; font-size: 0.66rem; font-weight: 600; padding: 0.15rem 0.45rem; border-radius: 5px; white-space: nowrap; }
  .bm-file-name { font-size: 0.8rem; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bm-review-btn { width: 100%; background: #c5a059; color: #1a1206; border: none; border-radius: 8px; padding: 0.8rem 1.2rem; font-size: 0.88rem; font-weight: 700; cursor: pointer; margin-top: 1.2rem; font-family: inherit; }
  .bm-review-btn:hover { background: #d4b473; }
  .bm-review-btn:disabled { background: var(--border); color: var(--text-muted); cursor: not-allowed; }

  /* Fix: the site's thin custom scrollbar is scoped-only, so it never reaches innerHTML-rendered
     modal content (description box, chat body, etc). Duplicating it here as global makes it apply. */
  .bm-instr-desc::-webkit-scrollbar,
  .bm-chat-body::-webkit-scrollbar,
  .modal-left::-webkit-scrollbar { width: 6px; }
  .bm-instr-desc::-webkit-scrollbar-track,
  .bm-chat-body::-webkit-scrollbar-track,
  .modal-left::-webkit-scrollbar-track { background: transparent; }
  .bm-instr-desc::-webkit-scrollbar-thumb,
  .bm-chat-body::-webkit-scrollbar-thumb,
  .modal-left::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
  .bm-instr-desc::-webkit-scrollbar-thumb:hover,
  .bm-chat-body::-webkit-scrollbar-thumb:hover,
  .modal-left::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  body.dark-mode .bm-instr-desc::-webkit-scrollbar-thumb,
  body.dark-mode .bm-chat-body::-webkit-scrollbar-thumb,
  body.dark-mode .modal-left::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); }
  body.dark-mode .bm-instr-desc::-webkit-scrollbar-thumb:hover,
  body.dark-mode .bm-chat-body::-webkit-scrollbar-thumb:hover,
  body.dark-mode .modal-left::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }

  /* ══ WRITER BALANCE (wallet-style) ══ */
  .wal-wrap { padding: 0 1.5rem; }
  .wal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.1rem; }
  .wal-header h1 { font-size: 1.35rem; font-weight: 700; color: var(--text); }
  .wal-withdraw-btn { background: #046fcd; color: #fff; border: none; border-radius: 8px; padding: 0.55rem 1.1rem; font-size: 0.85rem; font-weight: 700; cursor: pointer; }
  .wal-withdraw-btn:hover { background: #0361b3; }
  .wal-tabs { display: flex; gap: 1.3rem; border-bottom: 1px solid var(--border); margin-bottom: 1rem; }
  .wal-tab { background: none; border: none; color: var(--text-muted); padding: 0.6rem 0; font-size: 0.82rem; font-weight: 600; cursor: pointer; border-bottom: 2px solid transparent; }
  .wal-tab--active { color: #046fcd; border-bottom-color: #046fcd; }

  .wal-head { display: grid; padding: 0.4rem 0.9rem; font-size: 0.66rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 6px; }
  .wal-head-txn { grid-template-columns: 1fr 0.8fr 0.8fr 1.2fr 0.8fr; }
  .wal-head-wd { grid-template-columns: 1fr 0.8fr 0.8fr; }

  .wal-row { display: grid; align-items: center; padding: 0.6rem 0.9rem; font-size: 0.78rem; background: #181818; border-radius: 6px; margin-bottom: 4px; color: #e5e5e5; }
  .wal-row-txn { grid-template-columns: 1fr 0.8fr 0.8fr 1.2fr 0.8fr; }
  .wal-row-wd { grid-template-columns: 1fr 0.8fr 0.8fr; }
  .wal-amt-credit { color: #4ade80; font-weight: 600; }
  .wal-amt-debit { color: #f87171; font-weight: 600; }
  .wal-status { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 5px; font-size: 0.65rem; font-weight: 700; width: fit-content; }
  .wal-status.success { background: rgba(34,197,94,0.15); color: #4ade80; }
  .wal-status.available { background: rgba(34,197,94,0.15); color: #4ade80; }
  .wal-status.withdrawn { background: rgba(148,163,184,0.15); color: #94a3b8; }
  .wal-status.pending { background: rgba(251,191,36,0.15); color: #fbbf24; }
  .wal-status.paid { background: rgba(34,197,94,0.15); color: #4ade80; }
  .wal-status.denied { background: rgba(239,68,68,0.14); color: #f87171; }
  .wal-note { font-size: 0.82rem; color: var(--text-muted); background: #181818; border-radius: 8px; padding: 1rem; }

  body.dark-mode .wal-header h1 { color: #e2e8f0; }
  body.dark-mode #viewBalance { background: #000000; margin: -2rem; padding: 2rem; }
  .wal-wrap { max-width: 100%; padding: 0 1.5rem; }

  .order-table { display: flex; flex-direction: column; gap: 0.35rem; }
 
  .order-table-head {
    display: flex;
    justify-content: space-between;
    padding: 0.3rem 0.85rem;
    font-size: 0.64rem;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
 
  .order-table-head-right { display: flex; gap: 3rem; }
 
  .order-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.5rem 0.85rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 7px;
    cursor: pointer;
    transition: all 0.15s;
  }
 
  .order-row:hover { background: #fafafa; border-color: rgba(99,102,241,0.4); }
 
  .col-left { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; min-width: 0; overflow: hidden; }
  .order-title { font-size: 0.82rem; font-weight: 600; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .order-meta { display: flex; align-items: center; gap: 0.3rem; font-size: 0.68rem; color: #94a3b8; white-space: nowrap; overflow: hidden; }
  .meta-dot { color: #cbd5e1; font-size: 0.65rem; }
  .order-id { color: #94a3b8; }
 
  .col-right { display: flex; align-items: center; gap: 1.6rem; flex-shrink: 0; }
  .col-deadline { font-size: 0.72rem; color: #64748b; white-space: nowrap; min-width: 70px; text-align: right; }
  .col-deadline.overdue { color: #f87171; }
  .col-deadline.urgent { color: #fb923c; }
  .col-deadline.ok { color: #34d399; }
 
  .status-badge {
    display: inline-block;
    padding: 0.12rem 0.4rem;
    border-radius: 4px;
    font-size: 0.62rem;
    font-weight: 700;
    background: rgba(251,191,36,0.12);
    color: #fbbf24;
  }
 
  .status-badge.new { background: rgba(99,102,241,0.15); color: #818cf8; }
  .status-badge.in_progress { background: rgba(251,191,36,0.15); color: #fbbf24; }
  .status-badge.in_review { background: rgba(56,138,221,0.18); color: #60a5fa; }
  .status-badge.completed { background: rgba(34,197,94,0.12); color: #4ade80; }
  .status-badge.revision { background: rgba(168,85,247,0.18); color: #c084fc; }
  .status-badge.cancelled { background: rgba(239,68,68,0.16); color: #f87171; }
 
  /* ── ORDER DETAIL MODAL ── */
  .om-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; padding-right: 1.5rem; }
  .om-title { font-size: 1.15rem; font-weight: 800; color: #0f172a; line-height: 1.4; margin-bottom: 0.2rem; }
  .om-id { font-size: 0.75rem; color: #94a3b8; margin-top: 0.3rem; }
  .om-status-badge {
    display: inline-block;
    padding: 0.22rem 0.65rem;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: capitalize;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .om-info-row { display: flex; gap: 0.75rem; margin-bottom: 1rem; }
  .om-info-card { flex: 1; background: #f1f5f9; border-radius: 10px; padding: 0.9rem 1rem; }
  .om-info-card .om-info-label {
    font-size: 0.68rem; color: #94a3b8; text-transform: uppercase;
    letter-spacing: 0.5px; margin-bottom: 0.35rem;
  }
  .om-info-card .om-info-value { font-size: 0.92rem; font-weight: 700; color: #0f172a; }
  .om-info-card .om-info-sub { font-size: 0.72rem; color: #94a3b8; margin-top: 0.2rem; }
 
  .om-tabs {
    display: flex;
    gap: 0.3rem;
    background: #f1f5f9;
    padding: 4px;
    border-radius: 12px;
    width: fit-content;
    margin-bottom: 1rem;
    border-bottom: none;
  }
 
  .om-tab {
    background: none;
    border: none;
    color: #94a3b8;
    padding: 0.45rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 9px;
    border-bottom: none;
    position: relative;
    top: 0;
    transition: all 0.2s;
  }
 
  .om-tab:hover:not(.om-tab--active) { color: #303b4f; }
  .om-tab--active {
    background: #ffffff;
    color: #046fcd;
    box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    border-bottom: none;
  }

  .dropzone {
    position: relative;
    border: 1.5px dashed #e2e8f0;
    border-radius: 10px;
    padding: 1.4rem 1rem;
    text-align: center;
    cursor: pointer;
    transition: 0.2s;
    background: #f1f5f9;
  }
  .dropzone:hover { border-color: #046fcd; background: #f8fafc; }
  .dropzone p { font-size: 0.82rem; color: #64748b; margin-top: 0.4rem; }
  .dropzone .dz-filename { font-size: 0.8rem; color: #046fcd; font-weight: 600; margin-top: 0.4rem; }
  .dropzone input[type="file"] {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; cursor: pointer;
  }
 
  .om-panel { display: none; }
  .om-panel--active { display: block; }
 
  .om-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
    margin-bottom: 1.3rem;
    padding-bottom: 1.3rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .om-grid:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
 
  .om-label {
    font-size: 0.66rem;
    color: #94a3b8;
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .om-value { font-weight: 600; font-size: 0.88rem; color: #0f172a; text-transform: capitalize; }
 
  .om-desc-label {
    font-size: 0.66rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .om-desc {
    font-size: 0.83rem;
    color: #475569;
    line-height: 1.7;
    max-height: 220px;
    overflow-y: auto;
    padding-right: 0.5rem;
    white-space: pre-wrap;
  }
 
  /* ── WRITER FILE UPLOAD ── */
  .upload-order-id { font-size: 0.82rem; color: #94a3b8; margin-bottom: 1rem; }
 
  .form-group { margin-bottom: 0.8rem; }
  .form-group label {
    display: block; font-size: 0.66rem; font-weight: 700;
    color: #94a3b8; margin-bottom: 0.3rem;
    text-transform: uppercase; letter-spacing: 0.5px;
  }
  .form-group select,
  .form-group input[type="file"] {
    width: 100%; background: #f8fafc;
    border: 1px solid #e2e8f0; border-radius: 8px;
    padding: 0.5rem 0.7rem; font-size: 0.85rem;
    color: #0f172a; font-family: inherit; outline: none;
  }
  .form-group select:focus { border-color: #046fcd; }
 
  .upload-btn {
    background: #046fcd; color: #fff; border: none;
    border-radius: 8px; padding: 0.6rem 1.2rem;
    font-size: 0.85rem; font-weight: 600; cursor: pointer;
    transition: 0.2s; font-family: inherit; margin-top: 0.4rem;
  }
  .upload-btn:hover { background: #0361b3; }
  .upload-btn:disabled { opacity: 0.6; cursor: not-allowed; }
 
  .upload-msg { font-size: 0.82rem; margin-top: 0.6rem; padding: 0.5rem 0.7rem; border-radius: 6px; }
  .upload-msg.success { background: rgba(34,197,94,0.12); color: #4ade80; }
  .upload-msg.error { background: rgba(239,68,68,0.12); color: #f87171; }
 
  .files-section { margin-top: 1.2rem; }
  .files-section h3 { font-size: 0.85rem; font-weight: 600; margin-bottom: 0.6rem; color: #0f172a; }
  .files-list { display: flex; flex-direction: column; gap: 0.4rem; }
 
  .file-row {
    display: flex; align-items: center; justify-content: space-between;
    background: #f8fafc; border: 1px solid #e2e8f0;
    border-radius: 8px; padding: 0.55rem 0.75rem; gap: 0.6rem;
  }
  .file-info { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .file-type-badge {
    background: rgba(56,138,221,0.18); color: #60a5fa;
    font-size: 0.68rem; font-weight: 600; padding: 0.15rem 0.45rem;
    border-radius: 5px; white-space: nowrap;
  }
  .file-name {
    font-size: 0.82rem; color: #0f172a;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .file-delete {
    background: none; border: none; cursor: pointer;
    font-size: 0.9rem; transition: 0.2s; flex-shrink: 0; padding: 0.2rem;
  }
  .file-delete:hover { transform: scale(1.15); }
  .no-files { font-size: 0.82rem; color: #64748b; padding: 0.5rem 0; }
 
  /* ══ DARK MODE: order rows ══ */
  body.dark-mode .order-row { background: #1a1f2e; border-color: rgba(255,255,255,0.06); }
  body.dark-mode .order-row:hover { background: #1e2536; border-color: rgba(96,165,250,0.3); }
  body.dark-mode .order-title { color: #e2e8f0; }
  body.dark-mode .order-meta { color: #64748b; }
  body.dark-mode .meta-dot { color: rgba(255,255,255,0.15); }
  body.dark-mode .order-id { color: #4a5568; }
  body.dark-mode .order-table-head { color: #4a5568; }
  body.dark-mode .om-title { color: #e2e8f0; }
  body.dark-mode .om-id { color: #4a5568; }
  body.dark-mode .om-tab { color: #64748b; }
  body.dark-mode .om-tab:hover:not(.om-tab--active) { color: #e2e8f0; }
  body.dark-mode .om-tab--active { background: #1a1f2e; color: #60a5fa; box-shadow: none; }
  body.dark-mode .om-tabs { background: #161b27; }
  body.dark-mode .om-info-card { background: #161b27; }
  body.dark-mode .om-info-card .om-info-value { color: #e2e8f0; }
  body.dark-mode .dropzone { background: #161b27; border-color: rgba(255,255,255,0.1); }
  body.dark-mode .dropzone:hover { border-color: #60a5fa; background: #1a1f2e; }
  body.dark-mode .dropzone .dz-filename { color: #60a5fa; }
