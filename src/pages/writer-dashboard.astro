  let walAvailableTotal = 0;

  async function loadBalance() {
    const hdr = { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` };
    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/writer_earnings?writer_id=eq.${writerId}&select=*,orders(order_number,topic)&order=created_at.asc`,
        { headers: hdr }
      );
      const earnings = await res.json();
      const list = Array.isArray(earnings) ? earnings : [];

      let running = 0;
      const withBalance = list.map((e: any) => { running += Number(e.amount || 0); return { ...e, runningBalance: running }; });
      walAvailableTotal = list.filter((e: any) => e.status === 'available').reduce((s: number, e: any) => s + Number(e.amount || 0), 0);

      const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      set('walBalanceAmt', `$${walAvailableTotal.toFixed(2)}`);
      set('balanceNavAmt', `$${walAvailableTotal.toFixed(2)}`);

      const txnList = document.getElementById('walTxnList');
      if (txnList) {
        const reversed = [...withBalance].reverse();
        txnList.innerHTML = reversed.length ? reversed.map((e: any) => {
          const date = e.created_at ? new Date(e.created_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
          return `<div class="wal-row wal-row-txn">
            <div>${date}</div>
            <div class="wal-amt-credit">+$${Number(e.amount || 0).toFixed(2)}</div>
            <div><span class="wal-status success">Success</span></div>
            <div>${esc(e.orders?.topic || e.orders?.order_number || 'Order')}</div>
            <div>$${e.runningBalance.toFixed(2)}</div>
          </div>`;
        }).join('') : '<div class="wal-note">No transactions yet.</div>';
      }

      await loadWithdrawals();
    } catch (err) { console.error(err); }
  }

  async function loadWithdrawals() {
    const hdr = { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` };
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/payout_requests?writer_id=eq.${writerId}&select=*&order=created_at.desc`, { headers: hdr });
      const requests = await res.json();
      const wdList = document.getElementById('walWdList');
      if (!wdList) return;
      if (!Array.isArray(requests) || !requests.length) { wdList.innerHTML = '<div class="wal-note">No withdrawal requests yet.</div>'; return; }
      wdList.innerHTML = requests.map((r: any) => {
        const date = r.created_at ? new Date(r.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
        return `<div class="wal-row wal-row-wd">
          <div>${date}</div>
          <div>$${Number(r.amount || 0).toFixed(2)}</div>
          <div><span class="wal-status ${r.status}">${r.status.charAt(0).toUpperCase() + r.status.slice(1)}</span></div>
        </div>`;
      }).join('');
    } catch (err) { console.error(err); }
