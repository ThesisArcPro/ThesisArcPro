  let bidChatConvId: string | null = null;
  let bidChatSubRT: any = null;
  let bidChatLastDate = '';
 
  async function submitBid(orderId: number, order: any) {
    const price = parseFloat((document.getElementById('bidPrice') as HTMLInputElement).value);
    const note = (document.getElementById('bidNote') as HTMLTextAreaElement).value.trim();
    const msg = document.getElementById('bidMsg')!;
    const btn = document.getElementById('submitBidBtn') as HTMLButtonElement;
 
    if (!price || price <= 0) { msg.textContent = 'Please enter a valid bid price.'; msg.className = 'upload-msg error'; msg.style.display = 'block'; return; }
    if (!note) { msg.textContent = 'Please write a proposal message.'; msg.className = 'upload-msg error'; msg.style.display = 'block'; return; }
 
    btn.disabled = true; btn.textContent = '⏳ Submitting…';
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/place_bid`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ p_order_id: orderId, p_writer_id: writerId, p_bid_price: price, p_estimated_delivery: null, p_note: note })
      });
      if (!res.ok) throw new Error((await res.json())?.message || 'Failed to place bid');
 
      // Emit bid to client via Socket.io
      socket.emit('bid:submit', {
        orderId: String(orderId),
        writerId: String(writerId),
        writerName: writerData?.full_name || 'Writer',
        amount: price,
        message: note
      });
 
      msg.textContent = '✅ Proposal submitted!'; msg.className = 'upload-msg success'; msg.style.display = 'block';
      btn.style.display = 'none';
      const priceInput = document.getElementById('bidPrice') as HTMLInputElement; if (priceInput) priceInput.disabled = true;
      const noteInput = document.getElementById('bidNote') as HTMLTextAreaElement; if (noteInput) noteInput.disabled = true;
      await loadAvailableOrders();
      await loadMyBids();
 
      // Reveal the chat panel now that a proposal has been placed
      await bidChatStart(orderId, order, note);
 
    } catch (err: any) {
      msg.textContent = err?.message || 'Could not submit proposal.'; msg.className = 'upload-msg error'; msg.style.display = 'block';
      btn.disabled = false; btn.textContent = '📨 Submit Proposal';
    }
  }
 
  async function bidChatStart(orderId: number, order: any, note: string) {
    const modalContent = document.getElementById('modalContent')!;
    if (!modalContent.querySelector('.modal-right')) {
      modalContent.insertAdjacentHTML('beforeend', `
        <div class="modal-right">
          <div style="padding:0.75rem 0.9rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:0.6rem;">
            <div style="width:28px;height:28px;border-radius:50%;background:#e2e8f0;display:flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:700;color:#0f172a;flex-shrink:0;">${esc((order.client_email?.[0] || 'C').toUpperCase())}</div>
            <div>
              <div style="font-size:0.78rem;font-weight:600;color:var(--text);">${esc(order.client_email?.split('@')[0] || 'Client')}</div>
              <div style="font-size:0.65rem;color:#4ade80;" id="bidChatSub">Waiting for client reply</div>
            </div>
          </div>
          <div id="bidChatMessages" style="flex:1;overflow-y:auto;padding:0.75rem;display:flex;flex-direction:column;gap:0.7rem;background:var(--main-bg);"></div>
          <div id="bidChatInputBar" style="padding:0.6rem;border-top:1px solid var(--border);display:flex;gap:0.4rem;background:var(--panel-bg);">
            <input type="text" id="bidChatInput" placeholder="Type a message…" style="flex:1;background:var(--main-bg);border:1px solid var(--border);border-radius:16px;padding:0.4rem 0.7rem;font-size:0.78rem;color:var(--text);outline:none;font-family:inherit;" />
            <button id="bidChatSend" style="background:#046fcd;color:#fff;border:none;border-radius:16px;padding:0.4rem 0.9rem;font-size:0.78rem;font-weight:600;cursor:pointer;">Send</button>
          </div>
        </div>
      `);
      document.getElementById('bidChatSend')?.addEventListener('click', bidChatSendMsg);
      document.getElementById('bidChatInput')?.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); bidChatSendMsg(); } });
    }
 
    const messagesBox = document.getElementById('bidChatMessages');
    if (!messagesBox) return;
    bidChatLastDate = '';
 
    try {
      let convId = await ocFindConversation(String(orderId));
      if (!convId) {
        const title = `Order ${order.order_number || orderId}`;
        const cRes = await fetch(`${SUPABASE_URL}/rest/v1/conversations`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=representation' },
          body: JSON.stringify({ type: 'order', order_id: Number(orderId), title })
        });
        convId = (await cRes.json())[0]?.id;
      }
      if (!convId) throw new Error('Could not create conversation');
      await ocEnsureSelf(convId);
 
      const existingRes = await fetch(
        `${SUPABASE_URL}/rest/v1/messages?conversation_id=eq.${convId}&select=id&limit=1`,
        { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
      );
      const existing = await existingRes.json();
      if (!existing.length) {
        await fetch(`${SUPABASE_URL}/rest/v1/messages`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
          body: JSON.stringify({ conversation_id: convId, sender_id: currentSession.user.id, sender_name: writerData?.full_name || 'Writer', sender_role: 'writer', content: note })
        });
      }
 
      bidChatConvId = convId;
 
      const mRes = await fetch(
        `${SUPABASE_URL}/rest/v1/messages?conversation_id=eq.${convId}&order=created_at.asc`,
        { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` } }
      );
      bidChatRender(await mRes.json());
 
      if (bidChatSubRT) { bidChatSubRT.unsubscribe(); bidChatSubRT = null; }
      bidChatSubRT = supabase.channel(`bidchat-${convId}`)
        .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages', filter: `conversation_id=eq.${convId}` },
          (payload: any) => bidChatAppend(payload.new)).subscribe();
 
    } catch (e) { console.error('bidChatStart error', e); }
  }
 
  function bidChatDateLabel(dateStr: string) {
    const d = new Date(dateStr);
    const today = new Date();
    if (d.toDateString() === today.toDateString()) return 'Today';
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }
  function bidChatRender(messages: any[]) {
    const c = document.getElementById('bidChatMessages');
    if (!c) return;
    if (!messages.length) { c.innerHTML = '<div class="woc-empty">No messages yet.</div>'; return; }
    bidChatLastDate = '';
    c.innerHTML = messages.map((m: any) => {
      const dateLabel = m.created_at ? bidChatDateLabel(m.created_at) : '';
      let divider = '';
      if (dateLabel && dateLabel !== bidChatLastDate) {
        bidChatLastDate = dateLabel;
        divider = `<div style="text-align:center;font-size:0.7rem;color:#94a3b8;margin:0.4rem 0;">${dateLabel}</div>`;
      }
      return divider + bidChatBubble(m);
    }).join('');
    c.scrollTop = c.scrollHeight;
  }
  function bidChatAppend(m: any) {
    const c = document.getElementById('bidChatMessages');
    if (!c) return;
    const ph = c.querySelector('.woc-empty'); if (ph) c.innerHTML = '';
    const dateLabel = m.created_at ? bidChatDateLabel(m.created_at) : '';
    let divider = '';
    if (dateLabel && dateLabel !== bidChatLastDate) {
      bidChatLastDate = dateLabel;
      divider = `<div style="text-align:center;font-size:0.7rem;color:#94a3b8;margin:0.4rem 0;">${dateLabel}</div>`;
    }
    c.insertAdjacentHTML('beforeend', divider + bidChatBubble(m));
    c.scrollTop = c.scrollHeight;
  }
  function bidChatBubble(m: any) {
    const mine = m.sender_id === currentSession.user.id;
    const time = m.created_at ? new Date(m.created_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '';
    const who = m.sender_role === 'support' ? 'Support' : (m.sender_name || 'Client');
    return `<div class="woc-row ${mine ? 'mine' : 'theirs'}">
      ${!mine ? `<div class="woc-name">${esc(who)}</div>` : ''}
      <div class="woc-bubble">${esc(m.content)}</div>
      <div class="woc-time">${time}${mine ? ' <span style="color:#60a5fa;">✓</span>' : ''}</div>
    </div>`;
  }
 
  async function bidChatSendMsg() {
    const input = document.getElementById('bidChatInput') as HTMLInputElement;
    if (!input || !bidChatConvId) return;
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    try {
      await fetch(`${SUPABASE_URL}/rest/v1/messages`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ conversation_id: bidChatConvId, sender_id: currentSession.user.id, sender_name: writerData?.full_name || 'Writer', sender_role: 'writer', content: text })
      });
      await fetch(`${SUPABASE_URL}/rest/v1/conversations?id=eq.${bidChatConvId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}`, Prefer: 'return=minimal' },
        body: JSON.stringify({ updated_at: new Date().toISOString() })
      });
    } catch (e) { console.error(e); }
  }
 
  // ═══ MY PROPOSALS (bids placed) ═══
  async function loadMyBids() {
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/my_bids_with_orders`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: `Bearer ${currentSession.access_token}` },
        body: JSON.stringify({ p_writer_id: writerId })
      });
      const rows = await res.json();
      // Reshape to match the old { ...bid, orders: {...} } structure used by renderProposals/showProposalDetail
      myBids = (Array.isArray(rows) ? rows : []).map((r: any) => ({
        id: r.id,
        order_id: r.order_id,
        bid_price: r.bid_price,
        status: r.status,
        created_at: r.created_at,
        note: r.note,
        orders: {
          order_number: r.order_number,
          topic: r.topic,
          deadline: r.deadline,
