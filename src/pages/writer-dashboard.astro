        <div class="pp-rating-based">Based on ${writerReviews.length} review${writerReviews.length === 1 ? '' : 's'}</div>
        ${breakdown.map(b => `
          <div class="pp-bar-row">
            <span class="pp-bar-label">${b.star} star</span>
            <div class="pp-bar-track"><div class="pp-bar-fill" style="width:${b.pct}%;"></div></div>
            <span class="pp-bar-pct">${b.pct}%</span>
          </div>`).join('')}
      </div>
      <div class="pp-section-title">Client Reviews</div>
